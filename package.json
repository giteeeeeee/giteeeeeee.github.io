{
  "name": "astro-theme-reay",
  "type": "module",
  "version": "0.0.1",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=9.6.5"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist",
    "build:astro": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "check:production": "node --env-file-if-exists=.env scripts/check-production-config.mjs",
    "lint": "eslint .",
    "test:routes": "node scripts/check-routes.mjs",
    "test:docs": "node scripts/check-docs.mjs",
    "test:performance": "node scripts/check-performance-budget.mjs",
    "test:config": "node --experimental-strip-types scripts/check-config-contracts.mjs",
    "test:security": "node --experimental-strip-types scripts/check-security-contracts.mjs",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:dist": "playwright test",
    "audit": "npm audit --audit-level=high",
    "verify": "npm run lint && npm run check && npm run test:docs && npm run test:config && npm run build && npm run test:routes && npm run test:performance && npm run test:security && npm run test:e2e:dist"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.3",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@chinese-fonts/hcqyt": "^2.0.0",
    "@fontsource-variable/noto-sans-sc": "^5.3.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "@material/material-color-utilities": "^0.3.0",
    "@pagefind/default-ui": "^1.5.2",
    "@shikijs/transformers": "4.3.1",
    "astro": "^7.1.3",
    "marked": "^16.4.2",
    "mdast-util-to-string": "^4.0.0",
    "pagefind": "^1.5.2",
    "reading-time": "^1.5.0",
    "rehype": "^13.0.2",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^10.0.1",
    "@iconify-json/carbon": "^1.2.24",
    "@iconify-json/simple-icons": "^1.2.91",
    "@iconify-json/uil": "^1.2.3",
    "@playwright/test": "^1.61.1",
    "@unocss/astro": "^66.7.5",
    "eslint": "^10.7.0",
    "eslint-plugin-astro": "^1.7.0",
    "globals": "^17.7.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "unocss": "^66.7.5"
  }
}
