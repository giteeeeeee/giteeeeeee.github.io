---
import { ClientRouter } from 'astro:transitions';
import type { BackgroundConfig } from '@app/config/theme.config';
import { getFeaturesConfig, getThemeConfig } from '@app/config/site.config';
import I18nRuntime from '@features/i18n/components/I18nRuntime.astro';
import Background from '@shared/components/Background.astro';
import ClientRuntime from '@shared/components/ClientRuntime.astro';
import Footer from '@shared/components/Footer.astro';
import Header from '@shared/components/Header.astro';
import HeadMeta from '@shared/components/HeadMeta.astro';
import PageTransition from '@shared/components/PageTransition.astro';

import '@fontsource-variable/nunito/wght.css';
import '@chinese-fonts/hcqyt/dist/ChillRoundFRegular/result.css';
import '@fontsource-variable/noto-sans-sc/wght.css';
import '@design/styles/cards.css';
import '@design/styles/immersive.css';
import '@design/styles/preset-identities.css';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  variant: 'default' | 'home';
  homeLayout?: 'flow' | 'snap';
  background?: Partial<BackgroundConfig>;
  showFooter?: boolean;
}

const {
  title,
  description,
  ogImage,
  variant,
  homeLayout,
  background,
  showFooter = false,
} = Astro.props;

const SeasonalEffects = getFeaturesConfig().integrations.seasonalEffects
  ? (await import('@features/effects/components/SeasonalEffects.astro')).default
  : null;

const themeConfig = getThemeConfig();
const themeCssSchemaVersion = 4;
const themeSignature = `${themeCssSchemaVersion}:${JSON.stringify(themeConfig)}`;
let themeHash = 2166136261;
for (let index = 0; index < themeSignature.length; index += 1) {
  themeHash ^= themeSignature.charCodeAt(index);
  themeHash = Math.imul(themeHash, 16777619);
}
const themeStylesheetHref = `/theme.css?v=${(themeHash >>> 0).toString(36)}`;
---

<html
  lang="zh-CN"
  data-theme-preset={themeConfig.preset}
  data-theme-default={themeConfig.mode}
>
  <head>
    <meta charset="utf-8" />

    <script is:inline>
      (() => {
        const storedTheme = localStorage.getItem('theme');
        const configuredTheme = document.documentElement.dataset.themeDefault;
        const requestedTheme = storedTheme === 'light' || storedTheme === 'dark' || storedTheme === 'system'
          ? storedTheme
          : configuredTheme === 'light' || configuredTheme === 'dark'
            ? configuredTheme
            : 'system';
        const resolvedTheme = requestedTheme === 'light' || requestedTheme === 'dark'
          ? requestedTheme
          : window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';

        document.documentElement.setAttribute('data-theme', resolvedTheme);
        document.documentElement.style.colorScheme = resolvedTheme;
      })();
    </script>

    <I18nRuntime />
    <HeadMeta {title} {description} {ogImage} />
    <link rel="stylesheet" href={themeStylesheetHref} />
    <slot name="head" />
    <ClientRouter fallback="swap" />
    <PageTransition />
    <ClientRuntime />

    <style is:inline>
      html {
        font-family: var(--reay-font-global);
        font-size: var(--text-base);
        scroll-behavior: smooth;
        overscroll-behavior-x: none;
        overscroll-behavior-y: none;
      }

      body {
        min-height: 100vh;
        margin: 0;
        display: flex;
        flex-direction: column;
        overflow-x: hidden;
        overscroll-behavior-x: none;
        overscroll-behavior-y: none;
        background: var(--md-sys-color-background);
        color: var(--md-sys-color-on-background);
        font-family: var(--reay-font-body);
        font-size: 1rem;
        line-height: var(--leading);
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }

      :where(h1, h2, h3, h4, h5, h6) {
        font-family: var(--reay-font-heading);
      }

      :where(time, [data-font-role="metadata"]) {
        font-family: var(--reay-font-metadata);
      }

      @supports (min-height: 100dvh) {
        body { min-height: 100dvh; }
      }

      body.layout-default main {
        flex: 1 0 auto;
        min-width: 0;
        overscroll-behavior-y: none;
      }

      body.layout-home {
        --home-body-overflow: hidden;
        display: grid;
        grid-template-rows: auto 1fr;
        overflow: var(--home-body-overflow);
      }

      body.layout-home main {
        position: relative;
        flex: 1;
        height: calc(100vh - 4rem);
        min-height: 0;
        margin-top: 0;
        overflow: hidden;
        overscroll-behavior-y: none;
      }

      body.layout-home[data-home-layout='flow'] {
        --home-body-overflow: auto;
        display: block;
      }

      body.layout-home[data-home-layout='flow'] main {
        height: auto;
        overflow: visible;
      }

      a {
        color: inherit;
        text-decoration: none;
        transition:
          color 0.2s cubic-bezier(0.4, 0, 0.2, 1),
          background-color 0.2s cubic-bezier(0.4, 0, 0.2, 1),
          border-color 0.2s cubic-bezier(0.4, 0, 0.2, 1),
          box-shadow 0.2s cubic-bezier(0.4, 0, 0.2, 1),
          transform 0.2s cubic-bezier(0.4, 0, 0.2, 1);
      }

      a:hover { color: var(--md-sys-color-primary); }

      html.i18n-syncing *,
      html.i18n-syncing *::before,
      html.i18n-syncing *::after {
        transition: none !important;
      }

      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      @supports (backdrop-filter: blur(20px)) {
        .glass-effect {
          backdrop-filter: blur(20px) saturate(180%);
          -webkit-backdrop-filter: blur(20px) saturate(180%);
        }
      }

      @keyframes float-up {
        from { transform: translateY(0); }
        to { transform: translateY(-2px); }
      }

      .icon-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 2.25rem;
        height: 2.25rem;
        border: 1px solid var(--reay-button-border);
        border-radius: var(--reay-icon-button-radius, 0.95rem);
        background: var(--reay-button-bg);
        color: var(--md-sys-color-on-surface);
        cursor: pointer;
        box-shadow: var(--reay-button-shadow);
        backdrop-filter: blur(16px) saturate(150%);
        -webkit-backdrop-filter: blur(16px) saturate(150%);
        transition:
          color 0.2s cubic-bezier(0.4, 0, 0.2, 1),
          background-color 0.2s cubic-bezier(0.4, 0, 0.2, 1),
          border-color 0.2s cubic-bezier(0.4, 0, 0.2, 1),
          box-shadow 0.2s cubic-bezier(0.4, 0, 0.2, 1),
          transform 0.2s cubic-bezier(0.4, 0, 0.2, 1);
      }

      .icon-btn:hover {
        border-color: rgba(var(--md-sys-color-primary-rgb), 0.48);
        background: var(--reay-button-bg-hover);
        color: var(--md-sys-color-on-primary-container);
        transform: translateY(-1px);
        box-shadow: var(--reay-button-shadow-hover);
      }

      .icon-btn:active {
        transform: translateY(0);
        box-shadow: 0 2px 4px rgba(var(--md-sys-color-shadow-rgb), 0.05);
      }

      .icon-btn i { font-size: 1.25rem; }
    </style>
  </head>

  <body
    class:list={[
      'antialiased',
      variant === 'default' ? 'layout-default' : 'layout-home min-h-dvh',
    ]}
    data-home-layout={variant === 'home' ? homeLayout : undefined}
  >
    <Background {...(background ?? {})} />
    {SeasonalEffects && <SeasonalEffects />}

    <Header>
      <slot name="header-extra" />
    </Header>

    <slot />
    {showFooter && <Footer />}
  </body>
</html>
