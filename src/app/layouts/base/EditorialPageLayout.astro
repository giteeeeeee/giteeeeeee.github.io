---
/** Shared document flow for non-home editorial pages. */
import DefaultLayout from './DefaultLayout.astro';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  pageClass?: string;
}

const { title, description, ogImage, pageClass } = Astro.props;
---

<DefaultLayout {title} {description} {ogImage}>
  <slot name="head" slot="head" />
  <div class:list={['editorial-page', pageClass]} data-editorial-page>
    <slot />
  </div>
</DefaultLayout>

<style>
  .editorial-page {
    width: 100%;
    padding: clamp(1.8rem, 4vw, 2.8rem) 0 clamp(3rem, 7vw, 5rem);
  }

  @media (max-width: 640px) {
    .editorial-page {
      padding-top: 1.35rem;
      padding-bottom: 3rem;
    }
  }
</style>
