---
/** Standard document layout for content pages. */
import DocumentShell from './DocumentShell.astro';
import Container from '@shared/components/Container.astro';

const {
  title = 'Astro Theme Reay',
  description = 'Technical notes and project practice',
  ogImage,
} = Astro.props as {
  title?: string;
  description?: string;
  ogImage?: string;
};
---

<DocumentShell {title} {description} {ogImage} variant="default" showFooter>
  <slot name="head" slot="head" />
  <slot name="header-extra" slot="header-extra" />

  <main data-pagefind-body>
    <Container>
      <div data-page-transition data-page-transition-scope="default">
        <slot />
      </div>
    </Container>
  </main>
</DocumentShell>
