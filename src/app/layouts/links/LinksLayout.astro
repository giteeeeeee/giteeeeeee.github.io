---
/**
 * LinksLayout.astro
 * Links page dedicated layout
 */
import EditorialPageLayout from '../base/EditorialPageLayout.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Friend Links',
  description = 'Selected resources, tools, and friendly sites',
} = Astro.props;
---

<EditorialPageLayout {title} {description} pageClass="links-layout">
  <slot />
</EditorialPageLayout>
