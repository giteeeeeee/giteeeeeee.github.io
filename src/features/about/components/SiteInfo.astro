---
import { useI18n } from '@features/i18n/lib/i18n';
import type { TranslationKey } from '@app/config/i18n.config';

interface Props {
  site: {
    name: string;
    description: string;
    builtWith: string;
    since: string;
    stats: { posts: number; words: number; tags: number; years: number };
    techStack: Array<{ name: string; description: string; url: string; icon: string }>;
  };
}

const { site } = Astro.props;
const { t } = useI18n();
const getCopyKey = (value: string) => (
  value.startsWith('site.') || value.startsWith('about.') ? value : undefined
);
const getCopy = (value: string) => getCopyKey(value) ? t(value as TranslationKey) : value;
---

<section class="site-info-section">
  <header>
    <p><i class="i-carbon:earth" aria-hidden="true"></i>{site.since}</p>
    <h2 data-i18n="about.site.title">{t('about.site.title')}</h2>
    <span data-i18n="about.site.description">{t('about.site.description')}</span>
  </header>

  <div class="site-content">
    <div class="site-summary">
      <div>
        <p class="site-kicker" data-i18n={getCopyKey(site.builtWith)}>{getCopy(site.builtWith)}</p>
        <h3>{site.name}</h3>
        <p class="site-description">{site.description}</p>
      </div>
      <dl>
        <div><dt data-i18n="about.site.stats.posts">{t('about.site.stats.posts')}</dt><dd>{site.stats.posts}</dd></div>
        <div><dt data-i18n="about.site.stats.words">{t('about.site.stats.words')}</dt><dd>{Math.round(site.stats.words / 1000)}k</dd></div>
        <div><dt data-i18n="about.site.stats.tags">{t('about.site.stats.tags')}</dt><dd>{site.stats.tags}</dd></div>
        <div><dt data-i18n="about.site.stats.years">{t('about.site.stats.years')}</dt><dd>{site.stats.years}</dd></div>
      </dl>
    </div>

    <div class="tech-list" aria-label={t('about.site.techStack')}>
      {site.techStack.map((tech) => (
        <a href={tech.url} target="_blank" rel="noopener noreferrer">
          <i class={tech.icon} aria-hidden="true"></i>
          <span>
            <strong>{tech.name}</strong>
            <small data-i18n={getCopyKey(tech.description)}>{getCopy(tech.description)}</small>
          </span>
          <i class="i-carbon:arrow-up-right arrow" aria-hidden="true"></i>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .site-info-section {
    display: grid;
    grid-template-columns: 11rem minmax(0, 1fr);
    gap: clamp(1.25rem, 4vw, 2.75rem);
    margin-bottom: 1rem;
  }

  header > p {
    display: flex;
    align-items: center;
    gap: 0.42rem;
    margin: 0 0 0.4rem;
    color: var(--md-sys-color-primary);
    font-size: 0.68rem;
    font-weight: 850;
  }

  header h2 { margin: 0; color: var(--md-sys-color-on-surface); font-size: 1.12rem; font-weight: 860; }
  header > span { display: block; margin-top: 0.38rem; color: var(--md-sys-color-on-surface-variant); font-size: 0.73rem; line-height: 1.55; }

  .site-content {
    min-width: 0;
  }

  .site-summary {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 1.5rem;
    padding: 1.25rem;
    background: linear-gradient(115deg, rgba(var(--md-sys-color-primary-rgb), 0.1), rgba(var(--md-sys-color-surface-container-rgb), 0.48));
    border-top: 1px solid rgba(var(--md-sys-color-outline-variant-rgb), 0.48);
    border-bottom: 1px solid rgba(var(--md-sys-color-outline-variant-rgb), 0.48);
  }

  .site-kicker {
    margin: 0 0 0.35rem;
    color: var(--md-sys-color-primary);
    font-size: 0.66rem;
    font-weight: 800;
    text-transform: uppercase;
  }

  .site-summary h3 {
    margin: 0;
    color: var(--md-sys-color-on-surface);
    font-size: 1.35rem;
    font-weight: 900;
  }

  .site-description {
    max-width: 38rem;
    margin: 0.42rem 0 0;
    color: var(--md-sys-color-on-surface-variant);
    font-size: 0.77rem;
    line-height: 1.6;
  }

  dl {
    display: grid;
    grid-template-columns: repeat(4, minmax(3.8rem, 1fr));
    align-items: center;
    margin: 0;
  }

  dl > div {
    padding: 0 0.8rem;
    border-left: 1px solid rgba(var(--md-sys-color-outline-variant-rgb), 0.42);
    text-align: center;
  }

  dt { color: var(--md-sys-color-on-surface-variant); font-size: 0.62rem; }
  dd { margin: 0.25rem 0 0; color: var(--md-sys-color-primary); font-size: 1rem; font-weight: 900; }

  .tech-list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-bottom: 1px solid rgba(var(--md-sys-color-outline-variant-rgb), 0.42);
  }

  .tech-list a {
    display: grid;
    grid-template-columns: 1.7rem minmax(0, 1fr) auto;
    gap: 0.55rem;
    align-items: center;
    min-height: 4rem;
    padding: 0.65rem;
    border-right: 1px solid rgba(var(--md-sys-color-outline-variant-rgb), 0.34);
  }

  .tech-list a:last-child { border-right: 0; }
  .tech-list a > i:first-child { color: var(--md-sys-color-primary); }
  .tech-list span { min-width: 0; }
  .tech-list strong, .tech-list small { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .tech-list strong { color: var(--md-sys-color-on-surface); font-size: 0.74rem; }
  .tech-list small { margin-top: 0.12rem; color: var(--md-sys-color-on-surface-variant); font-size: 0.62rem; }
  .arrow { color: var(--md-sys-color-primary); font-size: 0.72rem; }

  @media (max-width: 760px) {
    .site-summary { grid-template-columns: 1fr; }
    dl { width: 100%; }
    dl > div:first-child { border-left: 0; padding-left: 0; }
  }

  @media (max-width: 660px) {
    .site-info-section { grid-template-columns: 1fr; gap: 0.8rem; }
  }

  @media (max-width: 520px) {
    dl { grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: 0.65rem; }
    dl > div:nth-child(odd) { border-left: 0; padding-left: 0; }
    .tech-list { grid-template-columns: 1fr; }
    .tech-list a { border-right: 0; border-bottom: 1px solid rgba(var(--md-sys-color-outline-variant-rgb), 0.34); }
  }
</style>
