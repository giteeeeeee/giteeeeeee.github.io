---
/**
 * I18nRuntime
 * Tiny first-paint language bootstrap plus a cacheable client module.
 */
import { defaultLang } from '@app/config/i18n.config';
---

<script is:inline define:vars={{ defaultLang }}>
  (function() {
    const stored = (() => {
      try { return localStorage.getItem('language'); }
      catch { return null; }
    })();
    const lang = stored === 'zh' || stored === 'en' ? stored : defaultLang;
    document.documentElement.dataset.lang = lang;
    document.documentElement.lang = lang === 'zh' ? 'zh-CN' : 'en';
  })();
</script>

<script>
  import { initI18nRuntime } from '@features/i18n/client/i18n-runtime';
  initI18nRuntime();
</script>
