---
import { useI18n } from '@features/i18n/lib/i18n';
import type { SearchFallbackDocument } from '@features/search/lib/search-data';

interface Props {
  documents: SearchFallbackDocument[];
  suggestions: string[];
}

const { documents, suggestions } = Astro.props;
const { t } = useI18n();
const baseUrl = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const serializedDocuments = JSON.stringify(documents).replace(/</g, '\\u003c');
---

<section
  class="search-page"
  data-pagefind-ignore
  data-pagefind-search
  data-search-root
  data-search-base={baseUrl}
  data-search-development={String(import.meta.env.DEV)}
  data-search-state="idle"
>
  <div class="search-surface">
    <form class="search-form" role="search" data-search-form>
      <label class="sr-only" for="site-search-input" data-i18n="search.placeholder">
        {t('search.placeholder')}
      </label>
      <i class="i-carbon:search search-form-icon" aria-hidden="true"></i>
      <input
        id="site-search-input"
        type="search"
        name="q"
        autocomplete="off"
        enterkeyhint="search"
        spellcheck="false"
        placeholder={t('search.placeholder')}
        aria-describedby="search-runtime-status"
        data-search-input
        data-i18n="search.placeholder"
        data-i18n-attr="placeholder"
      />
      <button
        class="search-clear"
        type="button"
        aria-label={t('search.clear')}
        title={t('search.clear')}
        data-search-clear
        data-i18n="search.clear"
        data-i18n-attrs="aria-label,title"
        hidden
      >
        <i class="i-carbon:close" aria-hidden="true"></i>
      </button>
      <kbd aria-hidden="true">/</kbd>
    </form>

    <div class="search-runtime-meta">
      <p id="search-runtime-status" role="status" aria-live="polite" data-search-status>
        {t('search.idleTitle')}
      </p>
      <p class="search-local-note">
        <i class="i-carbon:locked" aria-hidden="true"></i>
        <span data-i18n="search.localNote">{t('search.localNote')}</span>
      </p>
    </div>
  </div>

  {suggestions.length > 0 && (
    <nav class="search-suggestions" aria-label={t('search.suggestions')}>
      <span data-i18n="search.suggestions">{t('search.suggestions')}</span>
      <div>
        {suggestions.map(suggestion => (
          <button type="button" data-search-suggestion={suggestion}>{suggestion}</button>
        ))}
      </div>
    </nav>
  )}

  <div class="search-state search-idle" data-search-idle>
    <div class="search-state-heading">
      <span class="search-state-icon"><i class="i-carbon:search-locate" aria-hidden="true"></i></span>
      <div>
        <h2 data-i18n="search.idleTitle">{t('search.idleTitle')}</h2>
        <p data-i18n="search.idleDescription">{t('search.idleDescription')}</p>
      </div>
    </div>
    <dl class="search-scope-list">
      <div>
        <dt><i class="i-carbon:document" aria-hidden="true"></i><span data-i18n="search.scope.blog">{t('search.scope.blog')}</span></dt>
        <dd data-i18n="search.scope.blogDescription">{t('search.scope.blogDescription')}</dd>
      </div>
      <div>
        <dt><i class="i-carbon:image" aria-hidden="true"></i><span data-i18n="search.scope.plog">{t('search.scope.plog')}</span></dt>
        <dd data-i18n="search.scope.plogDescription">{t('search.scope.plogDescription')}</dd>
      </div>
      <div>
        <dt><i class="i-carbon:ibm-cloud" aria-hidden="true"></i><span data-i18n="search.scope.site">{t('search.scope.site')}</span></dt>
        <dd data-i18n="search.scope.siteDescription">{t('search.scope.siteDescription')}</dd>
      </div>
    </dl>
  </div>

  <div class="search-state search-loading" data-search-loading hidden aria-hidden="true">
    <span></span><span></span><span></span>
  </div>

  <div class="search-state search-empty" data-search-empty hidden>
    <span class="search-state-icon"><i class="i-carbon:search" aria-hidden="true"></i></span>
    <div>
      <h2 data-i18n="search.noResultsTitle">{t('search.noResultsTitle')}</h2>
      <p data-i18n="search.noResultsDescription">{t('search.noResultsDescription')}</p>
    </div>
  </div>

  <div class="search-state search-error" data-search-error hidden>
    <span class="search-state-icon"><i class="i-carbon:warning-alt" aria-hidden="true"></i></span>
    <div>
      <h2 data-i18n="search.errorTitle">{t('search.errorTitle')}</h2>
      <p data-i18n="search.errorDescription">{t('search.errorDescription')}</p>
      <button type="button" class="search-retry" data-search-retry>
        <i class="i-carbon:renew" aria-hidden="true"></i>
        <span data-i18n="search.retry">{t('search.retry')}</span>
      </button>
    </div>
  </div>

  <ol class="search-results" data-search-results hidden aria-label={t('search.title')}></ol>

  <button type="button" class="search-load-more" data-search-load-more hidden>
    <span data-i18n="search.loadMore">{t('search.loadMore')}</span>
    <i class="i-carbon:arrow-down" aria-hidden="true"></i>
  </button>

  <script type="application/json" data-search-fallback is:inline set:html={serializedDocuments}></script>
</section>

<style>
  .search-page {
    width: min(100%, 62rem);
    margin: 0 auto;
  }

  .search-surface {
    padding: clamp(0.85rem, 2.5vw, 1.25rem);
    border: 1px solid var(--reay-surface-border);
    border-radius: var(--reay-radius-lg);
    background: var(--reay-surface-bg);
    box-shadow: var(--reay-surface-shadow);
  }

  .search-form {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto auto;
    align-items: center;
    min-height: 3.6rem;
    padding: 0 0.8rem 0 1rem;
    border: 1px solid rgba(var(--md-sys-color-outline-rgb), 0.38);
    border-radius: var(--reay-radius-md);
    background: rgba(var(--md-sys-color-surface-container-lowest-rgb), 0.7);
    transition: border-color var(--reay-duration-fast) var(--reay-ease-standard), box-shadow var(--reay-duration-fast) var(--reay-ease-standard);
  }

  .search-form:focus-within {
    border-color: var(--md-sys-color-primary);
    box-shadow: var(--reay-focus-ring);
  }

  .search-form-icon {
    color: var(--md-sys-color-primary);
    font-size: 1.2rem;
  }

  .search-form input {
    width: 100%;
    min-width: 0;
    padding: 0.9rem 0.75rem;
    border: 0;
    outline: 0;
    background: transparent;
    color: var(--md-sys-color-on-surface);
    font-family: var(--reay-font-body);
    font-size: clamp(0.92rem, 2vw, 1.05rem);
    font-weight: 650;
  }

  .search-form input::placeholder {
    color: var(--md-sys-color-on-surface-variant);
    opacity: 0.82;
  }

  .search-form input::-webkit-search-cancel-button {
    display: none;
  }

  .search-clear {
    display: grid;
    width: 2rem;
    height: 2rem;
    place-items: center;
    padding: 0;
    border: 0;
    border-radius: var(--reay-radius-pill);
    background: transparent;
    color: var(--md-sys-color-on-surface-variant);
    cursor: pointer;
  }

  .search-clear:hover {
    background: rgba(var(--md-sys-color-primary-rgb), 0.1);
    color: var(--md-sys-color-primary);
  }

  .search-form kbd {
    min-width: 1.7rem;
    padding: 0.14rem 0.38rem;
    border: 1px solid rgba(var(--md-sys-color-outline-variant-rgb), 0.65);
    border-radius: var(--reay-radius-xs);
    background: var(--md-sys-color-surface-container);
    color: var(--md-sys-color-on-surface-variant);
    font-family: var(--reay-font-mono);
    font-size: 0.7rem;
    text-align: center;
  }

  .search-runtime-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    padding: 0.75rem 0.15rem 0;
    color: var(--md-sys-color-on-surface-variant);
    font-family: var(--reay-font-metadata);
    font-size: 0.7rem;
  }

  .search-runtime-meta p {
    margin: 0;
  }

  .search-local-note {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    text-align: right;
  }

  .search-suggestions {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
    margin: 0.9rem 0 0;
    padding: 0 0.15rem;
  }

  .search-suggestions > span {
    flex: 0 0 auto;
    padding-top: 0.28rem;
    color: var(--md-sys-color-on-surface-variant);
    font-family: var(--reay-font-metadata);
    font-size: 0.68rem;
    font-weight: 760;
  }

  .search-suggestions > div {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .search-suggestions button {
    padding: 0.25rem 0.62rem;
    border: 1px solid rgba(var(--md-sys-color-outline-variant-rgb), 0.58);
    border-radius: var(--reay-radius-pill);
    background: transparent;
    color: var(--md-sys-color-on-surface-variant);
    font-family: var(--reay-font-metadata);
    font-size: 0.68rem;
    cursor: pointer;
  }

  .search-suggestions button:hover {
    border-color: rgba(var(--md-sys-color-primary-rgb), 0.5);
    background: rgba(var(--md-sys-color-primary-rgb), 0.08);
    color: var(--md-sys-color-primary);
  }

  .search-state {
    margin-top: clamp(1.6rem, 4vw, 2.6rem);
    padding: clamp(1.2rem, 3vw, 1.8rem) 0;
    border-top: 1px solid rgba(var(--md-sys-color-outline-variant-rgb), 0.48);
  }

  .search-state-heading,
  .search-empty,
  .search-error {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
  }

  .search-state-icon {
    display: grid;
    flex: 0 0 auto;
    width: 2.35rem;
    height: 2.35rem;
    place-items: center;
    border-radius: var(--reay-radius-pill);
    background: var(--md-sys-color-primary-container);
    color: var(--md-sys-color-on-primary-container);
    font-size: 1rem;
  }

  .search-state h2 {
    margin: 0;
    color: var(--md-sys-color-on-surface);
    font-size: 1rem;
    font-weight: 820;
  }

  .search-state p {
    max-width: 42rem;
    margin: 0.35rem 0 0;
    color: var(--md-sys-color-on-surface-variant);
    font-size: 0.78rem;
    line-height: 1.65;
  }

  .search-scope-list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0;
    margin: 1.35rem 0 0;
    border-top: 1px solid rgba(var(--md-sys-color-outline-variant-rgb), 0.42);
  }

  .search-scope-list > div {
    min-width: 0;
    padding: 0.9rem 1rem 0 0;
  }

  .search-scope-list > div + div {
    padding-left: 1rem;
    border-left: 1px solid rgba(var(--md-sys-color-outline-variant-rgb), 0.42);
  }

  .search-scope-list dt {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--md-sys-color-on-surface);
    font-size: 0.76rem;
    font-weight: 800;
  }

  .search-scope-list dt i {
    color: var(--md-sys-color-primary);
  }

  .search-scope-list dd {
    margin: 0.25rem 0 0;
    color: var(--md-sys-color-on-surface-variant);
    font-size: 0.68rem;
    line-height: 1.55;
  }

  .search-loading {
    display: grid;
    gap: 0.7rem;
  }

  .search-loading span {
    height: 4.7rem;
    border-radius: var(--reay-radius-sm);
    background: linear-gradient(100deg, rgba(var(--md-sys-color-surface-container-rgb), 0.5), rgba(var(--md-sys-color-primary-rgb), 0.09), rgba(var(--md-sys-color-surface-container-rgb), 0.5));
    background-size: 220% 100%;
    animation: search-skeleton 1.4s ease-in-out infinite;
  }

  .search-retry,
  .search-load-more {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    min-height: 2.35rem;
    margin-top: 0.8rem;
    padding: 0.45rem 0.85rem;
    border: 1px solid var(--reay-button-border);
    border-radius: var(--reay-radius-pill);
    background: var(--reay-button-bg);
    color: var(--md-sys-color-primary);
    font-family: var(--reay-font-navigation);
    font-size: 0.72rem;
    font-weight: 760;
    cursor: pointer;
  }

  .search-results {
    margin: clamp(1.2rem, 3vw, 1.8rem) 0 0;
    padding: 0;
    border-top: 1px solid rgba(var(--md-sys-color-outline-variant-rgb), 0.5);
    list-style: none;
  }

  .search-results :global(.search-result) {
    border-bottom: 1px solid rgba(var(--md-sys-color-outline-variant-rgb), 0.5);
  }

  .search-results :global(.search-result a) {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.45rem 1rem;
    padding: clamp(1rem, 2.5vw, 1.35rem) 0.25rem;
    color: inherit;
    text-decoration: none;
  }

  .search-results :global(.search-result a:hover) {
    background: linear-gradient(90deg, rgba(var(--md-sys-color-primary-rgb), 0.07), transparent 74%);
  }

  .search-results :global(.search-result-title) {
    margin: 0;
    color: var(--md-sys-color-on-surface);
    font-size: clamp(0.92rem, 2vw, 1.05rem);
    font-weight: 820;
    line-height: 1.35;
  }

  .search-results :global(.search-result-meta) {
    display: inline-flex;
    align-items: center;
    align-self: start;
    gap: 0.35rem;
    color: var(--md-sys-color-primary);
    font-family: var(--reay-font-metadata);
    font-size: 0.64rem;
    font-weight: 780;
    white-space: nowrap;
  }

  .search-results :global(.search-result-excerpt) {
    grid-column: 1 / -1;
    max-width: 48rem;
    margin: 0;
    color: var(--md-sys-color-on-surface-variant);
    font-size: 0.76rem;
    line-height: 1.65;
  }

  .search-results :global(mark) {
    border-radius: 0.18rem;
    background: var(--md-sys-color-tertiary-container);
    color: var(--md-sys-color-on-tertiary-container);
  }

  .search-load-more {
    width: fit-content;
    margin: 1.2rem auto 0;
  }

  @keyframes search-skeleton {
    from { background-position: 100% 0; }
    to { background-position: -100% 0; }
  }

  @media (max-width: 640px) {
    .search-form {
      grid-template-columns: auto minmax(0, 1fr) auto;
      min-height: 3.25rem;
      padding-inline: 0.8rem;
    }

    .search-form kbd {
      display: none;
    }

    .search-runtime-meta,
    .search-suggestions {
      align-items: flex-start;
      flex-direction: column;
    }

    .search-local-note {
      text-align: left;
    }

    .search-scope-list {
      grid-template-columns: 1fr;
    }

    .search-scope-list > div {
      padding: 0.8rem 0;
    }

    .search-scope-list > div + div {
      padding-left: 0;
      border-top: 1px solid rgba(var(--md-sys-color-outline-variant-rgb), 0.38);
      border-left: 0;
    }

    .search-results :global(.search-result a) {
      grid-template-columns: minmax(0, 1fr);
    }

    .search-results :global(.search-result-meta),
    .search-results :global(.search-result-excerpt) {
      grid-column: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .search-loading span {
      animation: none;
    }
  }
</style>
