---
/** Unified retrieval archive with first-class series and bounded topic discovery. */
import type { CollectionEntry } from 'astro:content';
import type { PlogAlbum } from '@features/gallery/lib/plog';
import { calculateReadingTime, getPostUrl, getSeriesUrl } from '@features/blog/lib/blog';
import { useI18n } from '@features/i18n/lib/i18n';

interface Props {
  posts: CollectionEntry<'blog'>[];
  plogAlbums: PlogAlbum[];
}

type ArchiveKind = 'blog' | 'plog';
type FilterKind = 'all' | ArchiveKind;

interface ArchiveRow {
  id: string;
  kind: ArchiveKind;
  title: string;
  href: string;
  date: Date;
  tags: string[];
  topics: string[];
  category?: string;
  series?: string;
  collection?: string;
  location?: string;
  photoCount?: number;
}

interface TopicItem {
  key: string;
  label: string;
  count: number;
  kind: FilterKind;
}

const { posts, plogAlbums } = Astro.props;
const { currentLang, t } = useI18n();
const locale = currentLang === 'zh' ? 'zh-CN' : 'en-US';
const dateFormatter = new Intl.DateTimeFormat(locale, { month: '2-digit', day: '2-digit' });
const shortDateFormatter = new Intl.DateTimeFormat(locale, { year: 'numeric', month: 'short', day: 'numeric' });

const rows: ArchiveRow[] = [
  ...posts.map((post): ArchiveRow => ({
    id: `blog:${post.id}`,
    kind: 'blog',
    title: post.data.title,
    href: getPostUrl(post),
    date: post.data.publishDate,
    tags: post.data.tags,
    category: post.data.category,
    series: post.data.series,
    topics: post.data.tags.flatMap((tag) => [`all-tag:${tag}`, `blog-tag:${tag}`]),
  })),
  ...plogAlbums.map((album): ArchiveRow => ({
    id: `plog:${album.id}`,
    kind: 'plog',
    title: album.title,
    href: album.href,
    date: new Date(`${album.date}T00:00:00`),
    tags: album.tags,
    collection: album.collectionTitle,
    location: album.location,
    photoCount: album.photoCount,
    topics: [
      ...album.tags.flatMap((tag) => [`all-tag:${tag}`, `plog-tag:${tag}`]),
      `collection:${album.collectionId}`,
    ],
  })),
].sort((left, right) => right.date.getTime() - left.date.getTime());

const rowsByYear = new Map<number, ArchiveRow[]>();
rows.forEach((row) => {
  const year = row.date.getFullYear();
  const entries = rowsByYear.get(year) ?? [];
  entries.push(row);
  rowsByYear.set(year, entries);
});

function countTopics(source: Array<{ label: string; key: string; kind: FilterKind }>) {
  const topics = new Map<string, TopicItem>();
  source.forEach((item) => {
    const current = topics.get(item.key);
    topics.set(item.key, current ? { ...current, count: current.count + 1 } : { ...item, count: 1 });
  });
  return [...topics.values()].sort((left, right) => right.count - left.count || left.label.localeCompare(right.label));
}

const allTags = countTopics(rows.flatMap((row) => row.tags.map((tag) => ({
  label: tag,
  key: `all-tag:${tag}`,
  kind: 'all' as const,
}))));
const blogTags = countTopics(posts.flatMap((post) => post.data.tags.map((tag) => ({
  label: tag,
  key: `blog-tag:${tag}`,
  kind: 'blog' as const,
}))));
const plogTags = countTopics(plogAlbums.flatMap((album) => album.tags.map((tag) => ({
  label: tag,
  key: `plog-tag:${tag}`,
  kind: 'plog' as const,
}))));

const popularPanels = [
  { kind: 'all', items: allTags.slice(0, 12) },
  { kind: 'blog', items: blogTags.slice(0, 12) },
  { kind: 'plog', items: plogTags.slice(0, 12) },
] as const;

const seriesMap = new Map<string, CollectionEntry<'blog'>[]>();
posts.forEach((post) => {
  if (!post.data.series) return;
  const entries = seriesMap.get(post.data.series) ?? [];
  entries.push(post);
  seriesMap.set(post.data.series, entries);
});
const seriesItems = [...seriesMap.entries()].map(([series, entries]) => {
  const orderedPosts = [...entries].sort((left, right) => (
    (left.data.seriesOrder ?? Number.MAX_SAFE_INTEGER) - (right.data.seriesOrder ?? Number.MAX_SAFE_INTEGER)
  ));
  const latestPost = [...entries].sort((left, right) => right.data.publishDate.getTime() - left.data.publishDate.getTime())[0];
  return {
    series,
    href: getSeriesUrl(series),
    posts: orderedPosts,
    count: orderedPosts.length,
    readingMinutes: orderedPosts.reduce((sum, post) => sum + calculateReadingTime(post.body), 0),
    latestDate: latestPost?.data.publishDate,
  };
}).sort((left, right) => right.count - left.count || left.series.localeCompare(right.series));
const seriesPreviewItems = seriesItems.slice(0, 4);

const collectionMap = new Map<string, { title: string; count: number }>();
plogAlbums.forEach((album) => {
  const current = collectionMap.get(album.collectionId);
  collectionMap.set(album.collectionId, {
    title: album.collectionTitle,
    count: (current?.count ?? 0) + 1,
  });
});
const collectionItems = [...collectionMap.entries()].map(([id, item]) => ({
  ...item,
  key: `collection:${id}`,
}));

const topicDialogPanels = [
  {
    kind: 'all',
    groups: [
      { key: 'blog', title: 'Blog', items: blogTags },
      { key: 'plog', title: 'Plog', items: plogTags },
    ],
  },
  { kind: 'blog', groups: [{ key: 'blog', title: 'Blog', items: blogTags }] },
  { kind: 'plog', groups: [{ key: 'plog', title: 'Plog', items: plogTags }] },
] as const;
---

<section class="archive-explorer" data-archive-explorer>
  <nav
    class="archive-toolbar"
    aria-label={t('archives.filter.label')}
    data-archive-toolbar
    data-i18n="archives.filter.label"
    data-i18n-attr="aria-label"
  >
    <div class="archive-filter-tabs">
      <button type="button" class="is-active" data-archive-filter="all" aria-pressed="true" data-i18n="archives.filter.all">{t('archives.filter.all')}</button>
      <button type="button" data-archive-filter="blog" aria-pressed="false">Blog</button>
      <button type="button" data-archive-filter="plog" aria-pressed="false">Plog</button>
    </div>
    <div class="archive-filter-actions">
      <p class="archive-filter-status" aria-live="polite">
        <strong data-archive-result-count>{rows.length}</strong>
        <span data-i18n="archives.filter.results">{t('archives.filter.results')}</span>
        <span data-archive-active-topic hidden></span>
      </p>
      <button
        type="button"
        class="archive-topics-trigger"
        data-archive-topic-dialog-open
        aria-label={t('archives.filter.topics')}
        data-i18n="archives.filter.topics"
        data-i18n-attr="aria-label"
      >
        <i class="i-carbon:tag-group" aria-hidden="true"></i>
        <span data-i18n="archives.filter.topics">{t('archives.filter.topics')}</span>
      </button>
      <button
        type="button"
        class="archive-clear-filter"
        data-archive-clear
        hidden
        aria-label={t('archives.filter.clear')}
        data-i18n="archives.filter.clear"
        data-i18n-attr="aria-label"
      >
        <i class="i-carbon:close" aria-hidden="true"></i>
        <span data-i18n="archives.filter.clear">{t('archives.filter.clear')}</span>
      </button>
    </div>
  </nav>

  <div class="archive-workbench">
    <div class="archive-main-column">
      {seriesItems.length > 0 && (
        <section
          class="archive-series-shelf"
          data-archive-series-shelf
          data-archive-series-total={seriesItems.length}
          aria-labelledby="archive-series-title"
        >
          <header>
            <div>
              <p data-i18n="archives.series.eyebrow">{t('archives.series.eyebrow')}</p>
              <h2 id="archive-series-title" data-i18n="archives.series.title">{t('archives.series.title')}</h2>
              <span data-i18n="archives.series.shelfDescription">{t('archives.series.shelfDescription')}</span>
            </div>
            <a href="/archives/series/">
              <span data-i18n="archives.viewAllSeries">{t('archives.viewAllSeries')}</span>
              <i class="i-carbon:arrow-up-right" aria-hidden="true"></i>
            </a>
          </header>
          <div class="archive-series-grid">
            {seriesPreviewItems.map((item) => (
              <article data-archive-series-entry>
                <a href={item.href} data-astro-prefetch="hover">
                  <span class="archive-series-meta" data-font-role="metadata">
                    {item.count} <span data-i18n="archives.postsCount">{t('archives.postsCount')}</span>
                    <span aria-hidden="true">·</span>
                    {item.readingMinutes} <span data-i18n="blog.readTime">{t('blog.readTime')}</span>
                  </span>
                  <h3>{item.series}</h3>
                  <ol>
                    {item.posts.slice(0, 3).map((post, index) => (
                      <li><span>{String(post.data.seriesOrder ?? index + 1).padStart(2, '0')}</span>{post.data.title}</li>
                    ))}
                  </ol>
                  <span class="archive-series-updated" data-font-role="metadata">
                    {item.latestDate && (
                      <time datetime={item.latestDate.toISOString()}>{shortDateFormatter.format(item.latestDate)}</time>
                    )}
                    <i class="i-carbon:arrow-up-right" aria-hidden="true"></i>
                  </span>
                </a>
              </article>
            ))}
          </div>
        </section>
      )}

      <section class="archive-results" id="archive-results" data-archive-results tabindex="-1" aria-labelledby="archive-results-title">
        <header class="archive-results-heading">
          <div>
            <p data-i18n="archives.results.eyebrow">{t('archives.results.eyebrow')}</p>
            <h2 id="archive-results-title" data-i18n="archives.results.title">{t('archives.results.title')}</h2>
          </div>
        </header>

        <div class="archive-ledger" data-archive-ledger>
          {[...rowsByYear.entries()].map(([year, yearRows]) => (
            <section class="archive-year" id={`archive-year-${year}`} data-archive-year={year}>
              <header>
                <h3>{year}</h3>
                <span><strong data-year-count>{yearRows.length}</strong> <span data-i18n="archives.entries">{t('archives.entries')}</span></span>
              </header>

              <div class="archive-year-entries">
                {yearRows.map((row) => (
                  <article
                    class:list={['archive-entry', `is-${row.kind}`]}
                    data-archive-row
                    data-archive-kind={row.kind}
                    data-archive-topics={JSON.stringify(row.topics)}
                  >
                    <a href={row.href} data-astro-prefetch="hover">
                      <time datetime={row.date.toISOString()} data-font-role="metadata">{dateFormatter.format(row.date)}</time>
                      <span class="archive-entry-kind" data-font-role="metadata">
                        <i class={row.kind === 'blog' ? 'i-carbon:pen-fountain' : 'i-carbon:image'} aria-hidden="true"></i>
                        {row.kind === 'blog' ? 'Blog' : 'Plog'}
                      </span>
                      <span class="archive-entry-copy">
                        <h4>{row.title}</h4>
                        <span class="archive-entry-meta" data-font-role="metadata">
                          {row.kind === 'blog' ? (
                            <>
                              {row.category && <span>{row.category}</span>}
                              {row.series && <span><i class="i-carbon:list-boxes" aria-hidden="true"></i>{row.series}</span>}
                              {row.tags.slice(0, 3).map((tag) => <span>#{tag}</span>)}
                            </>
                          ) : (
                            <>
                              {row.collection && <span><i class="i-carbon:folder" aria-hidden="true"></i>{row.collection}</span>}
                              {row.location && <span><i class="i-carbon:location" aria-hidden="true"></i>{row.location}</span>}
                              <span><i class="i-carbon:image" aria-hidden="true"></i>{row.photoCount} <span data-i18n="gallery.stats.photos">{t('gallery.stats.photos')}</span></span>
                            </>
                          )}
                        </span>
                      </span>
                      <i class="archive-entry-arrow i-carbon:arrow-up-right" aria-hidden="true"></i>
                    </a>
                  </article>
                ))}
              </div>
            </section>
          ))}
          <p class="archive-no-results" data-archive-empty hidden data-i18n="archives.empty.filtered">{t('archives.empty.filtered')}</p>
        </div>
      </section>
    </div>

    <aside class="archive-rail">
      <nav class="archive-year-index" aria-label={t('archives.yearIndex')} data-i18n="archives.yearIndex" data-i18n-attr="aria-label">
        <span data-i18n="archives.yearIndex">{t('archives.yearIndex')}</span>
        <div>
          {[...rowsByYear.entries()].map(([year, yearRows]) => (
            <a href={`#archive-year-${year}`} data-archive-year-link={year}>
              <strong>{year}</strong><small>{yearRows.length}</small>
            </a>
          ))}
        </div>
      </nav>

      {collectionItems.length > 0 && (
        <section class="archive-collections" data-archive-collection-panel hidden>
          <header>
            <h2 data-i18n="archives.collections.title">{t('archives.collections.title')}</h2>
            <p data-i18n="archives.collections.description">{t('archives.collections.description')}</p>
          </header>
          <div>
            {collectionItems.map((item) => (
              <button
                type="button"
                data-archive-topic={item.key}
                data-archive-topic-kind="plog"
                data-archive-topic-label={item.title}
                aria-pressed="false"
              >
                <span>{item.title}</span><small>{item.count}</small>
              </button>
            ))}
          </div>
        </section>
      )}

      <div class="archive-topic-surface" data-archive-topic-surface>
        {popularPanels.map((panel) => (
          <section data-archive-topic-panel={panel.kind} hidden={panel.kind !== 'all'}>
            <header>
              <h2 data-i18n="archives.topics.popular">{t('archives.topics.popular')}</h2>
              <p data-i18n="archives.topics.popularDescription">{t('archives.topics.popularDescription')}</p>
            </header>
            <div class="archive-popular-topics">
              {panel.items.map((topic) => (
                <button
                  type="button"
                  data-archive-topic={topic.key}
                  data-archive-topic-kind={topic.kind}
                  data-archive-topic-label={topic.label}
                  aria-pressed="false"
                >
                  <span>#{topic.label}</span><small>{topic.count}</small>
                </button>
              ))}
            </div>
            <button type="button" class="archive-all-topics" data-archive-topic-dialog-open>
              <span data-i18n="archives.topics.viewAll">{t('archives.topics.viewAll')}</span>
              <i class="i-carbon:arrow-up-right" aria-hidden="true"></i>
            </button>
          </section>
        ))}
      </div>
    </aside>
  </div>

  <dialog class="archive-topic-dialog" data-archive-topic-dialog aria-labelledby="archive-topic-dialog-title">
    <div class="archive-topic-dialog-shell">
      <header>
        <div>
          <p data-i18n="archives.topics.dialogEyebrow">{t('archives.topics.dialogEyebrow')}</p>
          <h2 id="archive-topic-dialog-title" data-i18n="archives.topics.dialogTitle">{t('archives.topics.dialogTitle')}</h2>
          <span data-i18n="archives.topics.dialogDescription">{t('archives.topics.dialogDescription')}</span>
        </div>
        <button type="button" data-archive-topic-dialog-close aria-label={t('gallery.close')} data-i18n="gallery.close" data-i18n-attr="aria-label">
          <i class="i-carbon:close" aria-hidden="true"></i>
        </button>
      </header>

      <div class="archive-topic-controls">
        <label>
          <i class="i-carbon:search" aria-hidden="true"></i>
          <input
            type="search"
            placeholder={t('archives.topics.search')}
            data-archive-topic-search
            data-i18n="archives.topics.search"
            data-i18n-attr="placeholder"
          />
        </label>
        <div role="group" aria-label={t('archives.topics.sort')} data-i18n="archives.topics.sort" data-i18n-attr="aria-label">
          <button type="button" class="is-active" data-archive-topic-sort="popular" aria-pressed="true" data-i18n="archives.topics.sortPopular">{t('archives.topics.sortPopular')}</button>
          <button type="button" data-archive-topic-sort="alphabetical" aria-pressed="false" data-i18n="archives.topics.sortAlphabetical">{t('archives.topics.sortAlphabetical')}</button>
        </div>
      </div>

      <div class="archive-topic-dialog-content">
        {topicDialogPanels.map((panel) => (
          <section data-archive-topic-dialog-panel={panel.kind} hidden={panel.kind !== 'all'}>
            {panel.groups.map((group) => (
              <section class="archive-topic-group" data-archive-topic-group>
                <header><h3>{group.title}</h3><small>{group.items.length}</small></header>
                <div data-archive-topic-list>
                  {group.items.map((topic) => (
                    <button
                      type="button"
                      data-archive-topic={topic.key}
                      data-archive-topic-kind={topic.kind}
                      data-archive-topic-label={topic.label}
                      data-archive-topic-count={topic.count}
                      data-archive-topic-item
                      aria-pressed="false"
                    >
                      <span>#{topic.label}</span><small>{topic.count}</small>
                    </button>
                  ))}
                </div>
              </section>
            ))}
          </section>
        ))}
        <p class="archive-topic-empty" data-archive-topic-search-empty hidden data-i18n="archives.topics.empty">{t('archives.topics.empty')}</p>
      </div>
    </div>
  </dialog>
</section>

<style>
  .archive-explorer { min-width: 0; }

  .archive-toolbar {
    position: sticky;
    top: 4rem;
    z-index: 18;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 3.25rem;
    margin: -0.25rem 0 1.55rem;
    padding: 0.4rem 0.48rem;
    border: 1px solid rgba(var(--md-sys-color-outline-variant-rgb), 0.46);
    border-radius: 1rem;
    background: color-mix(in srgb, var(--md-sys-color-surface-container-low) 88%, transparent);
    box-shadow: 0 8px 24px -22px rgba(var(--md-sys-color-shadow-rgb), 0.7);
    backdrop-filter: blur(14px) saturate(125%);
  }
  .archive-filter-tabs,
  .archive-filter-actions { display: flex; align-items: center; }
  .archive-filter-tabs { gap: 0.18rem; }
  .archive-filter-tabs button {
    position: relative;
    padding: 0.48rem 0.76rem;
    border: 0;
    border-radius: 0.72rem;
    background: transparent;
    color: var(--md-sys-color-on-surface-variant);
    font-family: var(--reay-font-navigation);
    font-size: 0.74rem;
    font-weight: 700;
    cursor: pointer;
    transition: color 160ms ease, background-color 160ms ease;
  }
  .archive-filter-tabs button:hover { background: var(--md-sys-color-surface-container-high); color: var(--md-sys-color-on-surface); }
  .archive-filter-tabs button.is-active { background: var(--md-sys-color-primary-container); color: var(--md-sys-color-on-primary-container); }
  .archive-filter-actions { gap: 0.8rem; }
  .archive-filter-status {
    display: flex;
    align-items: baseline;
    gap: 0.28rem;
    margin: 0;
    color: var(--md-sys-color-on-surface-variant);
    font-family: var(--reay-font-metadata);
    font-size: 0.62rem;
  }
  .archive-filter-status strong { color: var(--md-sys-color-on-surface); font-size: 0.72rem; }
  [data-archive-active-topic] { color: var(--md-sys-color-primary); font-weight: 700; }
  .archive-topics-trigger,
  .archive-clear-filter {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.36rem 0;
    border: 0;
    background: transparent;
    color: var(--md-sys-color-primary);
    font-family: var(--reay-font-navigation);
    font-size: 0.66rem;
    font-weight: 700;
    cursor: pointer;
  }
  .archive-clear-filter { color: var(--md-sys-color-on-surface-variant); }

  .archive-workbench {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(15.5rem, 0.34fr);
    gap: clamp(2.2rem, 5vw, 4.4rem);
    align-items: start;
  }
  .archive-main-column,
  .archive-ledger { min-width: 0; }

  .archive-series-shelf {
    margin-bottom: clamp(2.2rem, 5vw, 3.4rem);
    padding: clamp(1rem, 2.5vw, 1.35rem);
    border-radius: 1rem;
    background: rgba(var(--md-sys-color-surface-container-rgb), 0.48);
  }
  .archive-series-shelf > header,
  .archive-results-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 0.72rem;
    border-bottom: 1px solid rgba(var(--md-sys-color-outline-variant-rgb), 0.42);
  }
  .archive-series-shelf > header p,
  .archive-results-heading p {
    margin: 0 0 0.22rem;
    color: var(--md-sys-color-primary);
    font-family: var(--reay-font-metadata);
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 0.075em;
    text-transform: uppercase;
  }
  .archive-series-shelf > header h2,
  .archive-results-heading h2 { margin: 0; color: var(--md-sys-color-on-surface); font-size: 1rem; }
  .archive-series-shelf > header span { display: block; margin-top: 0.25rem; color: var(--md-sys-color-on-surface-variant); font-size: 0.66rem; }
  .archive-series-shelf > header > a {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    color: var(--md-sys-color-primary);
    font-size: 0.66rem;
    font-weight: 700;
    white-space: nowrap;
  }
  .archive-series-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .archive-series-grid article:nth-child(odd) { border-right: 1px solid rgba(var(--md-sys-color-outline-variant-rgb), 0.38); }
  .archive-series-grid article > a { display: grid; min-height: 100%; padding: 1rem; color: inherit; }
  .archive-series-grid article:nth-child(odd) > a { padding-left: 0; }
  .archive-series-grid article:nth-child(even) > a { padding-right: 0; }
  .archive-series-grid article > a:hover h3 { color: var(--md-sys-color-primary); }
  .archive-series-meta { color: var(--md-sys-color-primary); font-size: 0.58rem; font-weight: 680; }
  .archive-series-grid h3 { margin: 0.32rem 0 0; color: var(--md-sys-color-on-surface); font-size: 0.9rem; font-weight: 720; }
  .archive-series-grid ol { display: grid; gap: 0.22rem; margin: 0.65rem 0 0; padding: 0; list-style: none; }
  .archive-series-grid li { overflow: hidden; color: var(--md-sys-color-on-surface-variant); font-size: 0.66rem; text-overflow: ellipsis; white-space: nowrap; }
  .archive-series-grid li span { margin-right: 0.4rem; color: var(--md-sys-color-primary); font-family: var(--reay-font-metadata); font-size: 0.55rem; }
  .archive-series-updated { display: flex; justify-content: space-between; align-items: center; margin-top: 0.8rem; color: var(--md-sys-color-on-surface-variant); font-size: 0.56rem; }
  .archive-series-updated i { color: var(--md-sys-color-primary); font-size: 0.78rem; }

