---
/** A month-aware writing chronicle used by the archive overview and timeline. */
import type { CollectionEntry } from 'astro:content';
import { calculateReadingTime, getPostUrl } from '@features/blog/lib/blog';
import { useI18n } from '@features/i18n/lib/i18n';

interface Props {
  posts: CollectionEntry<'blog'>[];
  compact?: boolean;
}

const { posts, compact = false } = Astro.props;
const { currentLang, t } = useI18n();
const locale = currentLang === 'zh' ? 'zh-CN' : 'en-US';
const monthFormatter = new Intl.DateTimeFormat(locale, { month: 'long' });
const dayFormatter = new Intl.DateTimeFormat(locale, { day: '2-digit' });

const sortedPosts = [...posts].sort(
  (left, right) => right.data.publishDate.getTime() - left.data.publishDate.getTime(),
);
const years = new Map<number, Map<number, CollectionEntry<'blog'>[]>>();

sortedPosts.forEach((post) => {
  const year = post.data.publishDate.getFullYear();
  const month = post.data.publishDate.getMonth();
  const months = years.get(year) ?? new Map<number, CollectionEntry<'blog'>[]>();
  const entries = months.get(month) ?? [];
  entries.push(post);
  months.set(month, entries);
  years.set(year, months);
});
---

<div class:list={['archive-chronicle', compact && 'is-compact']} data-archive-chronicle>
  {[...years.entries()].map(([year, months]) => (
    <section class="chronicle-year" aria-labelledby={`archive-year-${year}`}>
      <header class="chronicle-year-heading">
        <h2 id={`archive-year-${year}`}>{year}</h2>
        <span>{[...months.values()].flat().length} <span data-i18n="archives.postsCount">{t('archives.postsCount')}</span></span>
      </header>

      <div class="chronicle-months">
        {[...months.entries()].map(([month, entries]) => (
          <section class="chronicle-month">
            <header>
              <span
                data-i18n-date={new Date(year, month, 1).toISOString()}
                data-i18n-date-format="month"
              >{monthFormatter.format(new Date(year, month, 1))}</span>
              <small>{entries.length}</small>
            </header>
            <div class="chronicle-entries">
              {entries.map((post) => (
                <article>
                  <a href={getPostUrl(post)} data-astro-prefetch="hover">
                    <time
                      datetime={post.data.publishDate.toISOString()}
                      data-i18n-date={post.data.publishDate.toISOString()}
                      data-i18n-date-format="day"
                    >
                      {dayFormatter.format(post.data.publishDate)}
                    </time>
                    <span class="chronicle-copy">
                      <span class="chronicle-kicker">
                        {post.data.category || post.data.series || t('home.activity.kind.note')}
                      </span>
                      <h3>{post.data.title}</h3>
                      {post.data.description && <p>{post.data.description}</p>}
                    </span>
                    <span class="chronicle-meta">
                      {calculateReadingTime(post.body)} <span data-i18n="blog.readTime">{t('blog.readTime')}</span>
                      <i class="i-carbon:arrow-up-right" aria-hidden="true"></i>
                    </span>
                  </a>
                </article>
              ))}
            </div>
          </section>
        ))}
      </div>
    </section>
  ))}
</div>

<style>
  .archive-chronicle {
    display: grid;
    gap: 3rem;
  }

  .chronicle-year {
    display: grid;
    grid-template-columns: 5.2rem minmax(0, 1fr);
    gap: clamp(1rem, 3vw, 2.2rem);
  }

  .chronicle-year-heading {
    padding-top: 0.15rem;
  }

  .chronicle-year-heading h2 {
    margin: 0;
    color: var(--md-sys-color-primary);
    font-size: 1.08rem;
    font-weight: 760;
    line-height: 1;
  }

  .chronicle-year-heading span {
    display: block;
    margin-top: 0.35rem;
    color: var(--md-sys-color-on-surface-variant);
    font-size: 0.65rem;
  }

  .chronicle-months {
    min-width: 0;
    border-top: 1px solid rgba(var(--md-sys-color-outline-variant-rgb), 0.48);
  }

  .chronicle-month {
    display: grid;
    grid-template-columns: 5.4rem minmax(0, 1fr);
    border-bottom: 1px solid rgba(var(--md-sys-color-outline-variant-rgb), 0.42);
  }

  .chronicle-month > header {
    padding: 0.88rem 0.7rem 0.88rem 0;
    color: var(--md-sys-color-on-surface-variant);
  }

  .chronicle-month > header span,
  .chronicle-month > header small {
    display: block;
  }

  .chronicle-month > header span {
    color: var(--md-sys-color-on-surface);
    font-size: 0.73rem;
    font-weight: 700;
  }

  .chronicle-month > header small {
    margin-top: 0.22rem;
    font-family: var(--reay-font-metadata);
    font-size: 0.6rem;
  }

  .chronicle-entries {
    min-width: 0;
    border-left: 1px solid rgba(var(--md-sys-color-outline-variant-rgb), 0.36);
  }

  .chronicle-entries article + article {
    border-top: 1px solid rgba(var(--md-sys-color-outline-variant-rgb), 0.32);
  }

  .chronicle-entries a {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr) auto;
    gap: 0.8rem;
    align-items: start;
    padding: 0.82rem 0.55rem 0.82rem 0.9rem;
    color: inherit;
  }

  .chronicle-entries a:hover {
    background: linear-gradient(90deg, rgba(var(--md-sys-color-primary-rgb), 0.07), transparent 78%);
  }

  time {
    padding-top: 1.05rem;
    color: var(--md-sys-color-primary);
    font-family: var(--reay-font-metadata);
    font-size: 0.68rem;
    font-weight: 680;
  }

  .chronicle-copy {
    min-width: 0;
  }

  .chronicle-kicker {
    display: block;
    margin-bottom: 0.22rem;
    color: var(--md-sys-color-on-surface-variant);
    font-size: 0.61rem;
    font-weight: 680;
    letter-spacing: 0.045em;
    text-transform: uppercase;
  }

  h3 {
    margin: 0;
    color: var(--md-sys-color-on-surface);
    font-size: 0.91rem;
    font-weight: 720;
    line-height: 1.35;
  }

  p {
    display: -webkit-box;
    margin: 0.28rem 0 0;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    color: var(--md-sys-color-on-surface-variant);
    font-size: 0.7rem;
    line-height: 1.5;
  }

  .chronicle-meta {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    padding-top: 1rem;
    color: var(--md-sys-color-on-surface-variant);
    font-size: 0.64rem;
    white-space: nowrap;
  }

  .chronicle-meta i {
    color: var(--md-sys-color-primary);
    font-size: 0.8rem;
  }

  .is-compact {
    gap: 1.5rem;
  }

  .is-compact .chronicle-year {
    grid-template-columns: 4.2rem minmax(0, 1fr);
    gap: 0.8rem;
  }

  .is-compact .chronicle-month {
    grid-template-columns: 4.5rem minmax(0, 1fr);
  }

  .is-compact p {
    -webkit-line-clamp: 1;
  }

  @media (max-width: 700px) {
    .chronicle-year,
    .is-compact .chronicle-year {
      grid-template-columns: 1fr;
      gap: 0.65rem;
    }

    .chronicle-year-heading {
      display: flex;
      align-items: baseline;
      gap: 0.5rem;
    }

    .chronicle-year-heading span {
      margin-top: 0;
    }

    .chronicle-month,
    .is-compact .chronicle-month {
      grid-template-columns: 3.7rem minmax(0, 1fr);
    }

    .chronicle-entries a {
      grid-template-columns: 1.6rem minmax(0, 1fr);
      gap: 0.55rem;
      padding-right: 0;
    }

    .chronicle-meta {
      grid-column: 2;
      padding-top: 0;
    }
  }
</style>
