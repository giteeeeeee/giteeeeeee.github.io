---
import { useI18n } from '@features/i18n/lib/i18n';
import type { GitHubContributionCalendar } from '@features/projects/lib/github';

interface Props {
  calendar: GitHubContributionCalendar;
}

const { calendar } = Astro.props;
const { currentLang, t } = useI18n();
const locale = currentLang === 'zh' ? 'zh-CN' : 'en-US';
type TranslationKey = Parameters<typeof t>[0];

const sourceKeys: Record<GitHubContributionCalendar['source'], TranslationKey> = {
  graphql: 'home.heatmap.source.graphql',
  events: 'home.heatmap.source.events',
  repos: 'home.heatmap.source.repos',
  cache: 'home.heatmap.source.cache',
  empty: 'home.heatmap.source.empty',
};

const monthFormatter = new Intl.DateTimeFormat(locale, { month: 'short' });
const monthLabels = calendar.weeks.map((week) => {
  const marker = week.find((day) => new Date(`${day.date}T00:00:00`).getDate() === 1);
  return marker ? monthFormatter.format(new Date(`${marker.date}T00:00:00`)) : '';
});
---

<section class="home-heatmap" aria-labelledby="home-heatmap-title" data-home-heatmap>
  <header class="home-heatmap-header">
    <div>
      <span data-i18n="home.heatmap.eyebrow">{t('home.heatmap.eyebrow')}</span>
      <h2 id="home-heatmap-title" data-i18n="home.heatmap.title">{t('home.heatmap.title')}</h2>
      <p data-i18n="home.heatmap.subtitle">{t('home.heatmap.subtitle')}</p>
    </div>
    <a
      href={`https://github.com/${calendar.username}`}
      target="_blank"
      rel="noopener noreferrer"
    >
      <i class="i-carbon:logo-github" aria-hidden="true"></i>
      <span>@{calendar.username}</span>
      <i class="i-carbon:arrow-up-right" aria-hidden="true"></i>
    </a>
  </header>

  <div
    class="home-heatmap-scroll"
    role="region"
    aria-label={t('home.heatmap.gridLabel')}
    data-i18n="home.heatmap.gridLabel"
    data-i18n-attr="aria-label"
    style={`--home-heatmap-weeks: ${calendar.weeks.length}`}
  >
    <div class="home-heatmap-canvas">
      <div class="home-heatmap-months" aria-hidden="true">
        {monthLabels.map((label) => <span>{label}</span>)}
      </div>
      <div class="home-heatmap-grid" aria-hidden="true">
        {calendar.weeks.map((week) => (
          <div class="home-heatmap-week">
            {week.map((day) => (
              <span
                class={`home-heatmap-day home-heatmap-day--${day.level}`}
                title={`${day.date}: ${day.count}`}
              ></span>
            ))}
          </div>
        ))}
      </div>
    </div>
  </div>

  <div class="home-heatmap-summary">
    <dl>
      <div>
        <dd>{calendar.totalContributions}</dd>
        <dt data-i18n="home.heatmap.total">{t('home.heatmap.total')}</dt>
      </div>
      <div>
        <dd>{calendar.activeDays}</dd>
        <dt data-i18n="projects.activity.activeDays">{t('projects.activity.activeDays')}</dt>
      </div>
      <div>
        <dd>{calendar.longestStreak}</dd>
        <dt data-i18n="projects.activity.longestStreak">{t('projects.activity.longestStreak')}</dt>
      </div>
    </dl>

    <div class="home-heatmap-legend">
      <span class="home-heatmap-source" data-i18n={sourceKeys[calendar.source]}>
        {t(sourceKeys[calendar.source])}
      </span>
      <span data-i18n="projects.activity.less">{t('projects.activity.less')}</span>
      {[0, 1, 2, 3, 4].map((level) => (
        <span class={`home-heatmap-day home-heatmap-day--${level}`} aria-hidden="true"></span>
      ))}
      <span data-i18n="projects.activity.more">{t('projects.activity.more')}</span>
    </div>
  </div>
</section>
