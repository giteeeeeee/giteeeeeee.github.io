---
import {
  getFeaturesConfig,
  getGitHubConfig,
  getLocalizedUserContent,
  getSiteProfile,
  getUserContactLinks,
  getUserProfile,
  getUserSocialLinks,
} from '@app/config/site.config';
import type { TranslationKey } from '@app/config/i18n.config';
import {
  calculateReadingTime,
  getArchiveStats,
  getPostUrl,
  getSortedPosts,
} from '@features/blog/lib/blog';
import { getPlogAlbums } from '@features/gallery/lib/plog';
import { useI18n } from '@features/i18n/lib/i18n';
import {
  formatNumber,
  getGitHubContributionCalendar,
  type GitHubContributionCalendar,
} from '@features/projects/lib/github';
import { getConfiguredProjects, type ProjectCatalogItem } from '@features/projects/lib/projects';
import Footer from '@shared/components/Footer.astro';
import ContributionHeatmap from './ContributionHeatmap.astro';

const { currentLang, t } = useI18n();
const user = getUserProfile();
const userContent = getLocalizedUserContent(currentLang);
const site = getSiteProfile(currentLang);
const builtWithKey = site.builtWith.startsWith('site.') ? site.builtWith : undefined;
const builtWith = builtWithKey ? t(builtWithKey as TranslationKey) : site.builtWith;
const contactLinks = getUserContactLinks();
const socialLinks = getUserSocialLinks();
const features = getFeaturesConfig();
const github = getGitHubConfig();
const showcaseConfig = features.home.showcase;

const [posts, albums, archiveStats] = await Promise.all([
  getSortedPosts(),
  getPlogAlbums(),
  getArchiveStats(),
]);

let projects: ProjectCatalogItem[] = [];
let contributionCalendar: GitHubContributionCalendar | null = null;

if (features.integrations.githubProjects) {
  try {
    projects = await getConfiguredProjects();
    contributionCalendar = await getGitHubContributionCalendar(
      github.username,
      projects,
    );
  } catch (error) {
    console.error('[Home] Failed to load GitHub activity.', error);
  }
}

const showcasePosts = [...posts]
  .sort((left, right) => {
    const featuredDifference = Number(right.data.featured) - Number(left.data.featured);
    return featuredDifference || right.data.publishDate.valueOf() - left.data.publishDate.valueOf();
  })
  .slice(0, showcaseConfig.posts);

const showcaseProjects = [...projects]
  .sort((left, right) => {
    const featuredDifference = Number(right.featured) - Number(left.featured);
    return featuredDifference || Date.parse(right.updatedAt) - Date.parse(left.updatedAt);
  })
  .slice(0, showcaseConfig.projects);

const showcaseAlbums = [...albums]
  .sort((left, right) => {
    const featuredDifference = Number(right.featured) - Number(left.featured);
    return featuredDifference || Date.parse(right.updatedDate || right.date) - Date.parse(left.updatedDate || left.date);
  })
  .slice(0, showcaseConfig.plogAlbums);

const [leadPost, ...supportingPosts] = showcasePosts;
const totalPhotos = albums.reduce((total, album) => total + album.photoCount, 0);
const locale = currentLang === 'zh' ? 'zh-CN' : 'en-US';
const numberFormatter = new Intl.NumberFormat(locale, {
  notation: 'compact',
  maximumFractionDigits: 1,
});
const dateFormatter = new Intl.DateTimeFormat(locale, {
  month: 'short',
  day: 'numeric',
  year: 'numeric',
});

const profileRoleKey = userContent.role ? 'role' : 'tagline';
const profileRole = userContent.role || userContent.tagline;
const profileStatusKey = userContent.status ? 'status' : 'bio';
const profileStatus = userContent.status || userContent.bio;
const profileFocus = userContent.focus ?? [];
const websiteContact = contactLinks.find((link) => link.kind === 'website');
const emailContact = contactLinks.find((link) => link.kind === 'email');
---

<section
  class="home-editorial-shell"
  aria-labelledby="home-editorial-title"
  data-home-stream
  data-home-editorial
>
  <h2 id="home-editorial-title" class="home-visually-hidden" data-i18n="home.activity.title">
    {t('home.activity.title')}
  </h2>

  <section class="home-profile-section" aria-labelledby="home-profile-title" data-home-now>
    <div class="home-profile-copy">
      <span class="home-section-index" data-i18n="home.profile.eyebrow">
        {t('home.profile.eyebrow')}
      </span>
      <h2 id="home-profile-title" data-user-content={profileRoleKey}>{profileRole}</h2>
      <p class="home-profile-bio" data-user-content="bio">{userContent.bio}</p>

      {profileFocus.length > 0 && (
        <div
          class="home-profile-focus"
          aria-label={t('home.profile.focus')}
          data-i18n="home.profile.focus"
          data-i18n-attr="aria-label"
        >
          <span data-i18n="home.profile.focus">{t('home.profile.focus')}</span>
          <ul>
            {profileFocus.map((focus, index) => (
              <li data-user-content={`focus.${index}`}>{focus}</li>
            ))}
          </ul>
        </div>
      )}

      <div class="home-profile-links">
        {socialLinks.map((social) => (
          <a href={social.href} target="_blank" rel="noopener noreferrer">
            <i class={social.icon} aria-hidden="true"></i>
            <span>{social.label}</span>
          </a>
        ))}
        <a href="/about/" data-astro-prefetch="hover">
          <span data-i18n="home.about.more">{t('home.about.more')}</span>
          <i class="i-carbon:arrow-right" aria-hidden="true"></i>
        </a>
      </div>
    </div>

    <aside
      class="home-profile-status"
      aria-label={t('home.profile.status')}
      data-i18n="home.profile.status"
      data-i18n-attr="aria-label"
    >
      <div class="home-profile-status-heading">
        <span aria-hidden="true"></span>
        <span data-i18n="home.profile.status">{t('home.profile.status')}</span>
      </div>
      <p data-user-content={profileStatusKey}>{profileStatus}</p>

      {(user.location || websiteContact || emailContact) && (
        <dl class="home-profile-facts">
          {user.location && (
            <div>
              <dt data-i18n="home.profile.location">{t('home.profile.location')}</dt>
              <dd><i class="i-carbon:location" aria-hidden="true"></i>{user.location}</dd>
            </div>
          )}
          {websiteContact && (
            <div>
              <dt data-i18n="home.profile.website">{t('home.profile.website')}</dt>
              <dd>
                <a href={websiteContact.href} target="_blank" rel="noopener noreferrer" data-contact-kind="website">
                  <i class={websiteContact.icon} aria-hidden="true"></i>{websiteContact.value}
                </a>
              </dd>
            </div>
          )}
          {emailContact && (
            <div>
              <dt data-i18n="home.profile.email">{t('home.profile.email')}</dt>
              <dd>
                <a href={emailContact.href} data-contact-kind="email">
                  <i class={emailContact.icon} aria-hidden="true"></i>{emailContact.value}
                </a>
              </dd>
            </div>
          )}
        </dl>
      )}
    </aside>
  </section>

  <section class="home-showcase" aria-labelledby="home-showcase-title" data-home-showcase>
    <header class="home-showcase-header">
      <span class="home-section-index" data-i18n="home.showcase.eyebrow">
        {t('home.showcase.eyebrow')}
      </span>
      <h2 id="home-showcase-title" data-i18n="home.showcase.title">
        {t('home.showcase.title')}
      </h2>
      <p data-i18n="home.showcase.subtitle">{t('home.showcase.subtitle')}</p>
    </header>

    <div class="home-showcase-layout">
      <div class="home-showcase-writing">
        <div class="home-showcase-group-heading">
          <span>
            <i class="i-carbon:document" aria-hidden="true"></i>
            <span data-i18n="home.showcase.blog">{t('home.showcase.blog')}</span>
          </span>
          <a href="/blog/" data-astro-prefetch="hover">
            <span data-i18n="home.showcase.allBlog">{t('home.showcase.allBlog')}</span>
            <i class="i-carbon:arrow-up-right" aria-hidden="true"></i>
          </a>
        </div>

        {leadPost ? (
          <article class="home-writing-lead" data-home-showcase-post>
            <a href={getPostUrl(leadPost)} data-astro-prefetch="hover">
              <div class="home-writing-meta">
                <time
                  datetime={leadPost.data.publishDate.toISOString()}
                  data-i18n-date={leadPost.data.publishDate.toISOString()}
                  data-i18n-date-format="short"
                >
                  {dateFormatter.format(leadPost.data.publishDate)}
                </time>
                <span>{calculateReadingTime(leadPost.body)} <span data-i18n="posts.readingTime">{t('posts.readingTime')}</span></span>
              </div>
              <h3>{leadPost.data.title}</h3>
              {leadPost.data.description && <p>{leadPost.data.description}</p>}
              <div class="home-writing-tags">
                {leadPost.data.tags.slice(0, 3).map((tag) => <span>#{tag}</span>)}
                <i class="i-carbon:arrow-up-right" aria-hidden="true"></i>
              </div>
            </a>
          </article>
        ) : (
          <p class="home-showcase-empty" data-i18n="home.activity.empty">{t('home.activity.empty')}</p>
        )}

        {supportingPosts.length > 0 && (
          <div class="home-writing-list">
            {supportingPosts.map((post, index) => (
              <article data-home-showcase-post>
                <a href={getPostUrl(post)} data-astro-prefetch="hover">
                  <span class="home-writing-number">{String(index + 2).padStart(2, '0')}</span>
                  <span class="home-writing-list-copy">
                    <h3>{post.data.title}</h3>
                    {post.data.description && <p>{post.data.description}</p>}
                  </span>
                  <time
                    datetime={post.data.publishDate.toISOString()}
                    data-i18n-date={post.data.publishDate.toISOString()}
                    data-i18n-date-format="short"
                  >
                    {dateFormatter.format(post.data.publishDate)}
                  </time>
                </a>
              </article>
            ))}
          </div>
        )}
      </div>

      <div class="home-showcase-side">
        {showcaseProjects.length > 0 && (
          <section class="home-project-shelf" aria-labelledby="home-project-shelf-title">
            <div class="home-showcase-group-heading">
              <span id="home-project-shelf-title">
                <i class="i-carbon:terminal" aria-hidden="true"></i>
                <span data-i18n="home.showcase.projects">{t('home.showcase.projects')}</span>
              </span>
              <a href="/projects/" data-astro-prefetch="hover">
                <span data-i18n="home.showcase.allProjects">{t('home.showcase.allProjects')}</span>
                <i class="i-carbon:arrow-up-right" aria-hidden="true"></i>
              </a>
            </div>

            <div class="home-project-list">
              {showcaseProjects.map((project) => (
                <article data-home-showcase-project>
                  <a href={`/projects/${project.owner}/${project.name}/`} data-astro-prefetch="hover">
                    <div class="home-project-title-row">
                      <h3>{project.name}</h3>
                      <i class="i-carbon:arrow-up-right" aria-hidden="true"></i>
                    </div>
                    {(project.customDescription || project.description) && (
                      <p>{project.customDescription || project.description}</p>
                    )}
                    <div class="home-project-meta">
                      {project.language && <span>{project.language}</span>}
                      <span><i class="i-carbon:star" aria-hidden="true"></i>{formatNumber(project.stars)}</span>
                      <time
                        datetime={project.updatedAt}
                        data-i18n-date={project.updatedAt}
                        data-i18n-date-format="short"
                      >
                        {dateFormatter.format(new Date(project.updatedAt))}
                      </time>
                    </div>
                  </a>
                </article>
              ))}
            </div>
          </section>
        )}

        {showcaseAlbums.length > 0 && (
          <section class="home-plog-shelf" aria-labelledby="home-plog-shelf-title">
            <div class="home-showcase-group-heading">
              <span id="home-plog-shelf-title">
                <i class="i-carbon:camera" aria-hidden="true"></i>
                <span data-i18n="home.showcase.plog">{t('home.showcase.plog')}</span>
              </span>
              <a href="/gallery/" data-astro-prefetch="hover">
                <span data-i18n="home.showcase.allPlog">{t('home.showcase.allPlog')}</span>
                <i class="i-carbon:arrow-up-right" aria-hidden="true"></i>
              </a>
            </div>

            <div class="home-plog-grid">
              {showcaseAlbums.map((album) => (
                <article data-home-showcase-plog style={`--home-plog-fallback: ${album.gradient};`}>
                  <a href={album.href} data-astro-prefetch="hover">
                    <span class="home-plog-media">
                      {album.cover ? (
                        <img
                          src={album.cover}
                          alt={album.coverAlt ?? album.title}
                          loading="lazy"
                          decoding="async"
                          sizes="(max-width: 680px) 82vw, 260px"
                        />
                      ) : (
                        <span class="home-plog-fallback" aria-hidden="true"></span>
                      )}
                    </span>
                    <span class="home-plog-overlay" aria-hidden="true"></span>
                    <span class="home-plog-copy">
                      <span class="home-plog-meta">
                        <span>{album.photoCount} <span data-i18n="home.activity.photos">{t('home.activity.photos')}</span></span>
                        {album.location && <span>{album.location}</span>}
                      </span>
                      <strong>{album.title}</strong>
                      <span>{album.description}</span>
                    </span>
                  </a>
                </article>
              ))}
            </div>
          </section>
        )}
      </div>
    </div>
  </section>

  <section class="home-site-pulse" aria-labelledby="home-site-title" data-home-site>
    <header class="home-site-header">
      <div>
        <span class="home-section-index" data-i18n="home.site.eyebrow">
          {t('home.site.eyebrow')}
        </span>
        <h2 id="home-site-title">{site.name}</h2>
        <p data-user-content="description">{userContent.description}</p>
      </div>
      <div class="home-site-note">
        <span>
          <i class="i-carbon:calendar" aria-hidden="true"></i>
          <span data-i18n="home.site.since">{t('home.site.since')}</span>
          {site.since}
        </span>
        <span data-i18n={builtWithKey}>{builtWith}</span>
      </div>
    </header>

    <dl class="home-site-stats">
      <div>
        <dt data-i18n="site.stats.articles">{t('site.stats.articles')}</dt>
        <dd>{archiveStats.totalPosts}</dd>
      </div>
      <div>
        <dt data-i18n="site.stats.words">{t('site.stats.words')}</dt>
        <dd>{numberFormatter.format(archiveStats.totalWords)}</dd>
      </div>
      <div>
        <dt data-i18n="home.site.photos">{t('home.site.photos')}</dt>
        <dd>{totalPhotos}</dd>
      </div>
      <div>
        <dt data-i18n="home.site.projects">{t('home.site.projects')}</dt>
        <dd>{projects.length}</dd>
      </div>
    </dl>

    {contributionCalendar && <ContributionHeatmap calendar={contributionCalendar} />}
  </section>

  <div class="home-seamless-footer">
    <Footer variant="seamless" />
  </div>
</section>
