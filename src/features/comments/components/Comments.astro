---
/**
 * Lazy comment system wrapper.
 * Supports static-site friendly providers used by common personal blog themes.
 */
import {
  getCommentsConfig,
  getFeaturesConfig,
  type UserContactLink,
} from '@app/config/site.config';
import { useI18n } from '@features/i18n/lib/i18n';
import type { CommentProvider } from '@app/config/comments.config';

interface Props {
  pageKey: string;
  pageTitle: string;
  description?: string;
  mode?: 'article' | 'guestbook';
  enabled?: boolean;
  fallbackLinks?: UserContactLink[];
}

const { t } = useI18n();
const config = getCommentsConfig();
const {
  pageKey,
  pageTitle,
  description,
  mode = 'article',
  enabled = true,
  fallbackLinks = [],
} = Astro.props;

const provider = config.provider as CommentProvider;
const providerLabels: Record<CommentProvider, string> = {
  giscus: 'Giscus',
  utterances: 'Utterances',
  waline: 'Waline',
  twikoo: 'Twikoo',
  artalk: 'Artalk',
  disqus: 'Disqus',
};

function hasProviderConfig() {
  if (provider === 'giscus') {
    return Boolean(config.giscus.repo && config.giscus.repoId && config.giscus.categoryId);
  }
  if (provider === 'utterances') return Boolean(config.utterances.repo);
  if (provider === 'waline') return Boolean(config.waline.serverURL);
  if (provider === 'twikoo') return Boolean(config.twikoo.envId);
  if (provider === 'artalk') return Boolean(config.artalk.server && config.artalk.site);
  if (provider === 'disqus') return Boolean(config.disqus.shortname);
  return false;
}

const modeEnabled = mode === 'guestbook' ? config.guestbook.enabled : config.article.enabled;
const isEnabled = Boolean(
  getFeaturesConfig().integrations.comments && config.enabled && modeEnabled && enabled,
);
const isConfigured = isEnabled && hasProviderConfig();
const isGuestbook = mode === 'guestbook';
const sectionTitle = isGuestbook ? t('guestbook.commentsTitle') : t('comments.title');
const sectionDescription = description ?? (isGuestbook ? t('guestbook.commentsDesc') : t('comments.description'));
const sectionEyebrow = isGuestbook ? t('guestbook.commentsEyebrow') : providerLabels[provider];
const sectionEyebrowKey = isGuestbook ? 'guestbook.commentsEyebrow' : undefined;
const loadLabel = isGuestbook ? t('guestbook.load') : t('comments.load');
const loadLabelKey = isGuestbook ? 'guestbook.load' : 'comments.load';
const loadHint = config.autoLoad ? t('comments.lazyHint') : t('comments.manualHint');
const loadHintKey = config.autoLoad ? 'comments.lazyHint' : 'comments.manualHint';
const threadKey = pageKey.replace(/^\/+|\/+$/g, '') || 'home';
const hostId = `comment-host-${threadKey.replace(/[^a-zA-Z0-9_-]/g, '-')}`;
const unavailableTitle = isGuestbook ? t('guestbook.unavailableTitle') : t('comments.unavailableTitle');
const unavailableDescription = isGuestbook ? t('guestbook.unavailableDesc') : t('comments.unavailableDesc');
const unavailableTitleKey = isGuestbook ? 'guestbook.unavailableTitle' : 'comments.unavailableTitle';
const unavailableDescriptionKey = isGuestbook ? 'guestbook.unavailableDesc' : 'comments.unavailableDesc';

const clientConfig = {
  provider,
  providerLabel: providerLabels[provider],
  pageKey,
  pageTitle,
  autoLoad: config.autoLoad,
  lazy: config.lazy,
  ui: {
    load: { key: loadLabelKey, fallback: loadLabel },
    retry: { key: 'comments.retry', fallback: t('comments.retry') },
    loading: { key: 'comments.loading', fallback: t('comments.loading') },
    error: { key: 'comments.error', fallback: t('comments.error') },
  },
  giscus: config.giscus,
  utterances: config.utterances,
  waline: config.waline,
  twikoo: config.twikoo,
  artalk: config.artalk,
  disqus: config.disqus,
};
const clientConfigJson = JSON.stringify(clientConfig).replace(/</g, '\\u003c');
---

<section
  class:list={['comment-section', mode === 'guestbook' && 'comment-section--guestbook']}
  data-comment-section
  data-ready={String(isConfigured)}
  data-comment-mode={mode}
>
  <div class="comment-section__header">
    <div class="comment-section__copy">
      <p class="comment-section__eyebrow">
        <i class="i-carbon:chat" aria-hidden="true"></i>
        <span data-i18n={sectionEyebrowKey}>{sectionEyebrow}</span>
      </p>
      <h2 data-i18n={isGuestbook ? 'guestbook.commentsTitle' : 'comments.title'}>{sectionTitle}</h2>
      <p data-i18n={isGuestbook ? 'guestbook.commentsDesc' : 'comments.description'}>{sectionDescription}</p>
    </div>
  </div>

  {isConfigured ? (
    <>
      <div class="comment-action-row">
        <button class="comment-load-button" type="button" data-comment-load aria-controls={hostId}>
          <i class="i-carbon:chat-launch"></i>
          <span data-comment-load-label data-i18n={loadLabelKey}>{loadLabel}</span>
        </button>
        <span class="comment-lazy-hint">
          <i class="i-carbon:connect" aria-hidden="true"></i>
          <span data-i18n="comments.poweredBy">{t('comments.poweredBy')}</span>
          <strong>{providerLabels[provider]}</strong>
          <span aria-hidden="true">·</span>
          <span data-i18n={loadHintKey}>{loadHint}</span>
        </span>
      </div>
      <div class="comment-host-shell">
        <p class="comment-feedback" data-comment-feedback aria-live="polite"></p>
        <div id={hostId} class="comment-host" data-comment-host tabindex="-1"></div>
      </div>
      <script is:inline type="application/json" data-comment-config set:html={clientConfigJson}></script>
    </>
  ) : (
    <div class="comment-placeholder" data-comment-unavailable>
      <span class="comment-placeholder__icon" aria-hidden="true"><i class="i-carbon:time"></i></span>
      <div class="comment-placeholder__copy">
        <strong data-i18n={unavailableTitleKey}>{unavailableTitle}</strong>
        <p data-i18n={unavailableDescriptionKey}>{unavailableDescription}</p>
        {isGuestbook && fallbackLinks.length > 0 && (
          <nav
            class="comment-fallback-links"
            aria-label={t('guestbook.otherWays')}
            data-i18n="guestbook.otherWays"
            data-i18n-attr="aria-label"
          >
            <span data-i18n="guestbook.otherWays">{t('guestbook.otherWays')}</span>
            {fallbackLinks.map((link) => (
              <a
                href={link.href}
                data-contact-kind={link.kind}
                target={link.external ? '_blank' : undefined}
                rel={link.external ? 'noopener noreferrer' : undefined}
              >
                <i class={link.icon} aria-hidden="true"></i>
                {link.label}
              </a>
            ))}
          </nav>
        )}
      </div>
    </div>
  )}
</section>

{isConfigured && (
  <script>
    import { initCommentsRuntime } from '@features/comments/client/comments-runtime';

    initCommentsRuntime();
  </script>
)}

<style>
  @import "../styles/comments.css";
</style>
