---
/**
 * Header Music Dock
 * Compact header button with an expandable player panel.
 */
import { getMusicConfig } from '@app/config/site.config';
import { useI18n } from '@features/i18n/lib/i18n';

const { t } = useI18n();
const musicConfig = getMusicConfig();
const playlistById = new Map(musicConfig.playlists.map(playlist => [playlist.id, playlist]));
const defaultTrack =
  musicConfig.tracks.find(track => track.id === musicConfig.player.defaultTrackId) ??
  musicConfig.tracks[0];

const defaultTrackId = defaultTrack?.id ?? '';
const getCoverStyle = (cover?: string) =>
  `--dock-cover: ${cover ? `url(${JSON.stringify(cover)})` : 'var(--reay-music-cover-gradient)'};`;
const labels = {
  play: t('music.play'),
  pause: t('music.pause'),
  previous: t('music.previous'),
  next: t('music.next'),
  volume: t('music.volume'),
  all: t('music.filter.all'),
  dock: t('music.dock.label'),
  expand: t('music.dock.expand'),
  collapse: t('music.dock.collapse'),
  nowPlaying: t('music.dock.nowPlaying'),
};
const clientConfigJson = JSON.stringify({
  tracks: musicConfig.tracks.map(track => ({
    ...track,
    playlistTitle: playlistById.get(track.playlistId)?.title ?? track.playlistId,
  })),
  defaultTrackId,
  autoAdvance: musicConfig.player.autoAdvance,
  labels,
}).replace(/</g, '\\u003c');
---

{defaultTrack && (
  <aside
    class="music-dock"
    data-music-dock
    aria-label={labels.dock}
    style={getCoverStyle(defaultTrack.cover)}
  >
    <button
      class="header-tool-button dock-trigger"
      type="button"
      data-dock-action="toggle"
      aria-label={labels.expand}
      aria-expanded="false"
      title={labels.dock}
    >
      <span class="dock-trigger-art" aria-hidden="true"></span>
      <i class="i-carbon:music" aria-hidden="true"></i>
    </button>

    <div class="dock-panel" data-dock-panel hidden>
      <div class="dock-panel-head">
        <span class="dock-now">
          <i class="i-carbon:music"></i>
          <span data-i18n="music.dock.nowPlaying">{labels.nowPlaying}</span>
        </span>
        <button class="dock-icon-btn" type="button" data-dock-action="toggle" aria-label={labels.collapse}>
          <i class="i-carbon:chevron-down"></i>
        </button>
      </div>

      <div class="dock-current">
        <span class="dock-cover-large" aria-hidden="true"></span>
        <span class="dock-current-copy">
          <strong data-dock-title>{defaultTrack.title}</strong>
          <span data-dock-artist>{defaultTrack.artist} · {defaultTrack.album}</span>
          <small data-dock-playlist>{playlistById.get(defaultTrack.playlistId)?.title ?? defaultTrack.playlistId}</small>
        </span>
      </div>

      <div class="dock-progress">
        <span data-dock-current-time>00:00</span>
        <input data-dock-seek type="range" min="0" max={defaultTrack.durationSeconds} value="0" step="1" aria-label={t('music.seek')} />
        <span data-dock-duration>{defaultTrack.duration}</span>
      </div>

      <div class="dock-controls">
        <button class="dock-icon-btn" type="button" data-dock-action="prev" aria-label={labels.previous}>
          <i class="i-carbon:skip-back-filled"></i>
        </button>
        <button class="dock-primary-btn" type="button" data-dock-action="play" aria-label={labels.play}>
          <i class="i-carbon:play-filled" data-dock-play-icon></i>
        </button>
        <button class="dock-icon-btn" type="button" data-dock-action="next" aria-label={labels.next}>
          <i class="i-carbon:skip-forward-filled"></i>
        </button>
        <label class="dock-volume" aria-label={labels.volume}>
          <i class="i-carbon:volume-up"></i>
          <input data-dock-volume type="range" min="0" max="1" value="0.62" step="0.01" />
        </label>
      </div>

      <div class="dock-playlists" role="tablist" aria-label={t('music.playlists')}>
        <button class="dock-chip is-active" type="button" data-dock-playlist-filter="all">
          <span data-i18n="music.filter.all">{labels.all}</span>
        </button>
        {musicConfig.playlists.map(playlist => (
          <button class="dock-chip" type="button" data-dock-playlist-filter={playlist.id}>
            <i class={playlist.icon}></i>
            <span>{playlist.title}</span>
          </button>
        ))}
      </div>

      <div class="dock-track-list" aria-label={t('music.tracks')}>
        {musicConfig.tracks.map(track => (
          <button
            class:list={['dock-track', track.id === defaultTrackId && 'is-active']}
            type="button"
            data-dock-track-id={track.id}
            data-dock-playlist-id={track.playlistId}
            style={getCoverStyle(track.cover)}
          >
            <span class="dock-track-cover" aria-hidden="true"></span>
            <span class="dock-track-copy">
              <strong>{track.title}</strong>
              <small>{track.artist}</small>
            </span>
            <span>{track.duration}</span>
          </button>
        ))}
      </div>
    </div>

    <audio data-dock-audio preload="none"></audio>
    <script is:inline type="application/json" data-music-dock-config set:html={clientConfigJson}></script>
  </aside>
)}

<style>
  .music-dock {
    --dock-accent: var(--reay-music-accent);
    --dock-on-accent: var(--reay-music-on-accent);
    --dock-accent-container: var(--reay-music-accent-container);
    --dock-on-accent-container: var(--reay-music-on-accent-container);
    --dock-cover: var(--reay-music-cover-gradient);

    position: relative;
    z-index: 90;
    display: inline-grid;
    place-items: center;
    width: 2.35rem;
    height: 2.35rem;
    flex: 0 0 auto;
    color: var(--md-sys-color-on-surface);
    transition:
      width 0.28s var(--reay-ease-smooth, ease),
      height 0.28s var(--reay-ease-smooth, ease);
  }

  .music-dock * {
    box-sizing: border-box;
  }

  .dock-trigger {
    position: relative;
    z-index: 90;
    display: inline-grid;
    place-items: center;
    width: 100%;
    height: 100%;
    overflow: hidden;
    border: 1px solid var(--reay-button-border);
    border-radius: var(--reay-icon-button-radius, 0.95rem);
    background: var(--reay-button-bg);
    color: var(--md-sys-color-on-surface);
    box-shadow:
      var(--reay-button-shadow),
      0 0 0 1px color-mix(in srgb, var(--dock-accent) 8%, transparent);
    cursor: pointer;
    transition:
      color 0.22s ease,
      border-color 0.22s ease,
      background 0.22s ease,
      transform 0.22s ease,
      box-shadow 0.22s ease;
    backdrop-filter: blur(10px) saturate(135%);
    -webkit-backdrop-filter: blur(10px) saturate(135%);
  }

  .dock-trigger:hover,
  .music-dock.is-expanded .dock-trigger {
    color: var(--md-sys-color-primary);
    border-color: color-mix(in srgb, var(--dock-accent) 48%, transparent);
    background: var(--reay-button-bg-hover);
    transform: translateY(-1px);
    box-shadow:
      var(--reay-button-shadow-hover),
      0 0 0 1px color-mix(in srgb, var(--dock-accent) 12%, transparent);
  }

  .dock-trigger-art {
    position: absolute;
    inset: 0.36rem;
    border-radius: inherit;
    background: var(--dock-cover);
    background-position: center;
    background-size: cover;
    opacity: 0.2;
  }

  .dock-trigger i {
    position: relative;
    z-index: 1;
    font-size: 1.08rem;
  }

  .dock-panel {
    position: absolute;
    top: calc(100% + 0.75rem);
    right: 0;
    z-index: 95;
    display: grid;
    width: min(calc(100vw - 2rem), 23.5rem);
    max-height: min(calc(100dvh - 5.5rem), 34rem);
    gap: 0.85rem;
    overflow: hidden;
    padding: 0.85rem;
    border: 1px solid rgba(var(--md-sys-color-outline-variant-rgb), 0.32);
    border-radius: var(--reay-radius-lg, 1.35rem);
    background:
      linear-gradient(135deg, color-mix(in srgb, var(--dock-accent) 16%, transparent), transparent 56%),
      var(--reay-music-surface);
    box-shadow:
      0 34px 86px -48px rgba(var(--md-sys-color-shadow-rgb), 0.66),
      0 14px 38px -32px color-mix(in srgb, var(--dock-accent) 58%, transparent),
      inset 0 1px 0 rgba(var(--md-sys-color-surface-bright-rgb), 0.2);
    backdrop-filter: blur(14px) saturate(145%);
    -webkit-backdrop-filter: blur(14px) saturate(145%);
    transform-origin: top right;
    animation: dock-panel-in 0.24s var(--reay-ease-out, ease) both;
  }

  .dock-panel[hidden] {
    display: none;
  }

  .dock-icon-btn,
  .dock-primary-btn,
  .dock-chip,
  .dock-track {
    color: inherit;
    font: inherit;
    cursor: pointer;
  }

  .dock-cover-large,
  .dock-track-cover {
    background: var(--dock-cover);
    background-position: center;
    background-size: cover;
  }

  .dock-current-copy strong,
  .dock-track-copy strong {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .dock-icon-btn,
  .dock-primary-btn {
    display: inline-grid;
    place-items: center;
    width: 2.35rem;
    height: 2.35rem;
    border: 1px solid var(--reay-button-border);
    border-radius: var(--reay-icon-button-radius, 0.95rem);
    background: var(--reay-button-bg);
    color: var(--md-sys-color-on-surface);
    box-shadow: var(--reay-button-shadow);
    transition: transform 0.2s ease, background 0.2s ease, color 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .dock-primary-btn {
    width: 2.8rem;
    height: 2.8rem;
    border-color: color-mix(in srgb, var(--dock-accent) 50%, transparent);
    background: var(--dock-accent);
    color: var(--dock-on-accent);
    box-shadow: 0 16px 32px -22px rgba(var(--md-sys-color-primary-rgb), 0.95);
  }

  .dock-icon-btn:hover,
  .dock-primary-btn:hover,
  .dock-chip:hover,
  .dock-track:hover {
    transform: translateY(-1px);
    box-shadow: var(--reay-button-shadow-hover);
  }

  .dock-icon-btn:hover,
  .dock-track:hover {
    border-color: color-mix(in srgb, var(--dock-accent) 42%, transparent);
    background:
      linear-gradient(135deg, color-mix(in srgb, var(--dock-accent) 16%, transparent), transparent 64%),
      rgba(var(--md-sys-color-surface-container-rgb), 0.56);
  }

  .dock-primary-btn:hover {
    transform: translateY(-2px) scale(1.02);
  }

  .dock-panel-head,
  .dock-controls {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.65rem;
  }

  .dock-now {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--md-sys-color-primary);
    font-size: 0.82rem;
    font-weight: 850;
  }

  .dock-current {
    display: grid;
    grid-template-columns: 4.2rem minmax(0, 1fr);
    align-items: center;
    gap: 0.8rem;
  }

  .dock-cover-large {
    width: 4.2rem;
    aspect-ratio: 1;
    border-radius: var(--reay-radius-md, 1rem);
    box-shadow: inset 0 1px 0 rgba(var(--md-sys-color-surface-bright-rgb), 0.2);
  }

  .dock-current-copy,
  .dock-track-copy {
    display: grid;
    gap: 0.18rem;
    min-width: 0;
  }

  .dock-current-copy strong {
    color: var(--md-sys-color-on-surface);
    font-size: 1rem;
    line-height: 1.2;
  }

  .dock-current-copy span,
  .dock-current-copy small {
    overflow: hidden;
    color: var(--md-sys-color-on-surface-variant);
    font-size: 0.78rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .dock-progress {
    display: grid;
    grid-template-columns: 2.85rem minmax(0, 1fr) 2.85rem;
    align-items: center;
    gap: 0.55rem;
    color: var(--md-sys-color-on-surface-variant);
    font-size: 0.74rem;
    font-variant-numeric: tabular-nums;
  }

  .dock-progress input,
  .dock-volume input {
    width: 100%;
    accent-color: var(--dock-accent);
  }

  .dock-volume {
    display: grid;
    grid-template-columns: auto minmax(58px, 1fr);
    align-items: center;
    gap: 0.38rem;
    min-width: 7.1rem;
    min-height: 2.35rem;
    padding: 0 0.58rem;
    border: 1px solid var(--reay-button-border);
    border-radius: var(--reay-radius-md, 1rem);
    background: var(--reay-button-bg);
    color: var(--md-sys-color-on-surface-variant);
  }

  .dock-playlists {
    display: flex;
    gap: 0.45rem;
    overflow-x: auto;
    padding-bottom: 0.1rem;
    scrollbar-width: thin;
  }

  .dock-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    flex: 0 0 auto;
    min-height: 2.15rem;
    padding: 0.46rem 0.68rem;
    border: 1px solid var(--reay-chip-border);
    border-radius: var(--reay-radius-pill, 999px);
    background: var(--reay-chip-bg);
    color: var(--md-sys-color-on-surface-variant);
    font-size: 0.78rem;
    font-weight: 800;
  }

  .dock-chip.is-active {
    border-color: color-mix(in srgb, var(--dock-accent) 55%, transparent);
    background: color-mix(in srgb, var(--dock-accent-container) 58%, var(--md-sys-color-surface-container));
    color: var(--dock-on-accent-container);
    box-shadow:
      inset 0 1px 0 rgba(var(--md-sys-color-surface-bright-rgb), 0.24),
      0 12px 28px -24px color-mix(in srgb, var(--dock-accent) 80%, transparent);
  }

  .dock-track-list {
    display: grid;
    gap: 0.42rem;
    max-height: clamp(8rem, calc(100dvh - 22rem), 13rem);
    overflow-y: auto;
    padding-right: 0.1rem;
    scrollbar-width: thin;
  }

  .dock-track {
    display: grid;
    grid-template-columns: 2.55rem minmax(0, 1fr) 2.8rem;
    align-items: center;
    gap: 0.55rem;
    width: 100%;
    min-height: 3.25rem;
    padding: 0.38rem 0.48rem;
    border: 1px solid rgba(var(--md-sys-color-outline-variant-rgb), 0.26);
    border-radius: var(--reay-radius-md, 1rem);
    background: rgba(var(--md-sys-color-surface-rgb), 0.38);
    text-align: left;
    transition: transform 0.2s ease, border-color 0.2s ease, background 0.2s ease;
  }

  .dock-track[hidden] {
    display: none;
  }

  .dock-track.is-active {
    border-color: color-mix(in srgb, var(--dock-accent) 52%, transparent);
    background: color-mix(in srgb, var(--dock-accent-container) 44%, var(--md-sys-color-surface-container));
    box-shadow:
      inset 0 1px 0 rgba(var(--md-sys-color-surface-bright-rgb), 0.18),
      0 14px 32px -28px color-mix(in srgb, var(--dock-accent) 70%, transparent);
  }

  .dock-track-cover {
    width: 2.45rem;
    aspect-ratio: 1;
    border-radius: var(--reay-radius-sm, 0.78rem);
  }

  .dock-track-copy strong {
    color: var(--md-sys-color-on-surface);
    font-size: 0.84rem;
  }

  .dock-track-copy small,
  .dock-track > span:last-child {
    color: var(--md-sys-color-on-surface-variant);
    font-size: 0.72rem;
  }

  .music-dock.is-playing .dock-trigger-art,
  .music-dock.is-playing .dock-cover-large {
    animation: dock-cover-pulse 4.5s ease-in-out infinite;
  }

  @keyframes dock-cover-pulse {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.03); }
  }

  @keyframes dock-panel-in {
    from {
      opacity: 0;
      transform: translateY(-0.35rem) scale(0.985);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @media (max-width: 640px) {
    .dock-panel {
      top: calc(100% + 0.6rem);
      right: 0;
      width: min(calc(100vw - 1.5rem), 22rem);
      max-height: min(calc(100dvh - 5.25rem), 32rem);
    }

    .dock-volume {
      flex: 1 1 7.5rem;
    }
  }
</style>
