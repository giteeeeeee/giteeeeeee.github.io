---
/**
 * ProjectCard Component
 * Individual project card display
 */
import { formatNumber, formatDate, getLanguageColor } from '@features/projects/lib/github';
import { getProjectsConfig } from '@app/config/site.config';
import { useI18n } from '@features/i18n/lib/i18n';

interface Props {
  project: {
    owner: string;
    name: string;
    description: string | null;
    language: string | null;
    stars: number;
    forks: number;
    topics: string[];
    updatedAt: string;
    customDescription?: string;
    customTags?: string[];
    featured?: boolean;
    category?: string;
  };
}

const { project } = Astro.props;
const { displaySettings } = getProjectsConfig();
const { t } = useI18n();
const showStats = displaySettings.showStars || displaySettings.showForks || displaySettings.showLastUpdate;
---

<a
  href={`/projects/${project.owner}/${project.name}`}
  class="project-card"
  data-category={project.category}
  data-featured={project.featured}
  data-astro-prefetch="hover"
>
  <div class="project-main">
    <div class="project-header">
      <h3 class="project-name">
        <i class="i-carbon:folder"></i>
        {project.name}
      </h3>
      {project.featured && (
        <span class="featured-badge">
          <i class="i-carbon:star-filled"></i>
          <span data-i18n="projects.featured">{t('projects.featured')}</span>
        </span>
      )}
    </div>
    
    {(project.customDescription || project.description) && (
      <p class="project-description">{project.customDescription || project.description}</p>
    )}

    <div class="project-tags">
      {displaySettings.showLanguages && project.language && (
        <span class="tag tag-language" style={`--lang-color: ${getLanguageColor(project.language)}`}>
          <span class="lang-dot"></span>
          {project.language}
        </span>
      )}
      {[...project.topics, ...(project.customTags || [])].slice(0, 5).map(tag => (
        <span class="tag">{tag}</span>
      ))}
    </div>
  </div>

  <!-- 右侧：统计信息 -->
  {showStats && <div class="project-stats">
    {displaySettings.showStars && <div class="stat">
      <i class="i-carbon:star"></i>
      <span>{formatNumber(project.stars)}</span>
    </div>}
    {displaySettings.showForks && <div class="stat">
      <i class="i-carbon:branch"></i>
      <span>{formatNumber(project.forks)}</span>
    </div>}
    {displaySettings.showLastUpdate && <div class="stat stat-updated">
      <i class="i-carbon:time"></i>
      <span>{formatDate(project.updatedAt)}</span>
    </div>}
  </div>}
</a>

<style>
  .project-card {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    height: 100%;
    padding: 1.15rem 1.3rem;
    border-bottom: 1px solid rgba(var(--md-sys-color-outline-variant-rgb), 0.38);
    background: transparent;
    color: inherit;
  }

  .project-card::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(115deg, rgba(var(--md-sys-color-primary-rgb), 0.08), transparent 70%);
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  .project-card:hover::before {
    opacity: 1;
  }

  .project-main {
    flex: 1;
    min-width: 0;
  }

  .project-header {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    margin-bottom: 0.5rem;
  }

  .project-name {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1.02rem;
    font-weight: 820;
    color: var(--md-sys-color-on-surface);
    margin: 0;
    transition: color 0.2s ease;
  }

  .project-card:hover .project-name {
    color: var(--md-sys-color-primary);
  }

  .project-name i {
    font-size: 1.125rem;
  }

  .featured-badge {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0;
    background: transparent;
    color: var(--md-sys-color-primary);
    font-size: 0.6875rem;
    font-weight: 600;
    border-radius: 0;
  }

  .featured-badge i {
    font-size: 0.75rem;
  }

  .project-description {
    font-size: 0.875rem;
    color: var(--md-sys-color-on-surface-variant);
    line-height: 1.5;
    margin: 0 0 0.75rem 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin-bottom: 0.2rem;
  }

  .tag {
    padding: 0;
    color: var(--md-sys-color-on-surface-variant);
    font-size: 0.7rem;
  }

  .tag:not(:last-child)::after {
    content: '·';
    margin-left: 0.375rem;
    color: var(--md-sys-color-outline);
  }

  .tag-language {
    display: flex;
    align-items: center;
    gap: 0.3125rem;
  }

  .lang-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--lang-color);
  }

  .project-stats {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding-top: 0.55rem;
    border-top: 1px solid rgba(var(--md-sys-color-outline-variant-rgb), 0.34);
  }

  .stat {
    display: flex;
    align-items: center;
    gap: 0.3125rem;
    font-size: 0.8125rem;
    color: var(--md-sys-color-on-surface-variant);
    font-weight: 500;
  }

  .stat i {
    font-size: 0.9375rem;
  }

  .stat-updated {
    margin-left: auto;
  }

  @media (max-width: 768px) {
    .project-stats {
      flex-wrap: wrap;
    }

    .stat-updated {
      margin-left: 0;
      width: 100%;
    }
  }
</style>
