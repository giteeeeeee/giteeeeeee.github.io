---
import { formatNumber } from '@features/projects/lib/github';
import { useI18n } from '@features/i18n/lib/i18n';

interface Props {
  project: {
    name: string;
    description: string | null;
    url: string;
    homepage: string | null;
    stars: number;
    forks: number;
    language: string | null;
    license: string | null;
    topics: string[];
    createdAt: string;
    updatedAt: string;
  };
}

const { project } = Astro.props;
const { t } = useI18n();
const createdDate = new Date(project.createdAt);
const updatedDate = new Date(project.updatedAt);
const stats = [
  { icon: 'i-carbon:star', label: t('projects.stats.stars'), key: 'projects.stats.stars', value: formatNumber(project.stars) },
  { icon: 'i-carbon:branch', label: t('projects.stats.forks'), key: 'projects.stats.forks', value: formatNumber(project.forks) },
  ...(project.language ? [{ icon: 'i-carbon:code', label: t('projects.detail.language'), key: 'projects.detail.language', value: project.language }] : []),
  ...(project.license ? [{ icon: 'i-carbon:license', label: t('projects.detail.license'), key: 'projects.detail.license', value: project.license }] : []),
];
---

<header class="project-detail-header" data-project-detail-header>
  <div class="project-heading">
    <p class="project-eyebrow"><i class="i-carbon:cube" aria-hidden="true"></i><span data-i18n="projectsPage.title">{t('projectsPage.title')}</span></p>
    <h1>{project.name}</h1>
    {project.description && <p class="project-description">{project.description}</p>}

    <div class="project-actions">
      <a href={project.url} target="_blank" rel="noopener noreferrer" class="primary">
        <i class="i-carbon:logo-github" aria-hidden="true"></i>
        <span data-i18n="projects.detail.github">{t('projects.detail.github')}</span>
        <i class="i-carbon:arrow-up-right" aria-hidden="true"></i>
      </a>
      {project.homepage && (
        <a href={project.homepage} target="_blank" rel="noopener noreferrer">
          <i class="i-carbon:launch" aria-hidden="true"></i>
          <span data-i18n="projects.detail.preview">{t('projects.detail.preview')}</span>
        </a>
      )}
    </div>
  </div>

  <dl class="project-stats">
    {stats.map((stat) => (
      <div><dt><i class={stat.icon} aria-hidden="true"></i><span data-i18n={stat.key}>{stat.label}</span></dt><dd>{stat.value}</dd></div>
    ))}
  </dl>

  <div class="project-detail-footer">
    <div class="project-dates">
      <span><span data-i18n="projects.detail.created">{t('projects.detail.created')}</span> <time datetime={createdDate.toISOString()} data-i18n-date={createdDate.toISOString()} data-i18n-date-format="short">{createdDate.toLocaleDateString('zh-CN')}</time></span>
      <span><span data-i18n="projects.detail.updated">{t('projects.detail.updated')}</span> <time datetime={updatedDate.toISOString()} data-i18n-date={updatedDate.toISOString()} data-i18n-date-format="short">{updatedDate.toLocaleDateString('zh-CN')}</time></span>
    </div>
    {project.topics.length > 0 && <div class="project-topics">{project.topics.map((topic) => <span>#{topic}</span>)}</div>}
  </div>
</header>

<style>
  .project-detail-header {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(16rem, 0.8fr);
    gap: clamp(1.8rem, 5vw, 4.2rem);
    margin-bottom: clamp(2.3rem, 6vw, 4rem);
    padding-bottom: 1.4rem;
    border-bottom: 1px solid rgba(var(--md-sys-color-outline-variant-rgb), 0.52);
  }

  .project-eyebrow { display: flex; align-items: center; gap: 0.45rem; margin: 0 0 0.55rem; color: var(--md-sys-color-primary); font-size: 0.68rem; font-weight: 840; letter-spacing: 0.08em; text-transform: uppercase; }
  .project-heading h1 { margin: 0; color: var(--md-sys-color-on-surface); font-size: clamp(1.9rem, 4.5vw, 2.8rem); font-weight: 900; line-height: 1.05; letter-spacing: -0.04em; overflow-wrap: anywhere; }
  .project-description { max-width: 42rem; margin: 0.7rem 0 0; color: var(--md-sys-color-on-surface-variant); font-size: 0.86rem; line-height: 1.65; }
  .project-actions { display: flex; flex-wrap: wrap; gap: 0.55rem; margin-top: 1.1rem; }
  .project-actions a { display: inline-flex; align-items: center; gap: 0.38rem; min-height: 2.2rem; padding: 0.42rem 0.72rem; color: var(--md-sys-color-primary); border: 1px solid rgba(var(--md-sys-color-primary-rgb), 0.26); border-radius: 0.72rem; font-size: 0.7rem; font-weight: 780; }
  .project-actions a.primary { color: var(--md-sys-color-on-primary); background: var(--md-sys-color-primary); border-color: var(--md-sys-color-primary); }
  .project-actions a:hover { transform: translateY(-1px); }

  .project-stats { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); align-self: end; margin: 0; }
  .project-stats > div { min-width: 0; padding: 0.65rem 0.85rem; border-left: 1px solid rgba(var(--md-sys-color-outline-variant-rgb), 0.46); }
  .project-stats dt { display: flex; align-items: center; gap: 0.3rem; color: var(--md-sys-color-on-surface-variant); font-size: 0.61rem; font-weight: 760; letter-spacing: 0.04em; text-transform: uppercase; }
  .project-stats dt i { color: var(--md-sys-color-primary); font-size: 0.76rem; }
  .project-stats dd { margin: 0.25rem 0 0; overflow: hidden; color: var(--md-sys-color-on-surface); font-size: 0.92rem; font-weight: 850; text-overflow: ellipsis; white-space: nowrap; }

  .project-detail-footer { grid-column: 1 / -1; display: flex; align-items: flex-end; justify-content: space-between; gap: 1.2rem; padding-top: 0.95rem; border-top: 1px solid rgba(var(--md-sys-color-outline-variant-rgb), 0.4); }
  .project-dates, .project-topics { display: flex; flex-wrap: wrap; gap: 0.45rem 1rem; color: var(--md-sys-color-on-surface-variant); font-size: 0.64rem; }
  .project-topics { justify-content: flex-end; color: var(--md-sys-color-primary); }

  @media (max-width: 760px) {
    .project-detail-header { grid-template-columns: 1fr; gap: 1.3rem; }
    .project-stats > div:first-child, .project-stats > div:nth-child(odd) { padding-left: 0; border-left: 0; }
    .project-detail-footer { display: grid; }
    .project-topics { justify-content: flex-start; }
  }
</style>
