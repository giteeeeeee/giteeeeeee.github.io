---
/** GitHub activity summarized as one editorial data surface. */
import type { GitHubContributionCalendar } from '@features/projects/lib/github';
import { useI18n } from '@features/i18n/lib/i18n';

interface Props {
  calendar: GitHubContributionCalendar;
  languages: Array<{ name: string; count: number; color: string }>;
}

const { calendar, languages } = Astro.props;
const { t } = useI18n();
const sourceKey = ({
  graphql: 'home.heatmap.source.graphql',
  events: 'home.heatmap.source.events',
  repos: 'home.heatmap.source.repos',
  cache: 'home.heatmap.source.cache',
  empty: 'home.heatmap.source.empty',
} as const)[calendar.source];
const sourceLabel = t(sourceKey);
---

<section class="github-activity" data-project-activity>
  <header class="activity-header">
    <div>
      <p data-i18n="projects.activity.eyebrow">{t('projects.activity.eyebrow')}</p>
      <h2 data-i18n="projects.activity.title">{t('projects.activity.title')}</h2>
    </div>
    <a href={`https://github.com/${calendar.username}`} target="_blank" rel="noopener noreferrer">
      <i class="i-carbon:logo-github" aria-hidden="true"></i>
      <span>@{calendar.username}</span>
      <i class="i-carbon:arrow-up-right" aria-hidden="true"></i>
    </a>
  </header>

  <div class="activity-grid">
    <div class="heatmap-panel">
      <div class="heatmap-summary">
        <div>
          <strong>{calendar.totalContributions}</strong>
          <span data-i18n="projects.activity.contributions">{t('projects.activity.contributions')}</span>
        </div>
        <span class="activity-source" data-i18n={sourceKey}>{sourceLabel}</span>
      </div>
      <div class="heatmap-scroll" aria-label={t('home.heatmap.gridLabel')}>
        <div class="heatmap" aria-hidden="true">
          {calendar.weeks.map((week) => (
            <div class="heatmap-week">
              {week.map((day) => (
                <span class={`heatmap-day level-${day.level}`} title={`${day.date}: ${day.count}`}></span>
              ))}
            </div>
          ))}
        </div>
      </div>
      <div class="heatmap-legend">
        <span data-i18n="projects.activity.less">{t('projects.activity.less')}</span>
        {[0, 1, 2, 3, 4].map((level) => <span class={`legend-cell level-${level}`}></span>)}
        <span data-i18n="projects.activity.more">{t('projects.activity.more')}</span>
      </div>
    </div>

    <aside class="activity-summary">
      <dl class="activity-stats">
        <div><dt data-i18n="projects.activity.activeDays">{t('projects.activity.activeDays')}</dt><dd>{calendar.activeDays}</dd></div>
        <div><dt data-i18n="projects.activity.longestStreak">{t('projects.activity.longestStreak')}</dt><dd>{calendar.longestStreak}</dd></div>
        <div><dt data-i18n="projects.activity.currentStreak">{t('projects.activity.currentStreak')}</dt><dd>{calendar.currentStreak}</dd></div>
      </dl>
      <div class="language-panel">
        <h3><i class="i-carbon:code" aria-hidden="true"></i><span data-i18n="projects.activity.languages">{t('projects.activity.languages')}</span></h3>
        <div class="language-list">
          {languages.length > 0 ? languages.map((language) => (
            <div class="language-row">
              <span class="language-dot" style={`--language-color: ${language.color}`}></span>
              <span>{language.name}</span>
              <strong>{language.count}</strong>
            </div>
          )) : <p data-i18n="projects.activity.noLanguages">{t('projects.activity.noLanguages')}</p>}
        </div>
      </div>
    </aside>
  </div>
</section>

<style>
  .github-activity {
    margin-bottom: 1.4rem;
    padding: 1.2rem 1.25rem;
    border-top: 1px solid rgba(var(--md-sys-color-outline-variant-rgb), 0.5);
    border-bottom: 1px solid rgba(var(--md-sys-color-outline-variant-rgb), 0.5);
    background: linear-gradient(110deg, rgba(var(--md-sys-color-primary-rgb), 0.075), rgba(var(--md-sys-color-surface-container-rgb), 0.36) 58%, transparent);
  }

  .activity-header,
  .activity-header a,
  .heatmap-summary,
  .heatmap-legend,
  .language-row,
  .language-panel h3 {
    display: flex;
    align-items: center;
  }

  .activity-header {
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .activity-header p {
    margin: 0 0 0.18rem;
    color: var(--md-sys-color-primary);
    font-size: 0.66rem;
    font-weight: 850;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .activity-header h2 {
    margin: 0;
    color: var(--md-sys-color-on-surface);
    font-size: 1.1rem;
    font-weight: 850;
  }

  .activity-header a {
    gap: 0.38rem;
    color: var(--md-sys-color-on-surface-variant);
    font-size: 0.76rem;
    font-weight: 760;
  }

  .activity-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 14rem;
    gap: 1.25rem;
  }

  .heatmap-panel {
    min-width: 0;
  }

  .heatmap-summary {
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.75rem;
  }

  .heatmap-summary strong {
    margin-right: 0.35rem;
    color: var(--md-sys-color-on-surface);
    font-size: 1.3rem;
    font-weight: 900;
  }

  .heatmap-summary span {
    color: var(--md-sys-color-on-surface-variant);
    font-size: 0.7rem;
  }

  .activity-source {
    color: var(--md-sys-color-primary) !important;
    font-weight: 760;
  }

  .heatmap-scroll {
    overflow-x: auto;
    padding-bottom: 0.25rem;
  }

  .heatmap {
    display: flex;
    gap: 0.2rem;
    width: max-content;
  }

  .heatmap-week {
    display: grid;
    grid-template-rows: repeat(7, 0.58rem);
    gap: 0.2rem;
  }

  .heatmap-day,
  .legend-cell {
    width: 0.58rem;
    height: 0.58rem;
    border-radius: 0.14rem;
    background: rgba(var(--md-sys-color-outline-variant-rgb), 0.26);
  }

  .level-1 { background: rgba(var(--md-sys-color-primary-rgb), 0.24); }
  .level-2 { background: rgba(var(--md-sys-color-primary-rgb), 0.42); }
  .level-3 { background: rgba(var(--md-sys-color-primary-rgb), 0.68); }
  .level-4 { background: var(--md-sys-color-primary); }

  .heatmap-legend {
    justify-content: flex-end;
    gap: 0.24rem;
    margin-top: 0.55rem;
    color: var(--md-sys-color-on-surface-variant);
    font-size: 0.62rem;
  }

  .activity-summary {
    padding-left: 1.15rem;
    border-left: 1px solid rgba(var(--md-sys-color-outline-variant-rgb), 0.45);
  }

  .activity-stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 0 0 1rem;
  }

  .activity-stats > div {
    padding: 0 0.45rem;
    border-left: 1px solid rgba(var(--md-sys-color-outline-variant-rgb), 0.38);
    text-align: center;
  }

  .activity-stats > div:first-child {
    border-left: 0;
  }

  .activity-stats dt {
    color: var(--md-sys-color-on-surface-variant);
    font-size: 0.58rem;
    line-height: 1.25;
  }

  .activity-stats dd {
    margin: 0.25rem 0 0;
    color: var(--md-sys-color-primary);
    font-size: 1.05rem;
    font-weight: 900;
  }

  .language-panel h3 {
    gap: 0.38rem;
    margin: 0 0 0.55rem;
    color: var(--md-sys-color-on-surface);
    font-size: 0.76rem;
  }

  .language-list {
    display: grid;
    gap: 0.38rem;
  }

  .language-row {
    gap: 0.45rem;
    color: var(--md-sys-color-on-surface-variant);
    font-size: 0.69rem;
  }

  .language-row span:nth-child(2) {
    flex: 1;
  }

  .language-dot {
    width: 0.48rem;
    height: 0.48rem;
    border-radius: 999px;
    background: var(--language-color, var(--md-sys-color-primary));
  }

  .language-list p {
    margin: 0;
    color: var(--md-sys-color-on-surface-variant);
    font-size: 0.7rem;
  }

  @media (max-width: 820px) {
    .activity-grid {
      grid-template-columns: 1fr;
    }

    .activity-summary {
      padding: 1rem 0 0;
      border-top: 1px solid rgba(var(--md-sys-color-outline-variant-rgb), 0.4);
      border-left: 0;
    }
  }

  @media (max-width: 520px) {
    .github-activity {
      padding: 1rem 0;
      background: transparent;
    }

    .activity-header {
      align-items: flex-start;
    }
  }
</style>
