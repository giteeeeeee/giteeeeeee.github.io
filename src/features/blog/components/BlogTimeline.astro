---
/** Compact editorial index grouped by publication year. */
import type { CollectionEntry } from 'astro:content';
import { calculateReadingTime, getPostUrl } from '@features/blog/lib/blog';
import { useI18n } from '@features/i18n/lib/i18n';

interface Props {
  posts: CollectionEntry<'blog'>[];
}

const { posts } = Astro.props;
const { currentLang, t } = useI18n();
const locale = currentLang === 'zh' ? 'zh-CN' : 'en-US';
const shortDate = new Intl.DateTimeFormat(locale, { month: '2-digit', day: '2-digit' });

const postsByYear = posts.reduce((groups, post) => {
  const year = post.data.publishDate.getFullYear();
  (groups[year] ??= []).push(post);
  return groups;
}, {} as Record<number, typeof posts>);

const years = Object.keys(postsByYear).map(Number).sort((left, right) => right - left);
---

<div class="blog-editorial-index" data-blog-editorial-index>
  {years.map((year) => (
    <section class="blog-year" aria-labelledby={`blog-year-${year}`}>
      <header class="blog-year-heading">
        <h2 id={`blog-year-${year}`}>{year}</h2>
        <span>{postsByYear[year].length} <span data-i18n="archives.postsCount">{t('archives.postsCount')}</span></span>
      </header>

      <div class="blog-year-list">
        {postsByYear[year].map((post) => (
          <article class="blog-index-entry" data-blog-index-entry>
            <a href={getPostUrl(post)} data-astro-prefetch="hover">
              <time
                datetime={post.data.publishDate.toISOString()}
                data-i18n-date={post.data.publishDate.toISOString()}
                data-i18n-date-format="short"
              >
                {shortDate.format(post.data.publishDate)}
              </time>

              <span class="blog-index-copy">
                <span class="blog-index-kicker">
                  {post.data.featured && <span data-i18n="posts.featured">{t('posts.featured')}</span>}
                  {post.data.series && <span>{post.data.series}</span>}
                  {!post.data.featured && !post.data.series && post.data.category && <span>{post.data.category}</span>}
                </span>
                <h3>{post.data.title}</h3>
                {post.data.description && <p>{post.data.description}</p>}
                {post.data.tags.length > 0 && (
                  <span class="blog-index-tags">
                    {post.data.tags.slice(0, 4).map((tag) => <span>#{tag}</span>)}
                  </span>
                )}
              </span>

              <span class="blog-index-meta">
                <span>{calculateReadingTime(post.body)} <span data-i18n="blog.readTime">{t('blog.readTime')}</span></span>
                <i class="i-carbon:arrow-up-right" aria-hidden="true"></i>
              </span>
            </a>
          </article>
        ))}
      </div>
    </section>
  ))}
</div>

<style>
  .blog-editorial-index {
    display: grid;
    gap: 2.5rem;
  }

  .blog-year {
    display: grid;
    grid-template-columns: 6rem minmax(0, 1fr);
    gap: clamp(1rem, 4vw, 2.5rem);
  }

  .blog-year-heading {
    padding-top: 0.82rem;
  }

  .blog-year-heading h2 {
    margin: 0;
    color: var(--md-sys-color-primary);
    font-size: 1.05rem;
    font-weight: 900;
    line-height: 1;
  }

  .blog-year-heading span {
    display: block;
    margin-top: 0.35rem;
    color: var(--md-sys-color-on-surface-variant);
    font-size: 0.68rem;
  }

  .blog-year-list {
    border-top: 1px solid rgba(var(--md-sys-color-outline-variant-rgb), 0.5);
  }

  .blog-index-entry {
    border-bottom: 1px solid rgba(var(--md-sys-color-outline-variant-rgb), 0.42);
  }

  .blog-index-entry > a {
    display: grid;
    grid-template-columns: 4.4rem minmax(0, 1fr) auto;
    gap: 1.1rem;
    align-items: start;
    padding: 1rem 0.6rem;
    color: inherit;
  }

  .blog-index-entry > a:hover {
    padding-right: 0.35rem;
    padding-left: 0.85rem;
    background: linear-gradient(90deg, rgba(var(--md-sys-color-primary-rgb), 0.07), transparent 72%);
  }

  time {
    padding-top: 0.2rem;
    color: var(--md-sys-color-on-surface-variant);
    font-size: 0.72rem;
    font-weight: 750;
  }

  .blog-index-copy {
    min-width: 0;
  }

  .blog-index-kicker,
  .blog-index-tags,
  .blog-index-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
  }

  .blog-index-kicker {
    gap: 0.45rem;
    min-height: 0.9rem;
    margin-bottom: 0.32rem;
    color: var(--md-sys-color-primary);
    font-size: 0.65rem;
    font-weight: 820;
    letter-spacing: 0.045em;
    text-transform: uppercase;
  }

  h3 {
    margin: 0;
    color: var(--md-sys-color-on-surface);
    font-size: 1.04rem;
    font-weight: 830;
    line-height: 1.35;
  }

  p {
    display: -webkit-box;
    margin: 0.38rem 0 0;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    color: var(--md-sys-color-on-surface-variant);
    font-size: 0.79rem;
    line-height: 1.55;
  }

  .blog-index-tags {
    gap: 0.55rem;
    margin-top: 0.48rem;
    color: var(--md-sys-color-on-surface-variant);
    font-size: 0.66rem;
  }

  .blog-index-meta {
    justify-content: flex-end;
    gap: 0.55rem;
    padding-top: 0.2rem;
    color: var(--md-sys-color-on-surface-variant);
    font-size: 0.69rem;
    font-weight: 720;
    white-space: nowrap;
  }

  .blog-index-meta i {
    color: var(--md-sys-color-primary);
    font-size: 0.88rem;
  }

  @media (max-width: 700px) {
    .blog-year {
      grid-template-columns: 1fr;
      gap: 0.65rem;
    }

    .blog-year-heading {
      display: flex;
      align-items: baseline;
      gap: 0.5rem;
      padding-top: 0;
    }

    .blog-year-heading span {
      margin-top: 0;
    }

    .blog-index-entry > a {
      grid-template-columns: 3.5rem minmax(0, 1fr);
      gap: 0.7rem;
      padding-right: 0;
      padding-left: 0;
    }

    .blog-index-meta {
      grid-column: 2;
      justify-content: flex-start;
      padding-top: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .blog-index-entry > a:hover {
      padding-right: 0.6rem;
      padding-left: 0.6rem;
    }
  }
</style>
