---
/**
 * FullpageSection.astro
 * 全屏滚动的单个区块组件
 */
interface Props {
  sectionId: string;
}

const { sectionId } = Astro.props;
---

<div class="fullpage-section" data-section={sectionId}>
  <slot />
</div>

<style>
  .fullpage-section {
    height: 100%;
    width: 100%;
    position: absolute;
    inset: 0;
    transform: translate3d(0, 100%, 0);
    transition: none;
    will-change: transform;
    backface-visibility: hidden;
    contain: layout paint;
    overflow-y: hidden;
    overflow-x: hidden;
    overscroll-behavior: contain;
    scroll-behavior: auto;
  }

  .fullpage-section:first-of-type {
    transform: translate3d(0, 0, 0);
  }

  .fullpage-section[data-active='false'] * {
    animation-play-state: paused !important;
  }

  .fullpage-section[data-ready='true'] {
    transition: transform var(--reay-fullpage-duration, 560ms) cubic-bezier(0.18, 0.86, 0.22, 1);
  }
</style>
