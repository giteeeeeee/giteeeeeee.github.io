---
/**
 * HeroSection Component
 * Fullscreen hero section with typewriter effects
 * Layout: text content (left) + avatar (right)
 */
import { getLocalizedUserContent, getThemeConfig, getUserProfile } from '../../data/site.config';
import { useI18n } from '../../utils/i18n';

const { t, currentLang } = useI18n();
const user = getUserProfile();
const userContent = getLocalizedUserContent(currentLang);
const effectsConfig = getThemeConfig().effects;
const showHomeWave = effectsConfig.homeWave.enabled;
const homeWaveIntensity = effectsConfig.homeWave.intensity;
---

<section class="hero-section h-full w-full flex items-center justify-center relative overflow-hidden">
  <div class="hero-light hero-light-a" aria-hidden="true"></div>
  <div class="hero-light hero-light-b" aria-hidden="true"></div>
  
  <div class="container mx-auto px-4 sm:px-6 max-w-6xl relative z-10 pt-12 md:pt-0">
    <div class="grid grid-cols-1 lg:grid-cols-[1.08fr_0.92fr] gap-8 lg:gap-12 items-center">
      <!-- Text Content -->
      <div class="hero-copy text-left space-y-5">
        <div class="status-pill inline-flex items-center gap-2 px-3 py-1.5 text-xs font-700 text-[var(--md-sys-color-primary)]">
          <span class="status-dot"></span>
          <span data-i18n="home.hero.badge">{t('home.hero.badge')}</span>
        </div>

        <!-- Title with typewriter effect -->
        <div class="min-h-[76px] sm:min-h-[96px]">
          <h1 class="hero-title text-3xl sm:text-4xl md:text-5xl font-900 leading-[1.04]">
            <span class="text-[var(--md-sys-color-on-surface)]" data-i18n="home.hero.greeting">{t('home.hero.greeting')}</span>
            <span class="text-[var(--md-sys-color-on-surface)]"> </span>
            <span 
              id="name-typewriter"
              class="name-gradient bg-gradient-to-r from-[var(--md-sys-color-primary)] via-[var(--reay-color-warning)] to-[var(--md-sys-color-tertiary)] bg-clip-text text-transparent"
              data-text={user.name}
            ></span>
            <span class="title-icon inline-grid place-items-center align-middle ml-2">
              <i class="i-carbon:sun text-[1.1rem] sm:text-[1.35rem]"></i>
            </span>
          </h1>
        </div>

        <!-- Description with typewriter effect -->
        <div class="min-h-[44px]">
          <p 
            id="description-typewriter"
            class="hero-tagline text-sm sm:text-base text-[var(--md-sys-color-on-surface-variant)] font-500 italic"
            data-text={userContent.tagline}
            data-user-content="tagline"
          ></p>
        </div>

        <!-- Bio with fade-in effect -->
        <div 
          id="bio-content"
          class="min-h-[60px] opacity-0 translate-y-[10px]"
        >
          <p class="hero-bio text-sm sm:text-base text-[var(--md-sys-color-on-surface-variant)] font-500 leading-relaxed max-w-2xl" data-user-content="bio">
            {userContent.bio}
          </p>
        </div>

        <div class="hero-actions flex flex-wrap items-center gap-3 pt-1">
          <a href="/projects" class="hero-primary-btn group" data-reay-prefetch="idle" data-astro-prefetch="load">
            <span data-i18n="home.hero.projects">{t('home.hero.projects')}</span>
            <i class="i-carbon:arrow-right text-lg group-hover:translate-x-1 transition-transform"></i>
          </a>
          <a href="/blog" class="hero-secondary-btn group">
            <i class="i-carbon:blog text-lg"></i>
            <span data-i18n="home.hero.blog">{t('home.hero.blog')}</span>
          </a>
        </div>

        <!-- Social icons with scale animation -->
        <div id="social-icons-container" class="pt-1">
          <div class="flex items-center gap-2.5">
            {user.socials.map((social, index) => (
              <a 
                href={social.url} 
                target="_blank" 
                rel="noopener noreferrer"
                class="social-icon group relative opacity-0 scale-80"
                style={`animation-delay: ${index * 100}ms;`}
                aria-label={social.label}
                title={social.label}
              >
                <div class="social-button inline-flex items-center justify-center w-10 h-10 rounded-full">
                  <i class={`${social.icon} text-base text-[var(--md-sys-color-on-surface-variant)] group-hover:text-[var(--md-sys-color-primary)] transition-colors`}></i>
                </div>
              </a>
            ))}
          </div>
        </div>
      </div>

      <!-- 右侧：大头像 -->
      <div class="flex items-center justify-center lg:justify-end">
        <div class="relative avatar-container hero-avatar-stage">
          <div class="avatar-holo-frame" aria-hidden="true"></div>
          <div class="avatar-panel-lines" aria-hidden="true"></div>
          <!-- 头像 -->
          <div class="avatar-image-wrap relative">
            <img 
              src={user.avatar} 
              alt={user.name}
              class="relative w-36 h-36 sm:w-44 sm:h-44 lg:w-56 lg:h-56 rounded-full object-cover"
            />
          </div>
          <div class="avatar-caption hidden sm:flex items-center gap-2">
            <i class="i-carbon:development text-base text-[var(--md-sys-color-primary)]"></i>
            <span data-i18n="home.hero.caption">{t('home.hero.caption')}</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  {showHomeWave && (
    <div class="hero-wave-field" data-wave-intensity={homeWaveIntensity} aria-hidden="true">
      <div class="wave-glow"></div>
      <svg class="hero-wave-svg wave-layer-back" viewBox="0 0 1440 180" preserveAspectRatio="none">
        <path d="M0 92L60 82C120 72 240 52 360 58C480 64 600 96 720 103C840 110 960 92 1080 76C1200 60 1320 46 1380 39L1440 32V180H0V92Z"></path>
      </svg>
      <svg class="hero-wave-svg wave-layer-mid" viewBox="0 0 1440 180" preserveAspectRatio="none">
        <path d="M0 112L80 98C160 84 320 56 480 72C640 88 800 148 960 145C1120 142 1280 76 1360 43L1440 10V180H0V112Z"></path>
      </svg>
      <svg class="hero-wave-svg wave-layer-front" viewBox="0 0 1440 180" preserveAspectRatio="none">
        <path d="M0 132L80 121C160 110 320 88 480 98C640 108 800 150 960 154C1120 158 1280 124 1360 107L1440 90V180H0V132Z"></path>
      </svg>
    </div>
  )}

  <!-- 滚动提示 -->
  <div class="scroll-cue absolute bottom-6 left-1/2 -translate-x-1/2 flex flex-col items-center gap-1">
    <span class="text-xs text-[var(--md-sys-color-on-surface-variant)]" data-i18n="home.hero.scroll">{t('home.hero.scroll')}</span>
    <i class="i-carbon:chevron-down text-xl text-[var(--md-sys-color-on-surface-variant)]"></i>
  </div>
</section>

<style>
  .hero-section {
    perspective: 1200px;
  }

  .hero-section::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 24% 36%, rgba(var(--md-sys-color-primary-rgb), 0.2), transparent 30%),
      radial-gradient(circle at 76% 44%, rgba(var(--md-sys-color-tertiary-rgb), 0.18), transparent 32%),
      linear-gradient(to bottom, transparent 0 68%, rgba(var(--md-sys-color-surface-rgb), 0.16) 100%);
    opacity: 0.82;
    z-index: 0;
  }

  .hero-section::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(180deg, rgba(var(--md-sys-color-surface-rgb), 0.08), transparent 28% 72%, rgba(var(--md-sys-color-surface-rgb), 0.34)),
      linear-gradient(90deg, rgba(var(--md-sys-color-surface-rgb), 0.12), transparent 24% 76%, rgba(var(--md-sys-color-surface-rgb), 0.12));
    opacity: 0.72;
    z-index: 0;
  }

  .hero-light {
    position: absolute;
    inset: auto;
    z-index: 0;
    pointer-events: none;
    opacity: 0.78;
    filter: blur(14px);
    mix-blend-mode: screen;
  }

  .hero-light-a {
    width: 52vw;
    height: 34vh;
    left: -10vw;
    top: 18vh;
    background: radial-gradient(ellipse, rgba(var(--md-sys-color-primary-rgb), 0.22), transparent 70%);
    transform: translate3d(-1%, -1%, 0);
  }

  .hero-light-b {
    width: 48vw;
    height: 42vh;
    right: -8vw;
    bottom: 12vh;
    background: radial-gradient(ellipse, rgba(var(--md-sys-color-tertiary-rgb), 0.2), rgba(var(--reay-color-warning-rgb), 0.08), transparent 72%);
    transform: translate3d(1%, 1%, 0);
  }

  .hero-copy {
    transform-style: preserve-3d;
  }

  .status-pill,
  .hero-title,
  .hero-tagline,
  .hero-actions,
  #social-icons-container {
    animation: hero-item-in 0.78s var(--reay-ease-out, ease) both;
  }

  .hero-title {
    animation-delay: 0.08s;
  }

  .hero-tagline {
    animation-delay: 0.16s;
  }

  .hero-actions {
    animation-delay: 0.36s;
  }

  #social-icons-container {
    animation-delay: 0.46s;
  }

  .status-pill,
  .hero-secondary-btn,
  .social-button,
  .avatar-caption {
    border: 1px solid rgba(var(--md-sys-color-outline-variant-rgb), 0.38);
    background: rgba(var(--md-sys-color-surface-container-rgb), 0.48);
    box-shadow:
      inset 0 1px 0 rgba(var(--md-sys-color-surface-bright-rgb), 0.18),
      0 16px 36px -28px rgba(var(--md-sys-color-shadow-rgb), 0.65);
    backdrop-filter: blur(18px) saturate(150%);
    -webkit-backdrop-filter: blur(18px) saturate(150%);
  }

  .status-pill {
    border-radius: 999px;
    letter-spacing: 0;
  }

  .status-dot {
    width: 0.48rem;
    height: 0.48rem;
    border-radius: 999px;
    background: var(--reay-color-success);
    box-shadow: 0 0 14px rgba(var(--reay-color-success-rgb), 0.8);
    animation: status-pulse 1.8s ease-in-out infinite;
  }

  .hero-title {
    letter-spacing: 0;
    text-wrap: balance;
  }

  .name-gradient {
    position: relative;
    filter: drop-shadow(0 12px 30px rgba(var(--md-sys-color-primary-rgb), 0.24));
    background-size: 180% 100%;
    animation: name-gradient-flow 8s ease-in-out infinite alternate;
  }

  .title-icon {
    width: 2rem;
    height: 2rem;
    border-radius: 0.7rem;
    color: var(--reay-color-warning);
    background: rgba(var(--reay-color-warning-rgb), 0.14);
    border: 1px solid rgba(var(--reay-color-warning-rgb), 0.28);
    box-shadow: 0 0 22px rgba(var(--reay-color-warning-rgb), 0.22);
    animation: title-icon-glow 2.8s ease-in-out infinite;
  }

  .hero-tagline {
    max-width: 40rem;
  }

  .hero-bio {
    padding-left: 1rem;
    border-left: 2px solid rgba(var(--md-sys-color-primary-rgb), 0.42);
  }

  .hero-primary-btn,
  .hero-secondary-btn {
    min-height: 2.75rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    padding: 0 1.15rem;
    border-radius: 999px;
    font-size: 0.92rem;
    font-weight: 800;
    transition:
      transform 0.3s var(--reay-ease-spring, ease),
      box-shadow 0.3s ease,
      background 0.3s ease;
    position: relative;
    overflow: hidden;
  }

  .hero-primary-btn::before,
  .hero-secondary-btn::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(100deg, transparent, rgba(var(--md-sys-color-surface-bright-rgb), 0.22), transparent);
    transform: translateX(-120%);
    transition: transform 0.56s var(--reay-ease-out, ease-out);
  }

  .hero-primary-btn:hover::before,
  .hero-secondary-btn:hover::before {
    transform: translateX(120%);
  }

  .hero-primary-btn > *,
  .hero-secondary-btn > * {
    position: relative;
    z-index: 1;
  }

  .hero-primary-btn {
    color: var(--md-sys-color-on-primary);
    background:
      linear-gradient(135deg, var(--md-sys-color-primary), var(--md-sys-color-tertiary));
    box-shadow:
      0 18px 40px -18px rgba(var(--md-sys-color-primary-rgb), 0.8),
      inset 0 1px 0 rgba(var(--md-sys-color-surface-bright-rgb), 0.32);
  }

  .hero-primary-btn:hover,
  .hero-secondary-btn:hover {
    transform: translateY(-2px) scale(1.03);
  }

  .hero-secondary-btn:hover {
    color: var(--md-sys-color-primary);
    background: rgba(var(--md-sys-color-primary-container-rgb), 0.42);
  }

  .social-button {
    transition:
      transform 0.3s var(--reay-ease-spring, ease),
      border-color 0.3s ease,
      background 0.3s ease,
      box-shadow 0.3s ease;
  }

  .social-icon:hover .social-button {
    border-color: rgba(var(--md-sys-color-primary-rgb), 0.48);
    background: rgba(var(--md-sys-color-primary-container-rgb), 0.38);
    box-shadow: 0 18px 34px -18px rgba(var(--md-sys-color-primary-rgb), 0.7);
    transform: translateY(-3px) rotate(-2deg);
  }

  .hero-avatar-stage {
    width: min(74vw, 23rem);
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    border-radius: 2rem;
    transform-style: preserve-3d;
  }

  .avatar-holo-frame {
    position: absolute;
    inset: 0.5rem;
    border-radius: 2rem;
    background:
      linear-gradient(rgba(var(--md-sys-color-surface-container-rgb), 0.38), rgba(var(--md-sys-color-surface-container-rgb), 0.18)) padding-box,
      conic-gradient(from var(--avatar-angle, 0deg), var(--md-sys-color-primary), transparent 22%, var(--reay-color-warning), transparent 52%, var(--md-sys-color-tertiary), var(--md-sys-color-primary)) border-box;
    border: 1px solid transparent;
    box-shadow:
      inset 0 1px 0 rgba(var(--md-sys-color-surface-bright-rgb), 0.18),
      0 28px 70px -44px rgba(var(--md-sys-color-primary-rgb), 0.9);
    backdrop-filter: blur(14px) saturate(145%);
    -webkit-backdrop-filter: blur(14px) saturate(145%);
  }

  .avatar-holo-frame::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: linear-gradient(115deg, transparent 0 38%, rgba(var(--md-sys-color-surface-bright-rgb), 0.2) 48%, transparent 58% 100%);
    transform: translateX(-130%);
    animation: avatar-sweep 8s var(--reay-ease-out, ease-out) infinite;
  }

  .avatar-panel-lines {
    position: absolute;
    inset: 2rem;
    border-radius: 1.4rem;
    background:
      linear-gradient(90deg, rgba(var(--md-sys-color-on-surface-rgb), 0.08) 1px, transparent 1px),
      linear-gradient(rgba(var(--md-sys-color-on-surface-rgb), 0.07) 1px, transparent 1px);
    background-size: 24px 24px;
    mask-image: linear-gradient(135deg, transparent, rgb(var(--md-sys-color-scrim-rgb)) 22% 78%, transparent);
    opacity: 0.5;
    transform: translateZ(0);
  }

  .avatar-image-wrap {
    display: grid;
    place-items: center;
    padding: 0.55rem;
    border-radius: 999px;
    background:
      linear-gradient(rgba(var(--md-sys-color-surface-rgb), 0.72), rgba(var(--md-sys-color-surface-container-rgb), 0.58)) padding-box,
      conic-gradient(from 90deg, var(--md-sys-color-primary), var(--reay-color-warning), var(--md-sys-color-tertiary), var(--md-sys-color-primary)) border-box;
    border: 2px solid transparent;
    box-shadow:
      0 26px 52px -28px rgba(var(--md-sys-color-shadow-rgb), 0.72),
      0 0 42px rgba(var(--md-sys-color-primary-rgb), 0.24);
    transform: translateZ(48px);
    animation: avatar-float 7s ease-in-out infinite;
  }

  .avatar-image-wrap img {
    box-shadow: inset 0 0 0 1px rgba(var(--md-sys-color-surface-bright-rgb), 0.24);
  }

  .avatar-caption {
    position: absolute;
    right: -0.4rem;
    bottom: 3.2rem;
    min-height: 2.5rem;
    padding: 0 0.9rem;
    border-radius: 999px;
    color: var(--md-sys-color-on-surface-variant);
    font-size: 0.72rem;
    font-weight: 800;
  }

  .hero-wave-field {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    z-index: 5;
    height: clamp(6.5rem, 20vh, 12.5rem);
    pointer-events: none;
    overflow: hidden;
    opacity: 0.96;
    transform: translateZ(0);
    mask-image: linear-gradient(to top, rgb(var(--md-sys-color-scrim-rgb)) 0 82%, transparent 100%);
  }

  .hero-wave-field[data-wave-intensity='low'] {
    opacity: 0.74;
    height: clamp(5rem, 15vh, 9rem);
  }

  .hero-wave-field[data-wave-intensity='high'] {
    opacity: 1;
    height: clamp(8rem, 25vh, 15.5rem);
  }

  .wave-glow {
    position: absolute;
    left: 8%;
    right: 8%;
    bottom: 0;
    height: 62%;
    border-radius: 999px 999px 0 0;
    background:
      radial-gradient(ellipse at 50% 100%, rgba(var(--md-sys-color-primary-rgb), 0.42), transparent 70%),
      radial-gradient(ellipse at 30% 100%, rgba(var(--md-sys-color-tertiary-rgb), 0.34), transparent 68%);
    filter: blur(22px);
    animation: wave-glow-pulse 7s ease-in-out infinite;
  }

  .hero-wave-svg {
    position: absolute;
    left: -8%;
    right: -8%;
    bottom: -1px;
    width: 116%;
    height: 100%;
    transform-origin: center bottom;
    filter: drop-shadow(0 -10px 22px rgba(var(--md-sys-color-primary-rgb), 0.1));
  }

  .hero-wave-svg path {
    transform-box: fill-box;
    transform-origin: center;
    stroke: rgba(var(--md-sys-color-surface-bright-rgb), 0.28);
    stroke-width: 1.2;
  }

  .wave-layer-back {
    animation: wave-flow-back 16s ease-in-out infinite alternate;
  }

  .wave-layer-back path {
    fill: rgba(var(--md-sys-color-tertiary-container-rgb), 0.58);
  }

  .wave-layer-mid {
    animation: wave-flow-mid 13s ease-in-out infinite alternate-reverse;
  }

  .wave-layer-mid path {
    fill: rgba(var(--md-sys-color-primary-container-rgb), 0.74);
  }

  .wave-layer-front {
    animation: wave-flow-front 10.5s ease-in-out infinite alternate;
  }

  .wave-layer-front path {
    fill: rgba(var(--md-sys-color-surface-container-high-rgb), 0.9);
  }

  .scroll-cue {
    z-index: 10;
    animation: scroll-cue 1.8s ease-in-out infinite;
  }

  /* Typewriter cursor animation */
  #name-typewriter::after,
  #description-typewriter::after {
    content: '|';
    animation: blink 0.8s step-end infinite;
    margin-left: 2px;
  }

  #name-typewriter.typing-complete::after,
  #description-typewriter.typing-complete::after {
    display: none;
  }

  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }

  /* Bio fade-up animation */
  #bio-content.fade-up {
    animation: fadeUp 0.8s cubic-bezier(0.4, 0, 0.2, 1) forwards;
  }

  @keyframes fadeUp {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Social icon fade-scale animation */
  .social-icon.fade-scale {
    animation: fadeScale 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
  }

  @keyframes fadeScale {
    from {
      opacity: 0;
      transform: scale(0.8);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  /* Avatar container fade-in animation */
  .avatar-container {
    animation: fadeIn 1s ease-out 0.5s backwards;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes hero-copy-in {
    from { opacity: 0; transform: translateY(18px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @keyframes hero-item-in {
    from {
      opacity: 0;
      transform: translate3d(0, 12px, 0);
      filter: blur(6px);
    }
    to {
      opacity: 1;
      transform: translate3d(0, 0, 0);
      filter: blur(0);
    }
  }

  @keyframes hero-light-shift {
    from { transform: translate3d(-2%, -3%, 0) skewX(-8deg); }
    to { transform: translate3d(4%, 4%, 0) skewX(8deg); }
  }

  @keyframes status-pulse {
    0%, 100% { transform: scale(1); opacity: 1; }
    50% { transform: scale(1.4); opacity: 0.58; }
  }

  @keyframes name-gradient-flow {
    from { background-position: 0% 50%; }
    to { background-position: 100% 50%; }
  }

  @keyframes title-icon-glow {
    0%, 100% { transform: translateY(0) rotate(0deg); }
    50% { transform: translateY(-2px) rotate(5deg); }
  }

  @property --avatar-angle {
    syntax: '<angle>';
    initial-value: 0deg;
    inherits: false;
  }

  @keyframes avatar-angle {
    to { --avatar-angle: 360deg; }
  }

  @keyframes avatar-float {
    0%, 100% { transform: translateZ(48px) translateY(0) rotate(-1deg); }
    50% { transform: translateZ(48px) translateY(-10px) rotate(1deg); }
  }

  @keyframes avatar-sweep {
    0%, 42% { transform: translateX(-130%); opacity: 0; }
    52% { opacity: 0.9; }
    72%, 100% { transform: translateX(130%); opacity: 0; }
  }

  @keyframes panel-drift {
    from { background-position: 0 0, 0 0; }
    to { background-position: 24px 0, 0 24px; }
  }

  @keyframes wave-flow-back {
    from { transform: translate3d(-2.5%, 8px, 0) scaleY(0.92); }
    to { transform: translate3d(2.5%, -2px, 0) scaleY(1.04); }
  }

  @keyframes wave-flow-mid {
    from { transform: translate3d(3%, 4px, 0) scaleY(0.98); }
    to { transform: translate3d(-3%, -6px, 0) scaleY(1.08); }
  }

  @keyframes wave-flow-front {
    from { transform: translate3d(-1.8%, 2px, 0) scaleY(1); }
    to { transform: translate3d(2.2%, -8px, 0) scaleY(1.1); }
  }

  @keyframes wave-glow-pulse {
    0%, 100% { opacity: 0.68; transform: scaleX(0.96); }
    50% { opacity: 0.96; transform: scaleX(1.04); }
  }

  @keyframes scroll-cue {
    0%, 100% { transform: translate(-50%, 0); opacity: 0.72; }
    50% { transform: translate(-50%, 6px); opacity: 1; }
  }

  @media (max-width: 1024px) {
    .hero-copy {
      text-align: center;
    }

    .hero-tagline,
    .hero-bio {
      margin-left: auto;
      margin-right: auto;
    }

    .hero-bio {
      padding-left: 0;
