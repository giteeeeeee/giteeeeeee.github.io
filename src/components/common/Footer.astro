---
/**
 * Footer Component
 * Compact site-wide footer.
 */
import { getLocalizedUserContent, getUserProfile } from '../../data/site.config';
import { useI18n } from '../../utils/i18n';

const { t, currentLang } = useI18n();
const user = getUserProfile();
const userContent = getLocalizedUserContent(currentLang);

const year = new Date().getFullYear();
const startYear = 2024;
const yearText = year === startYear ? `${year}` : `${startYear} - ${year}`;

const quickLinks = [
  { href: '/', key: 'nav.home' as const },
  { href: '/blog', key: 'nav.blog' as const },
  { href: '/projects', key: 'nav.projects' as const },
  { href: '/gallery', key: 'nav.gallery' as const },
  { href: '/guestbook', key: 'nav.guestbook' as const },
  { href: '/about', key: 'nav.about' as const },
];

const resourceLinks = [
  { href: '/rss.xml', label: 'RSS', icon: 'i-carbon:rss', external: false },
  { href: '/sitemap-index.xml', label: 'Sitemap', icon: 'i-carbon:map', external: false },
];
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-main">
      <div class="footer-brand">
        <img src={user.avatar} alt={user.name} class="footer-avatar" />
        <div class="footer-copy">
          <strong>{user.name}</strong>
          <p data-user-content="description">{userContent.description}</p>
        </div>
      </div>

      <nav class="footer-links" aria-label={t('footer.navigation')}>
        {quickLinks.map(link => (
          <a href={link.href} data-i18n={link.key}>{t(link.key)}</a>
        ))}
      </nav>

      <div class="footer-actions">
        <div class="footer-socials">
          {user.socials.map(social => (
            <a
              href={social.url}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={social.label}
              title={social.label}
            >
              <i class={social.icon}></i>
            </a>
          ))}
        </div>

        <nav class="footer-resources" aria-label={t('footer.subscribe')}>
          {resourceLinks.map(link => (
            <a
              href={link.href}
              target={link.external ? '_blank' : undefined}
              rel={link.external ? 'noopener noreferrer' : undefined}
            >
              <i class={link.icon}></i>
              <span>{link.label}</span>
            </a>
          ))}
        </nav>
      </div>
    </div>

    <div class="footer-bottom">
      <span>&copy; {yearText} {user.name}</span>
      <span class="footer-stack">Astro · UnoCSS · TypeScript</span>
    </div>
  </div>
</footer>

<script>
  import { initI18n } from '../../scripts/i18n-content-updater';
  import { initUserContentI18n } from '../../scripts/i18n-user-content';
  
  initI18n();
  initUserContentI18n();
</script>

<style>
  .site-footer {
    flex-shrink: 0;
    border-top: 1px solid rgba(var(--md-sys-color-outline-variant-rgb), 0.42);
    background:
      linear-gradient(180deg, rgba(var(--md-sys-color-surface-rgb), 0.78), rgba(var(--md-sys-color-surface-container-rgb), 0.82));
    contain: layout paint style;
    transform: translateZ(0);
    backface-visibility: hidden;
  }

  .footer-inner {
    width: min(100%, 1100px);
    margin: 0 auto;
    padding: 1rem 1rem 0.85rem;
  }

  .footer-main {
    display: grid;
    grid-template-columns: minmax(220px, 1.1fr) minmax(280px, 1.3fr) auto;
    align-items: center;
    gap: 1rem;
  }

  .footer-brand {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    min-width: 0;
  }

  .footer-avatar {
    width: 2rem;
    height: 2rem;
    flex: 0 0 auto;
    border-radius: 999px;
    object-fit: cover;
    box-shadow: 0 0 0 1px rgba(var(--md-sys-color-primary-rgb), 0.18);
  }

  .footer-copy {
    min-width: 0;
  }

  .footer-copy strong {
    display: block;
    color: var(--md-sys-color-on-surface);
    font-size: 0.9rem;
    line-height: 1.2;
  }

  .footer-copy p {
    display: -webkit-box;
    margin: 0.18rem 0 0;
    overflow: hidden;
    color: var(--md-sys-color-on-surface-variant);
    font-size: 0.76rem;
    line-height: 1.35;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 1;
  }

  .footer-links,
  .footer-resources,
  .footer-socials {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.38rem;
  }

  .footer-links {
    justify-content: center;
  }

  .footer-links a,
  .footer-resources a,
  .footer-socials a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 1.75rem;
    border: 1px solid rgba(var(--md-sys-color-outline-variant-rgb), 0.32);
    border-radius: 999px;
    color: var(--md-sys-color-on-surface-variant);
    background: rgba(var(--md-sys-color-surface-container-high-rgb), 0.36);
    font-size: 0.76rem;
    font-weight: 650;
    transition:
      color 0.18s ease,
      background 0.18s ease,
      border-color 0.18s ease,
      transform 0.18s ease;
  }

  .footer-links a,
  .footer-resources a {
    padding: 0.25rem 0.58rem;
  }

  .footer-socials a {
    width: 1.75rem;
    padding: 0;
  }

  .footer-resources a {
    gap: 0.32rem;
  }

  .footer-links a:hover,
  .footer-resources a:hover,
  .footer-socials a:hover {
    color: var(--md-sys-color-primary);
    border-color: rgba(var(--md-sys-color-primary-rgb), 0.28);
    background: rgba(var(--md-sys-color-primary-container-rgb), 0.36);
    transform: translateY(-1px);
  }

  .footer-actions {
    display: grid;
    justify-items: end;
    gap: 0.45rem;
  }

  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-top: 0.85rem;
    padding-top: 0.65rem;
    border-top: 1px solid rgba(var(--md-sys-color-outline-variant-rgb), 0.3);
    color: var(--md-sys-color-on-surface-variant);
    font-size: 0.72rem;
  }

  .footer-stack {
    opacity: 0.74;
  }

  @media (max-width: 900px) {
    .footer-main {
      grid-template-columns: 1fr;
      align-items: start;
      gap: 0.8rem;
    }

    .footer-links {
      justify-content: flex-start;
    }

    .footer-actions {
      justify-items: start;
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 0.65rem;
    }
  }

  @media (max-width: 560px) {
    .footer-inner {
      padding: 0.9rem 1rem 0.8rem;
    }

    .footer-bottom {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.25rem;
    }
  }
</style>
