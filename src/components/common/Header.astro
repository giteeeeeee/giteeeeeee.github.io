---
/**
 * Header Component
 * 
 * Responsive navigation header with:
 * - Mobile: Logo + hamburger menu → Drawer-style dropdown
 * - Desktop: Horizontal navigation bar
 * - Glass morphism effect with floating hover animations
 */
import { getUserProfile } from '../../data/site.config';
import LanguageToggle from './LanguageToggle.astro';
import { useI18n } from '../../utils/i18n';
import ThemeToggle from './ThemeToggle.astro';
import MusicDock from './MusicDock.astro';

const { t } = useI18n();
const user = getUserProfile();

const links = [
  { href: '/', key: 'nav.home' as const, label: t('nav.home') },
  { href: '/blog', key: 'nav.blog' as const, label: t('nav.blog') },
  { href: '/archives', key: 'nav.archives' as const, label: t('nav.archives') },
  { href: '/projects', key: 'nav.projects' as const, label: t('nav.projects') },
  { href: '/gallery', key: 'nav.gallery' as const, label: t('nav.gallery') },
  { href: '/links', key: 'nav.links' as const, label: t('nav.links') },
  { href: '/guestbook', key: 'nav.guestbook' as const, label: t('nav.guestbook') },
  { href: '/about', key: 'nav.about' as const, label: t('nav.about') },
];

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---
<header class="site-header sticky top-0 z-20" data-floating-header>
  <div class="site-header-inner mx-auto max-w-1100px px-4 sm:px-6 h-16 flex items-center justify-between gap-4">
    <!-- Brand with avatar -->
    <a 
      href="/" 
      class="brand-link text-lg sm:text-xl font-800 text-[var(--md-sys-color-primary)] flex items-center gap-2.5"
      aria-label={`${user.name} Home`}
    >
      <span class="brand-avatar-wrap">
        <img 
          src="/images/profile/avatar.png" 
          alt={user.name}
          class="brand-avatar w-8 h-8 rounded-full object-cover"
        />
      </span>
      <span class="hidden sm:inline">{user.name}</span>
    </a>

    <!-- Desktop nav with pill-style links and glass morphism -->
    <nav class="hidden lg:flex items-center gap-1.5 text-[var(--md-sys-color-on-surface-variant)]">
      {links.map(l => (
        <a 
          href={l.href} 
          class:list={[
            'nav-link px-3 py-2 text-sm font-600',
            isActive(l.href) && 'is-active'
          ]}
          aria-current={isActive(l.href) ? 'page' : undefined}
        >
          <span data-i18n={l.key}>{l.label}</span>
        </a>
      ))}
    </nav>

    <!-- Header controls group -->
    <div class="header-actions flex items-center gap-2">
      <LanguageToggle />
      <ThemeToggle />
      <MusicDock />
      <slot />
      <button
        id="menu-btn"
        class="menu-button lg:hidden inline-flex items-center justify-center w-9 h-9"
        aria-label="Open menu"
        aria-controls="mobile-menu"
        aria-expanded="false"
      >
        <i class="i-carbon:menu text-[1.25rem] text-[var(--md-sys-color-on-surface)]"></i>
      </button>
    </div>
  </div>

  <!-- Mobile menu with glass morphism -->
  <div id="mobile-menu" class="mobile-menu lg:hidden hidden">
    <nav class="mx-auto max-w-1100px px-4 sm:px-6 py-4 grid gap-1 text-[var(--md-sys-color-on-surface)]">
      {links.map(l => (
        <a 
          href={l.href} 
          class:list={[
            'mobile-nav-link px-4 py-2.5 text-sm font-600',
            isActive(l.href) && 'is-active'
          ]}
          aria-current={isActive(l.href) ? 'page' : undefined}
        >
          <span data-i18n={l.key}>{l.label}</span>
        </a>
      ))}
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 80;
    height: 4rem;
    padding: 0;
    background:
      linear-gradient(135deg, rgba(var(--md-sys-color-surface-rgb), 0.72), rgba(var(--md-sys-color-surface-container-rgb), 0.46)),
      linear-gradient(90deg, rgba(var(--md-sys-color-primary-rgb), 0.12), rgba(var(--md-sys-color-tertiary-rgb), 0.1));
    border-bottom: 1px solid rgba(var(--md-sys-color-outline-variant-rgb), 0.24);
    box-shadow:
      0 18px 48px -40px rgba(var(--md-sys-color-shadow-rgb), 0.62),
      inset 0 1px 0 rgba(var(--md-sys-color-surface-bright-rgb), 0.28);
    backdrop-filter: blur(24px) saturate(165%);
    -webkit-backdrop-filter: blur(24px) saturate(165%);
    transform: translateZ(0);
    backface-visibility: hidden;
    contain: layout style;
    overflow: visible;
    isolation: isolate;
    will-change: background, box-shadow;
    transition:
      background 0.24s var(--reay-ease-out, ease),
      border-color 0.24s var(--reay-ease-out, ease),
      box-shadow 0.24s var(--reay-ease-out, ease);
  }

  .site-header-inner {
    position: relative;
    height: 4rem;
    border: 1px solid transparent;
    border-radius: 0;
    transform: translate3d(0, 0, 0);
    transform-origin: top center;
    will-change: transform;
    transition:
      border-color 0.26s var(--reay-ease-out, ease),
      border-radius 0.3s var(--reay-ease-smooth, ease),
      background 0.26s var(--reay-ease-out, ease),
      box-shadow 0.26s var(--reay-ease-out, ease),
      transform 0.3s var(--reay-ease-smooth, ease);
  }

  .site-header.is-floating {
    background: transparent;
    border-bottom-color: transparent;
    box-shadow: none;
  }

  .site-header.is-floating .site-header-inner {
    max-width: min(1100px, calc(100vw - 1.5rem));
    border-color: rgba(var(--md-sys-color-outline-variant-rgb), 0.42);
    border-radius: 999px;
    background:
      linear-gradient(135deg, rgba(var(--md-sys-color-surface-rgb), 0.84), rgba(var(--md-sys-color-surface-container-rgb), 0.62)),
      linear-gradient(100deg, rgba(var(--md-sys-color-primary-rgb), 0.14), rgba(var(--md-sys-color-tertiary-rgb), 0.1));
    box-shadow:
      0 18px 42px -28px rgba(var(--md-sys-color-shadow-rgb), 0.72),
      0 0 0 1px rgba(var(--md-sys-color-surface-bright-rgb), 0.16) inset,
      0 0 26px -20px rgba(var(--md-sys-color-primary-rgb), 0.86);
    transform: translate3d(0, 0.48rem, 0);
  }

  .site-header::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--md-sys-color-primary), var(--md-sys-color-tertiary), transparent);
    opacity: 0.48;
    transform: scaleX(0.72);
    transform-origin: center;
    transition: opacity 0.35s ease, transform 0.35s var(--reay-ease-out, ease);
  }

  .site-header:hover::after {
    opacity: 0.72;
    transform: scaleX(1);
  }

  .site-header.is-floating::after {
    opacity: 0;
    transform: scaleX(0.36);
  }

  .brand-link {
    position: relative;
    transition: transform 0.35s var(--reay-ease-spring, ease);
  }

  .brand-link:hover {
    transform: translateY(-1px) scale(1.03);
    color: var(--md-sys-color-primary);
  }

  .brand-avatar-wrap {
    position: relative;
    display: inline-grid;
    place-items: center;
    width: 2.35rem;
    height: 2.35rem;
    border-radius: 999px;
    background: conic-gradient(from 180deg, var(--md-sys-color-primary), var(--md-sys-color-tertiary), var(--reay-color-warning), var(--md-sys-color-primary));
    box-shadow:
      0 0 0 1px rgba(var(--md-sys-color-primary-rgb), 0.2),
      0 12px 28px -20px rgba(var(--md-sys-color-primary-rgb), 0.65);
    transition: transform 0.35s var(--reay-ease-spring, ease), box-shadow 0.35s ease;
  }

  .brand-link:hover .brand-avatar-wrap {
    transform: rotate(6deg) scale(1.04);
    box-shadow:
      0 0 0 1px rgba(var(--md-sys-color-primary-rgb), 0.34),
      0 16px 38px -22px rgba(var(--md-sys-color-primary-rgb), 0.82);
  }

  .brand-avatar {
    width: 2rem;
    height: 2rem;
    border: 2px solid rgba(var(--md-sys-color-surface-rgb), 0.82);
  }

  .nav-link,
  .mobile-nav-link,
  .menu-button {
    position: relative;
    border-radius: 999px;
    border: 1px solid transparent;
    transition:
      color 0.3s var(--reay-ease-out, ease),
      background 0.3s var(--reay-ease-out, ease),
      border-color 0.3s var(--reay-ease-out, ease),
      box-shadow 0.3s var(--reay-ease-out, ease),
      transform 0.3s var(--reay-ease-out, ease);
  }

  .nav-link {
    overflow: hidden;
  }

  .nav-link::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background:
      linear-gradient(135deg, rgba(var(--md-sys-color-primary-rgb), 0.2), rgba(var(--md-sys-color-tertiary-rgb), 0.13)),
      linear-gradient(110deg, transparent, rgba(var(--md-sys-color-surface-bright-rgb), 0.2), transparent);
    background-size: auto, 220% 100%;
    background-position: 0 0, -120% 0;
    opacity: 0;
    transition: opacity 0.3s ease, background-position 0.58s var(--reay-ease-out, ease);
  }

  .nav-link::after {
    content: '';
    position: absolute;
    left: 20%;
    right: 20%;
    bottom: 0.35rem;
    height: 2px;
    border-radius: 999px;
    background: linear-gradient(90deg, var(--md-sys-color-primary), var(--md-sys-color-tertiary));
    transform: scaleX(0);
    transform-origin: center;
    transition: transform 0.3s var(--reay-ease-out, ease);
  }

  .nav-link:hover,
  .nav-link.is-active {
    color: var(--md-sys-color-primary);
    transform: translateY(-1px);
    border-color: rgba(var(--md-sys-color-primary-rgb), 0.22);
    box-shadow:
      0 14px 34px -24px rgba(var(--md-sys-color-primary-rgb), 0.68),
      inset 0 1px 0 rgba(var(--md-sys-color-surface-bright-rgb), 0.18);
  }

  .nav-link:hover::before,
  .nav-link.is-active::before {
    opacity: 1;
    background-position: 0 0, 120% 0;
  }

  .nav-link:hover::after,
  .nav-link.is-active::after {
    transform: scaleX(1);
  }

  .menu-button {
    border: 1px solid var(--reay-button-border);
    border-radius: var(--reay-icon-button-radius, 0.95rem);
    background: var(--reay-button-bg);
    box-shadow: var(--reay-button-shadow);
    backdrop-filter: blur(16px) saturate(150%);
    -webkit-backdrop-filter: blur(16px) saturate(150%);
  }

  .menu-button:hover {
    color: var(--md-sys-color-primary);
    border-color: rgba(var(--md-sys-color-primary-rgb), 0.48);
    background: var(--reay-button-bg-hover);
    transform: translateY(-1px);
    box-shadow: var(--reay-button-shadow-hover);
  }

  .mobile-menu {
    background:
      linear-gradient(135deg, rgba(var(--md-sys-color-surface-rgb), 0.92), rgba(var(--md-sys-color-surface-container-rgb), 0.72));
    border-top: 1px solid rgba(var(--md-sys-color-outline-variant-rgb), 0.32);
    border-radius: 0 0 var(--reay-radius-lg, 1.35rem) var(--reay-radius-lg, 1.35rem);
    box-shadow: 0 18px 45px -30px rgba(var(--md-sys-color-shadow-rgb), 0.55);
    backdrop-filter: blur(24px) saturate(160%);
    -webkit-backdrop-filter: blur(24px) saturate(160%);
  }

  .site-header.is-floating .mobile-menu {
    max-width: min(1100px, calc(100vw - 1.5rem));
    margin: 0.75rem auto 0;
    border: 1px solid rgba(var(--md-sys-color-outline-variant-rgb), 0.38);
    border-radius: var(--reay-radius-lg, 1.35rem);
    overflow: hidden;
    box-shadow: 0 20px 48px -30px rgba(var(--md-sys-color-shadow-rgb), 0.68);
  }

  .mobile-nav-link {
    border: 1px solid transparent;
  }

  .mobile-nav-link:hover,
  .mobile-nav-link.is-active {
    color: var(--md-sys-color-primary);
    background: rgba(var(--md-sys-color-primary-container-rgb), 0.35);
    border-color: rgba(var(--md-sys-color-primary-rgb), 0.18);
    transform: translateX(4px);
  }

  @media (max-width: 640px) {
    .site-header.is-floating .site-header-inner {
      max-width: calc(100vw - 1rem);
      border-radius: 1.4rem;
    }

    .site-header.is-floating .mobile-menu {
      max-width: calc(100vw - 1rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header,
    .site-header-inner,
    .site-header::after {
      transition-duration: 0.01ms;
    }
  }
</style>

<script>
  import { initMobileMenu } from '../../scripts/interactions/mobile-menu';
  
  initMobileMenu();

  const initFloatingHeader = () => {
    const header = document.querySelector<HTMLElement>('[data-floating-header]');
    if (!header || header.dataset.floatingReady === 'true') return;

    header.dataset.floatingReady = 'true';
    let fullPageIndex = 0;
    let ticking = false;
    let isFloating = false;

    const update = () => {
      const shouldFloat = window.scrollY > 24 || fullPageIndex > 0;
      if (shouldFloat !== isFloating) {
        header.classList.toggle('is-floating', shouldFloat);
        isFloating = shouldFloat;
      }
      ticking = false;
    };

    const requestUpdate = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(update);
    };

    window.addEventListener('scroll', requestUpdate, { passive: true });
    window.addEventListener('resize', requestUpdate, { passive: true });
    window.addEventListener('reay:fullpage-section', (event) => {
      const detail = (event as CustomEvent<{ index?: number }>).detail;
      fullPageIndex = detail?.index ?? 0;
      requestUpdate();
    });

    update();
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initFloatingHeader, { once: true });
  } else {
    initFloatingHeader();
  }
</script>
