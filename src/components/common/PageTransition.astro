---
/**
 * PageTransition
 * Shared transition styling for Astro ClientRouter and MPA fallback.
 *
 * ClientRouter keeps navigation SPA-like; this stylesheet keeps the visual
 * treatment consistent even when native View Transitions are unavailable.
 */
---

<style is:inline data-astro-transition-persist="reay-page-transition">
  @keyframes reay-route-content-in {
    0% {
      opacity: 0.01;
      transform: translate3d(0, 28px, 0) scale(0.992);
    }

    58% {
      opacity: 0.88;
    }

    100% {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes reay-route-content-out {
    from {
      opacity: 1;
      transform: none;
    }

    to {
      opacity: 0;
      transform: translate3d(0, -10px, 0) scale(0.997);
    }
  }

  @keyframes reay-route-root-out {
    from {
      opacity: 1;
    }

    to {
      opacity: 0.72;
    }
  }

  @keyframes reay-route-root-in {
    0% {
      opacity: 0.9;
    }

    100% {
      opacity: 1;
    }
  }

  @view-transition {
    navigation: auto;
  }

  :root {
    --reay-route-enter-duration: 560ms;
    --reay-route-enter-ease: cubic-bezier(0.18, 0.88, 0.24, 1);
    --reay-route-exit-duration: 160ms;
  }

  [data-page-transition] {
    position: relative;
    view-transition-name: reay-page-content;
    transform-origin: center top;
  }

  body.layout-home [data-page-transition] {
    height: 100%;
    min-height: 0;
  }

  .site-header {
    view-transition-name: reay-site-header;
  }

  html[data-reay-route-phase="prepare"] [data-page-transition] {
    opacity: 0.98;
    transition: opacity 140ms ease;
  }

  html[data-reay-route-phase="enter"] [data-page-transition],
  html[data-reay-route-phase="initial"] [data-page-transition] {
    animation: reay-route-content-in var(--reay-route-enter-duration) var(--reay-route-enter-ease) both;
    will-change: opacity, transform;
  }

  html[data-reay-route-phase="enter"] .site-header,
  html[data-reay-route-phase="initial"] .site-header {
    transform: translateZ(0);
  }

  html[data-reay-route-phase="prepare"] .site-header,
  html[data-reay-route-phase="swap"] .site-header {
    transition: none;
  }

  html[data-astro-transition-fallback="old"] [data-page-transition] {
    animation: reay-route-content-out var(--reay-route-exit-duration) ease both;
  }

  html[data-astro-transition-fallback="new"] [data-page-transition] {
    animation: reay-route-content-in var(--reay-route-enter-duration) var(--reay-route-enter-ease) both;
  }

  @media (prefers-reduced-motion: no-preference) {
    ::view-transition-old(root) {
      animation: reay-route-root-out 0.16s ease both;
      mix-blend-mode: normal;
    }

    ::view-transition-new(root) {
      animation: reay-route-root-in 0.34s var(--reay-ease-out, ease) both;
      mix-blend-mode: normal;
    }

    ::view-transition-old(reay-page-content) {
      animation: reay-route-content-out var(--reay-route-exit-duration) ease both;
      transform-origin: center top;
    }

    ::view-transition-new(reay-page-content) {
      animation: reay-route-content-in var(--reay-route-enter-duration) var(--reay-route-enter-ease) both;
      transform-origin: center top;
    }

    ::view-transition-old(reay-site-header),
    ::view-transition-new(reay-site-header) {
      animation: none;
      mix-blend-mode: normal;
    }

    ::view-transition-old(reay-site-header) {
      opacity: 0;
    }

    ::view-transition-new(reay-site-header) {
      opacity: 1;
    }
  }

  @supports not (view-transition-name: reay-page-content) {
    @media (prefers-reduced-motion: no-preference) {
      [data-page-transition] {
        animation: reay-route-content-in var(--reay-route-enter-duration) var(--reay-route-enter-ease) backwards;
        transform-origin: center top;
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    ::view-transition-old(root),
    ::view-transition-new(root),
    ::view-transition-old(reay-page-content),
    ::view-transition-new(reay-page-content),
    ::view-transition-old(reay-site-header),
    ::view-transition-new(reay-site-header),
    html[data-reay-route-phase] [data-page-transition] {
      animation: none !important;
    }

    html[data-reay-route-phase] [data-page-transition] {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
      will-change: auto !important;
    }
  }
</style>
