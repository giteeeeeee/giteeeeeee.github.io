---
/**
 * BlogListHeader.astro
 * 博客列表页面头部组件
 */
import { useI18n } from '../../utils/i18n';
import { formatDate } from '../../utils/blog';

interface Props {
  totalPosts: number;
  totalTags?: number;
  totalSeries?: number;
  latestDate?: Date;
}

const { totalPosts, totalTags = 0, totalSeries = 0, latestDate } = Astro.props;
const { t } = useI18n();
const stats = [
  { icon: 'i-carbon:document', label: t('blog.stats.posts'), value: String(totalPosts) },
  { icon: 'i-carbon:tag', label: t('blog.stats.tags'), value: String(totalTags) },
  { icon: 'i-carbon:list-boxes', label: t('blog.stats.series'), value: String(totalSeries) },
  { icon: 'i-carbon:recently-viewed', label: t('blog.stats.updated'), value: latestDate ? formatDate(latestDate) : '-' },
];
---

<div class="blog-header">
  <div class="header-content">
    <h1 class="page-title">
      <i class="i-carbon:blog"></i>
      <span data-i18n="blog.title">{t('blog.title')}</span>
    </h1>
    <p class="page-subtitle" data-i18n="blog.subtitle">
      {t('blog.subtitle')}
    </p>
    <div class="blog-stats" aria-label="Blog statistics">
      {stats.map(item => (
        <div class="blog-stat-item">
          <i class={item.icon}></i>
          <span>{item.label}</span>
          <strong>{item.value}</strong>
        </div>
      ))}
    </div>
  </div>
</div>

<script>
  import { initI18n } from '../../scripts/i18n-content-updater';
  initI18n();
</script>

<style>
  .blog-header {
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid rgba(var(--md-sys-color-outline-variant-rgb), 0.58);
  }

  .header-content {
    text-align: center;
  }

  .page-title {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1.75rem;
    font-weight: 600;
    color: var(--md-sys-color-on-surface);
    margin: 0 0 0.5rem 0;
  }

  .page-title i {
    font-size: 1.5rem;
    color: var(--md-sys-color-primary);
  }

  .page-subtitle {
    font-size: 0.875rem;
    color: var(--md-sys-color-on-surface-variant);
    margin: 0 0 0.75rem 0;
    opacity: 0.9;
  }

  .page-meta {
    font-size: 0.8125rem;
    color: var(--md-sys-color-on-surface-variant);
    opacity: 0.7;
  }

  .blog-stats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.75rem;
    margin-top: 1.3rem;
    text-align: left;
  }

  .blog-stat-item {
    min-height: 5rem;
    padding: 0.85rem;
    border: 1px solid rgba(var(--md-sys-color-outline-variant-rgb), 0.48);
    border-radius: 0.75rem;
    background:
      linear-gradient(135deg, rgba(var(--md-sys-color-surface-container-rgb), 0.72), rgba(var(--md-sys-color-surface-rgb), 0.52));
    box-shadow: 0 18px 42px -38px rgba(var(--md-sys-color-shadow-rgb), 0.62);
  }

  .blog-stat-item i {
    color: var(--md-sys-color-primary);
    font-size: 1.05rem;
  }

  .blog-stat-item span {
    display: block;
    margin-top: 0.5rem;
    color: var(--md-sys-color-on-surface-variant);
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .blog-stat-item strong {
    display: block;
    margin-top: 0.16rem;
    color: var(--md-sys-color-on-surface);
    font-size: 0.92rem;
    line-height: 1.35;
  }

  @media (max-width: 768px) {
    .blog-stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .page-title {
      font-size: 1.5rem;
    }

    .page-title i {
      font-size: 1.25rem;
    }

    .page-subtitle {
      font-size: 0.8125rem;
    }
  }

  @media (max-width: 440px) {
    .blog-stats {
      grid-template-columns: 1fr;
    }
  }
</style>
