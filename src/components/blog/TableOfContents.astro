---
/**
 * TableOfContents Component
 * Article outline navigation with progress tracking
 * Features: fixed height, internal scroll, progress indicator, auto-follow
 */
interface Props {
  headings: Array<{ depth: number; text: string; slug: string }>;
}

const { headings } = Astro.props;

if (!headings || headings.length === 0) {
  return null;
}
---

<aside class="toc-sidebar hidden lg:block w-64 xl:w-72 sticky top-24 self-start">
  <div class="toc-container p-4 rounded-lg bg-[var(--md-sys-color-surface-variant)]/30 border border-[var(--md-sys-color-outline)]/20">
    <div class="toc-header flex items-center justify-between mb-4">
      <h2 class="toc-title text-sm font-600 uppercase tracking-wider text-[var(--md-sys-color-on-surface)]">
        Table of Contents
      </h2>
      <div class="toc-progress-circle" data-toc-progress-circle>
        <svg class="progress-ring" width="44" height="44">
          <circle
            class="progress-ring-bg"
            stroke="var(--md-sys-color-outline)"
            stroke-width="3"
            fill="transparent"
            r="18"
            cx="22"
            cy="22"
          />
          <circle
            class="progress-ring-circle"
            stroke="var(--md-sys-color-primary)"
            stroke-width="3"
            fill="transparent"
            r="18"
            cx="22"
            cy="22"
            data-progress-ring
          />
        </svg>
        <div class="progress-text" data-toc-progress>0%</div>
      </div>
    </div>
    
    <nav class="toc-nav-wrapper relative">
      <div class="toc-progress-indicator" data-toc-indicator>
        <div class="toc-indicator-line"></div>
      </div>
      
      <div class="toc-nav-scroll" data-toc-scroll>
        <ul class="toc-list space-y-1">
          {headings.map(({ depth, text, slug }) => (
            <li 
              class="toc-item"
              style={`padding-left: ${(depth - 1) * 0.75}rem`}
              data-toc-item
            >
              <a 
                href={`#${slug}`}
                class="toc-link block py-1.5 px-2 rounded text-sm text-[var(--md-sys-color-on-surface-variant)] hover:text-[var(--md-sys-color-primary)] hover:bg-[var(--md-sys-color-primary-container)]/20 transition-all"
                data-toc-link
                data-heading-id={slug}
              >
                {text}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </nav>
  </div>
</aside>

<style>
  /* TOC navigation container */
  .toc-nav-wrapper {
    position: relative;
  }
  
  /* Scrollable area with adaptive height */
  .toc-nav-scroll {
    max-height: 65vh;
    min-height: auto;
    overflow-y: auto;
    overflow-x: hidden;
    padding-right: 0.5rem;
    scroll-behavior: smooth;
  }
  
  /* Auto-shrink when content is minimal */
  .toc-nav-scroll:has(.toc-list) {
    height: auto;
  }
  
  /* Custom scrollbar styling */
  .toc-nav-scroll::-webkit-scrollbar {
    width: 4px;
  }
  
  .toc-nav-scroll::-webkit-scrollbar-track {
    background: var(--md-sys-color-surface-variant);
    border-radius: 2px;
  }
  
  .toc-nav-scroll::-webkit-scrollbar-thumb {
    background: var(--md-sys-color-outline);
    border-radius: 2px;
  }
  
  .toc-nav-scroll::-webkit-scrollbar-thumb:hover {
    background: var(--md-sys-color-primary);
  }
  
  /* Progress indicator container */
  .toc-progress-indicator {
    position: absolute;
    left: 0;
    top: 0;
    width: 3px;
    height: 100%;
    pointer-events: none;
    z-index: 10;
    overflow: hidden;
  }
  
  /* Progress indicator line */
  .toc-indicator-line {
    position: absolute;
    left: 0;
    width: 3px;
    background: linear-gradient(
      to bottom,
      var(--md-sys-color-primary),
      var(--md-sys-color-tertiary)
    );
    border-radius: 2px;
    transition: transform 0.2s ease, height 0.2s ease;
    box-shadow: 0 0 8px var(--md-sys-color-primary);
    transform-origin: top;
  }
  
  /* TOC item */
  .toc-item {
    position: relative;
  }
  
  /* TOC link */
  .toc-link {
    position: relative;
    transition:
      color 0.2s ease,
      background-color 0.2s ease;
  }
  
  /* Active state */
  .toc-link.active {
    color: var(--md-sys-color-primary);
    background: rgba(var(--md-sys-color-primary-container-rgb), 0.3);
    font-weight: 600;
  }
  
  /* Visible links in viewport */
  .toc-link.visible {
    color: var(--md-sys-color-on-surface);
    font-weight: 500;
  }
  
  /* Circular progress indicator */
  .toc-progress-circle {
    position: relative;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  
  .progress-ring {
    position: absolute;
    top: 0;
    left: 0;
    transform: rotate(-90deg);
  }
  
  .progress-ring-bg {
    opacity: 0.2;
  }
  
  .progress-ring-circle {
    stroke-dasharray: 113.097; /* 2 * PI * 18 */
    stroke-dashoffset: 113.097;
    transition: stroke-dashoffset 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    stroke-linecap: round;
  }
  
  .progress-text {
    position: relative;
    font-size: 10px;
    font-weight: 700;
    color: var(--md-sys-color-primary);
    z-index: 1;
  }
  
  /* Responsive adjustments */
  @media (max-height: 900px) {
    .toc-nav-scroll {
      max-height: 60vh;
    }
  }
  
  @media (max-height: 700px) {
    .toc-nav-scroll {
      max-height: 50vh;
    }
  }
  
  @media (max-height: 500px) {
    .toc-nav-scroll {
      max-height: 40vh;
    }
  }
</style>

<script>
  type TocRuntime = {
    bound: boolean;
    cleanup: (() => void) | null;
    init: (() => void) | null;
  };

  type ScrollRoot = HTMLElement;

  const windowWithToc = window as Window & { __reayTocRuntime?: TocRuntime };
  const tocRuntime = windowWithToc.__reayTocRuntime ?? {
    bound: false,
    cleanup: null,
    init: null,
  };

  windowWithToc.__reayTocRuntime = tocRuntime;

  const CIRCLE_RADIUS = 18;
  const CIRCLE_CIRCUMFERENCE = 2 * Math.PI * CIRCLE_RADIUS;

  function getDecodedHash(value: string) {
    try {
      return decodeURIComponent(value);
    } catch {
      return value;
    }
  }

  function findScrollRoot(): ScrollRoot {
    const candidates = [
      document.querySelector<HTMLElement>('[data-page-transition]'),
      document.querySelector<HTMLElement>('main'),
      document.scrollingElement as HTMLElement | null,
      document.documentElement,
    ].filter(Boolean) as HTMLElement[];

    const localScroller = candidates.find((element) => {
      if (element === document.documentElement || element === document.body || element === document.scrollingElement) {
        return false;
      }

      const style = window.getComputedStyle(element);
      const canScroll = /(auto|scroll|overlay)/.test(style.overflowY);
      return canScroll && element.scrollHeight > element.clientHeight + 2;
    });

    return localScroller ?? (document.scrollingElement as HTMLElement | null) ?? document.documentElement;
  }

  function isViewportScrollRoot(scrollRoot: ScrollRoot) {
    return scrollRoot === document.documentElement
      || scrollRoot === document.body
      || scrollRoot === document.scrollingElement;
  }

  function getScrollTop(scrollRoot: ScrollRoot) {
    return isViewportScrollRoot(scrollRoot)
      ? window.scrollY || document.documentElement.scrollTop || document.body.scrollTop || 0
      : scrollRoot.scrollTop;
  }

  function getViewportHeight(scrollRoot: ScrollRoot) {
    return isViewportScrollRoot(scrollRoot) ? window.innerHeight : scrollRoot.clientHeight;
  }

  function getScrollableHeight(scrollRoot: ScrollRoot) {
    return Math.max(0, scrollRoot.scrollHeight - getViewportHeight(scrollRoot));
  }

  function getRootBounds(scrollRoot: ScrollRoot) {
    if (isViewportScrollRoot(scrollRoot)) {
      return {
        top: 0,
        bottom: window.innerHeight,
        height: window.innerHeight,
      };
    }

    const rect = scrollRoot.getBoundingClientRect();
    return {
      top: rect.top,
      bottom: rect.bottom,
      height: rect.height,
    };
  }

  function getElementScrollTarget(element: HTMLElement, scrollRoot: ScrollRoot) {
    const scrollMarginTop = Number.parseFloat(
      window.getComputedStyle(element).scrollMarginTop || '0'
    ) || 0;

    if (isViewportScrollRoot(scrollRoot)) {
      return element.getBoundingClientRect().top + getScrollTop(scrollRoot) - scrollMarginTop;
    }

    const rootRect = scrollRoot.getBoundingClientRect();
    return element.getBoundingClientRect().top - rootRect.top + scrollRoot.scrollTop - scrollMarginTop;
  }

  function scrollToTarget(scrollRoot: ScrollRoot, top: number) {
    if (isViewportScrollRoot(scrollRoot)) {
      window.scrollTo({ top, behavior: 'smooth' });
      return;
    }

    scrollRoot.scrollTo({ top, behavior: 'smooth' });
  }

  function findTocLink(tocLinks: HTMLElement[], id: string | null) {
    if (!id) return null;

    return tocLinks.find((link) => {
      const headingId = link.dataset.headingId;
      if (headingId === id) return true;

      const href = link.getAttribute('href');
      return href?.startsWith('#') && getDecodedHash(href.slice(1)) === id;
    }) ?? null;
  }

  function initTableOfContents() {
    tocRuntime.cleanup?.();
    tocRuntime.cleanup = null;

    const tocLinks = Array.from(document.querySelectorAll<HTMLElement>('[data-toc-link]'));
    const tocScroll = document.querySelector<HTMLElement>('[data-toc-scroll]');
    const tocIndicator = document.querySelector<HTMLElement>('[data-toc-indicator]');
    const tocProgressText = document.querySelector<HTMLElement>('[data-toc-progress]');
    const tocProgressRing = document.querySelector<SVGCircleElement>('[data-progress-ring]');
    const headings = Array.from(
      document.querySelectorAll<HTMLElement>('.prose h2, .prose h3, .prose h4, .prose h5, .prose h6')
    ).filter((heading) => heading.id);

    if (!tocLinks.length || !headings.length || !tocScroll) return;

    const scrollRoot = findScrollRoot();
    const scrollTarget: HTMLElement | Window = isViewportScrollRoot(scrollRoot) ? window : scrollRoot;
    const visibleHeadings = new Map<HTMLElement, boolean>();
    let activeHeading: HTMLElement | null = null;
    let raf = 0;
    let tocRaf = 0;
    let resizeRaf = 0;

    const updateProgressIndicator = () => {
      if (!tocIndicator || !tocScroll) return;

      const visibleLinks = tocLinks.filter((link) => (
        link.classList.contains('visible') || link.classList.contains('active')
      ));

      if (!visibleLinks.length) {
        tocIndicator.style.opacity = '0';
        return;
      }

      tocIndicator.style.opacity = '1';

      const firstVisible = visibleLinks[0];
      const lastVisible = visibleLinks[visibleLinks.length - 1];
      const scrollContainerRect = tocScroll.getBoundingClientRect();
      const firstRect = firstVisible.getBoundingClientRect();
      const lastRect = lastVisible.getBoundingClientRect();
      const containerHeight = tocScroll.clientHeight;
      const startY = Math.max(0, Math.min(firstRect.top - scrollContainerRect.top, containerHeight));
      const endY = Math.max(0, Math.min(lastRect.bottom - scrollContainerRect.top, containerHeight));
      const indicatorLine = tocIndicator.querySelector<HTMLElement>('.toc-indicator-line');

      if (indicatorLine) {
        indicatorLine.style.transform = `translateY(${startY}px)`;
        indicatorLine.style.height = `${Math.max(0, endY - startY)}px`;
      }
    };

    const updateReadingProgress = () => {
      if (!tocProgressText || !tocProgressRing) return;

      const scrollableHeight = getScrollableHeight(scrollRoot);
      const progress = scrollableHeight <= 0
        ? 100
        : Math.max(0, Math.min(100, Math.round((getScrollTop(scrollRoot) / scrollableHeight) * 100)));

      tocProgressText.textContent = `${progress}%`;
      tocProgressRing.style.strokeDashoffset = `${CIRCLE_CIRCUMFERENCE * (1 - progress / 100)}`;
    };

    const scrollTocToActive = () => {
      const activeLink = tocLinks.find((link) => link.classList.contains('active'));
      if (!activeLink) return;

      const scrollRect = tocScroll.getBoundingClientRect();
      const linkRect = activeLink.getBoundingClientRect();
      const targetScroll = linkRect.top - scrollRect.top + tocScroll.scrollTop
        - (tocScroll.clientHeight / 2)
        + (linkRect.height / 2);

      tocScroll.scrollTo({ top: targetScroll, behavior: 'auto' });
    };

    const updateActiveHeading = () => {
      const rootBounds = getRootBounds(scrollRoot);
      const referenceTop = rootBounds.top + rootBounds.height * 0.3;
      let nextHeading: HTMLElement | null = null;
      let minDistance = Infinity;

      headings.forEach((heading) => {
        const rect = heading.getBoundingClientRect();
        const isInView = rect.top < rootBounds.bottom && rect.bottom > rootBounds.top;
        if (!isInView) return;

        const distance = Math.abs(rect.top - referenceTop);
        if (distance < minDistance) {
          minDistance = distance;
          nextHeading = heading;
        }
      });

      if (!nextHeading) {
        nextHeading = headings.find((heading) => visibleHeadings.get(heading)) ?? null;
      }

      if (!nextHeading || nextHeading === activeHeading) return;

      activeHeading = nextHeading;
      tocLinks.forEach((link) => link.classList.remove('active'));

      const activeLink = findTocLink(tocLinks, activeHeading.id);
      if (activeLink) {
        activeLink.classList.add('active');
        scrollTocToActive();
      }
    };

    const schedulePageUpdate = () => {
      if (raf) return;

      raf = requestAnimationFrame(() => {
        updateReadingProgress();
        updateActiveHeading();
        updateProgressIndicator();
        raf = 0;
      });
    };

    const scheduleTocUpdate = () => {
      if (tocRaf) return;

      tocRaf = requestAnimationFrame(() => {
        updateProgressIndicator();
        tocRaf = 0;
      });
    };

    const scheduleResizeUpdate = () => {
      if (resizeRaf) return;

      resizeRaf = requestAnimationFrame(() => {
        updateReadingProgress();
        updateActiveHeading();
        updateProgressIndicator();
        resizeRaf = 0;
      });
    };

    const headingObserver = new IntersectionObserver((entries) => {
      let shouldUpdate = false;

      entries.forEach((entry) => {
        const heading = entry.target as HTMLElement;
        const tocLink = findTocLink(tocLinks, heading.id);
        if (!tocLink) return;

        const wasVisible = visibleHeadings.get(heading);
        visibleHeadings.set(heading, entry.isIntersecting);
        tocLink.classList.toggle('visible', entry.isIntersecting);

        if (wasVisible !== entry.isIntersecting) {
          shouldUpdate = true;
        }
      });

      if (shouldUpdate) {
        schedulePageUpdate();
      }
    }, {
      root: isViewportScrollRoot(scrollRoot) ? null : scrollRoot,
      rootMargin: '-5% 0px -5% 0px',
      threshold: [0, 0.25, 0.5, 0.75, 1],
    });

    headings.forEach((heading) => {
      visibleHeadings.set(heading, false);
      headingObserver.observe(heading);
    });

    const linkCleanups = tocLinks.map((link) => {
      const handleClick = (event: MouseEvent) => {
        event.preventDefault();

        const href = link.getAttribute('href');
        if (!href?.startsWith('#')) return;

        const targetId = getDecodedHash(href.slice(1));
        const targetHeading = document.getElementById(targetId);
        if (!targetHeading) return;

        window.history.pushState(null, '', `#${encodeURIComponent(targetId)}`);
        scrollToTarget(scrollRoot, getElementScrollTarget(targetHeading, scrollRoot));
      };

      link.addEventListener('click', handleClick);
      return () => link.removeEventListener('click', handleClick);
    });

    scrollTarget.addEventListener('scroll', schedulePageUpdate, { passive: true });
    tocScroll.addEventListener('scroll', scheduleTocUpdate, { passive: true });
    window.addEventListener('resize', scheduleResizeUpdate, { passive: true });

    requestAnimationFrame(() => {
      updateReadingProgress();
      updateActiveHeading();
      updateProgressIndicator();
    });

    const delayedInit = window.setTimeout(() => {
      updateReadingProgress();
      updateActiveHeading();
      updateProgressIndicator();
    }, 160);

    tocRuntime.cleanup = () => {
      window.clearTimeout(delayedInit);
      headingObserver.disconnect();
      linkCleanups.forEach((cleanup) => cleanup());
      scrollTarget.removeEventListener('scroll', schedulePageUpdate);
      tocScroll.removeEventListener('scroll', scheduleTocUpdate);
      window.removeEventListener('resize', scheduleResizeUpdate);

      if (raf) cancelAnimationFrame(raf);
      if (tocRaf) cancelAnimationFrame(tocRaf);
      if (resizeRaf) cancelAnimationFrame(resizeRaf);

      tocRuntime.cleanup = null;
    };
  }

  tocRuntime.init = initTableOfContents;

  if (!tocRuntime.bound) {
    tocRuntime.bound = true;
    document.addEventListener('astro:page-load', () => tocRuntime.init?.());
    document.addEventListener('astro:before-swap', () => tocRuntime.cleanup?.());
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initTableOfContents, { once: true });
  } else {
    initTableOfContents();
  }
</script>
