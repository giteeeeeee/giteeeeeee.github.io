---
/**
 * Project Detail Page
 * Display GitHub README as blog post
 */
import ProjectDetailLayout from '@app/layouts/projects/ProjectDetailLayout.astro';
import ProjectDetailHeader from '@features/projects/components/ProjectDetailHeader.astro';
import ReadmeContent from '@features/projects/components/ReadmeContent.astro';
import { getGitHubRepo, getRepoReadme } from '@features/projects/lib/github';
import { getConfiguredProjects } from '@features/projects/lib/projects';
import { useI18n } from '@features/i18n/lib/i18n';
import { renderSafeReadme } from '@features/projects/lib/readme';

const { t } = useI18n();

// Generate static paths
export async function getStaticPaths() {
  const projects = await getConfiguredProjects();
  return projects.map(project => ({
    params: {
      owner: project.owner,
      repo: project.name
    }
  }));
}

const { owner, repo } = Astro.params;

if (!owner || !repo) {
  return Astro.redirect('/404');
}

// Get repository information
const repoInfo = await getGitHubRepo(owner, repo);
if (!repoInfo) {
  return Astro.redirect('/404');
}

// Get README content
const readmeContent = await getRepoReadme(owner, repo);
if (!readmeContent) {
  return Astro.redirect('/404');
}

const htmlContent = await renderSafeReadme(readmeContent);
---

<ProjectDetailLayout
  title={`${repoInfo.name} - Project Details`}
  description={repoInfo.description || `${repoInfo.name} Project Details`}
>
  <!-- Back button -->
  <a class="back-button" href="/projects">
    <i class="i-carbon:arrow-left"></i>
    <span data-i18n="projectsPage.back">{t('projectsPage.back')}</span>
  </a>

  <!-- Project header info -->
  <ProjectDetailHeader project={repoInfo} />

  <!-- README content -->
  <ReadmeContent htmlContent={htmlContent} />
</ProjectDetailLayout>

<style>
  .back-button {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.25rem 0;
    color: var(--md-sys-color-on-surface-variant);
    font-size: 0.72rem;
    font-weight: 740;
    text-decoration: none;
    cursor: pointer;
    margin-bottom: 1.1rem;
  }

  .back-button:hover {
    color: var(--md-sys-color-primary);
    transform: translateX(-2px);
  }

  .back-button i {
    font-size: 1rem;
  }
</style>
