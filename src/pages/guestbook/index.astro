---
import DefaultLayout from '../../layouts/base/DefaultLayout.astro';
import Comments from '../../components/common/Comments.astro';
import { getCommentsConfig } from '../../data/site.config';
import { useI18n } from '../../utils/i18n';

const { t } = useI18n();
const commentsConfig = getCommentsConfig();
const featureCards = [
  {
    icon: 'i-carbon:chat',
    title: t('guestbook.card.comments'),
    description: t('guestbook.card.commentsDesc'),
  },
  {
    icon: 'i-carbon:user-follow',
    title: t('guestbook.card.identity'),
    description: t('guestbook.card.identityDesc'),
  },
  {
    icon: 'i-carbon:email',
    title: t('guestbook.card.contact'),
    description: t('guestbook.card.contactDesc'),
  },
];
---

<DefaultLayout title={t('page.title.guestbook')} description={t('guestbook.subtitle')}>
  <div class="guestbook-page">
    <section class="guestbook-header">
      <div class="header-content">
        <h1 class="page-title">
          <i class="i-carbon:send-alt"></i>
          <span data-i18n="guestbook.title">{t('guestbook.title')}</span>
        </h1>
        <p class="page-subtitle" data-i18n="guestbook.subtitle">
          {t('guestbook.subtitle')}
        </p>
        <div class="guestbook-provider reay-chip">
          <i class="i-carbon:connect"></i>
          <span data-i18n="guestbook.eyebrow">{t('guestbook.eyebrow')}</span>
          <strong>{commentsConfig.provider}</strong>
        </div>
      </div>

      <div class="guestbook-stats" aria-label="Guestbook information">
        {featureCards.map(card => (
        <article class="guestbook-stat-item">
          <i class={card.icon}></i>
          <span>{card.title}</span>
          <strong>{card.description}</strong>
        </article>
        ))}
      </div>
    </section>

    <Comments
      mode="guestbook"
      pageKey="/guestbook"
      pageTitle={t('guestbook.title')}
      description={t('guestbook.commentsDesc')}
    />
  </div>
</DefaultLayout>

<style>
  .guestbook-page {
    width: min(100%, 960px);
    margin: 0 auto;
    padding: clamp(2rem, 5vw, 4rem) 0 4rem;
  }

  .guestbook-header {
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid rgba(var(--md-sys-color-outline-variant-rgb), 0.58);
  }

  .header-content {
    text-align: center;
  }

  .page-title {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1.75rem;
    font-weight: 600;
    color: var(--md-sys-color-on-surface);
    margin: 0 0 0.5rem 0;
  }

  .page-title i {
    font-size: 1.5rem;
    color: var(--md-sys-color-primary);
  }

  .page-subtitle {
    font-size: 0.875rem;
    color: var(--md-sys-color-on-surface-variant);
    margin: 0 0 0.75rem 0;
    opacity: 0.9;
  }

  .guestbook-provider {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 2rem;
    padding: 0.42rem 0.75rem;
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--md-sys-color-primary);
  }

  .guestbook-provider strong {
    color: var(--md-sys-color-on-surface);
    font-size: 0.72rem;
    text-transform: uppercase;
  }

  .guestbook-stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.75rem;
    margin-top: 1.3rem;
    text-align: left;
  }

  .guestbook-stat-item {
    min-height: 6.75rem;
    padding: 0.85rem;
    border: 1px solid rgba(var(--md-sys-color-outline-variant-rgb), 0.48);
    border-radius: 0.75rem;
    background:
      linear-gradient(135deg, rgba(var(--md-sys-color-surface-container-rgb), 0.72), rgba(var(--md-sys-color-surface-rgb), 0.52));
    box-shadow: 0 18px 42px -38px rgba(var(--md-sys-color-shadow-rgb), 0.62);
  }

  .guestbook-stat-item i {
    color: var(--md-sys-color-primary);
    font-size: 1.05rem;
  }

  .guestbook-stat-item span {
    display: block;
    margin-top: 0.5rem;
    color: var(--md-sys-color-on-surface-variant);
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .guestbook-stat-item strong {
    display: block;
    margin-top: 0.18rem;
    color: var(--md-sys-color-on-surface);
    font-size: 0.86rem;
    font-weight: 650;
    line-height: 1.5;
  }

  @media (max-width: 820px) {
    .guestbook-stats {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 768px) {
    .page-title {
      font-size: 1.5rem;
    }

    .page-title i {
      font-size: 1.25rem;
    }

    .page-subtitle {
      font-size: 0.8125rem;
    }
  }
</style>
