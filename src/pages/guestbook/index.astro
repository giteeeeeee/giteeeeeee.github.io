---
import EditorialPageLayout from '@app/layouts/base/EditorialPageLayout.astro';
import { getUserContactLinks } from '@app/config/site.config';
import Comments from '@features/comments/components/Comments.astro';
import { useI18n } from '@features/i18n/lib/i18n';
import EditorialPageHeader from '@shared/components/EditorialPageHeader.astro';

const { t } = useI18n();
const guidelines = [
  { icon: 'i-carbon:chat', label: t('guestbook.guide.open'), labelKey: 'guestbook.guide.open' },
  { icon: 'i-carbon:favorite', label: t('guestbook.guide.kind'), labelKey: 'guestbook.guide.kind' },
  { icon: 'i-carbon:locked', label: t('guestbook.guide.private'), labelKey: 'guestbook.guide.private' },
];
const fallbackLinks = getUserContactLinks()
  .filter((link) => link.kind !== 'website')
  .slice(0, 3);
---

<EditorialPageLayout title={t('page.title.guestbook')} description={t('guestbook.subtitle')} pageClass="guestbook-page">
  <EditorialPageHeader
    title={t('guestbook.title')}
    description={t('guestbook.subtitle')}
    titleKey="guestbook.title"
    descriptionKey="guestbook.subtitle"
    eyebrow={t('guestbook.eyebrow')}
    eyebrowKey="guestbook.eyebrow"
    icon="i-carbon:send-alt"
  />

  <div class="guestbook-flow" data-guestbook-flow>
    <aside
      class="guestbook-guidelines"
      aria-label={t('guestbook.guide.label')}
      data-i18n="guestbook.guide.label"
      data-i18n-attr="aria-label"
    >
      <ul>
        {guidelines.map((item) => (
          <li>
            <i class={item.icon} aria-hidden="true"></i>
            <span data-i18n={item.labelKey}>{item.label}</span>
          </li>
        ))}
      </ul>
    </aside>

    <Comments
      mode="guestbook"
      pageKey="/guestbook"
      pageTitle={t('guestbook.title')}
      description={t('guestbook.commentsDesc')}
      fallbackLinks={fallbackLinks}
    />
  </div>
</EditorialPageLayout>

<style>
  .guestbook-flow {
    width: min(100%, 52rem);
    margin-inline: auto;
  }

  .guestbook-guidelines {
    margin-bottom: 1.15rem;
    padding-block: 0.72rem;
    border-top: 1px solid rgba(var(--md-sys-color-outline-variant-rgb), 0.48);
    border-bottom: 1px solid rgba(var(--md-sys-color-outline-variant-rgb), 0.42);
  }

  .guestbook-guidelines ul {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .guestbook-guidelines li {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    min-width: 0;
    padding-inline: 0.8rem;
    border-left: 1px solid rgba(var(--md-sys-color-outline-variant-rgb), 0.36);
    color: var(--md-sys-color-on-surface-variant);
    font-family: var(--reay-font-metadata);
    font-size: 0.66rem;
    line-height: 1.4;
  }

  .guestbook-guidelines li:first-child { border-left: 0; }
  .guestbook-guidelines i { flex: 0 0 auto; color: var(--md-sys-color-primary); font-size: 0.78rem; }

  @media (max-width: 720px) {
    .guestbook-guidelines ul { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.6rem 0; }
    .guestbook-guidelines li { justify-content: flex-start; padding-inline: 0.55rem; border-left: 0; }
    .guestbook-guidelines li:nth-child(even) { border-left: 1px solid rgba(var(--md-sys-color-outline-variant-rgb), 0.36); }
    .guestbook-guidelines li:last-child { grid-column: 1 / -1; }
  }
</style>
