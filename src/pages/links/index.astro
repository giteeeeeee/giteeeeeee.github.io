---
/**
 * Links Index Page
 * Display all friendly links
 * 
 * Features:
 * - Group display by type (friends, sites, social)
 * - Avatar backdrop by default, screenshot preview on interaction
 * - Bounded responsive card grid
 * - Category filtering
 * - Responsive layout
 */
import LinksLayout from '@app/layouts/links/LinksLayout.astro';
import LinksCategoryTabs from '@features/links/components/LinksCategoryTabs.astro';
import LinkCard from '@features/links/components/LinkCard.astro';
import EditorialPageHeader from '@shared/components/EditorialPageHeader.astro';
import {
  getLinksConfig,
  getSiteProfile,
  getUserContactLinks,
  getUserProfile,
  getUserSocialLinks,
} from '@app/config/site.config';
import type { FriendLink } from '@app/config/links.config';
import type { TranslationKey } from '@app/config/i18n.config';
import { useI18n } from '@features/i18n/lib/i18n';

const { t, currentLang } = useI18n();
const { friendLinks, linkCategories, linkApplicationInfo } = getLinksConfig();
const user = getUserProfile();
const mySiteInfo = getSiteProfile(currentLang);
const contactLinks = getUserContactLinks();
const applicationDescriptionKey = linkApplicationInfo.description.startsWith('links.')
  ? linkApplicationInfo.description
  : undefined;
const applicationDescription = applicationDescriptionKey
  ? t(applicationDescriptionKey as TranslationKey)
  : linkApplicationInfo.description;

// Group by type
const friendsLinks = friendLinks.filter(link => link.type === 'friend');
const sitesLinks = friendLinks.filter(link => link.type === 'site');
const socialLinks: FriendLink[] = getUserSocialLinks().map((link) => ({
  name: link.label,
  url: link.href,
  avatar: user.avatar,
  description: link.value,
  category: 'all',
  type: 'social',
}));

// Calculate statistics
const totalLinks = friendLinks.length + socialLinks.length;
const featuredLinks = friendLinks.filter(link => link.featured).length;
const friendsCount = friendsLinks.length;
const sitesCount = sitesLinks.length;

// Calculate link count for each type category
function getLinkCounts(links: typeof friendLinks, categories: typeof linkCategories.friend) {
  const counts: Record<string, number> = {};
  categories.forEach(category => {
    if (category.id === 'all') {
      counts[category.id] = links.length;
    } else if (category.id === 'featured') {
      counts[category.id] = links.filter(l => l.featured).length;
    } else {
      counts[category.id] = links.filter(l => l.category === category.id).length;
    }
  });
  return counts;
}

const friendLinkCounts = getLinkCounts(friendsLinks, linkCategories.friend);
const siteLinkCounts = getLinkCounts(sitesLinks, linkCategories.site);
const socialLinkCounts = getLinkCounts(socialLinks, linkCategories.social);

const requiredFields = [
  { icon: 'i-carbon:badge', text: t('links.apply.field.name') },
  { icon: 'i-carbon:link', text: t('links.apply.field.url') },
  { icon: 'i-carbon:image', text: t('links.apply.field.avatar') },
  { icon: 'i-carbon:text-long-paragraph', text: t('links.apply.field.desc') },
];
const headerStats = [
  { icon: 'i-carbon:link', labelKey: 'links.totalLinks', label: t('links.totalLinks'), value: totalLinks },
  { icon: 'i-carbon:star-filled', labelKey: 'links.featured', label: t('links.featured'), value: featuredLinks },
  { icon: 'i-carbon:user-favorite', labelKey: 'links.friends', label: t('links.friends'), value: friendsCount },
  { icon: 'i-carbon:earth', labelKey: 'links.sites', label: t('links.sites'), value: sitesCount },
];

console.log(`📊 Loaded ${totalLinks} links: ${friendsLinks.length} friends, ${sitesLinks.length} sites, ${socialLinks.length} social`);
---

<LinksLayout>
  <EditorialPageHeader
    title={t('links.title')}
    description={t('links.subtitle')}
    titleKey="links.title"
    descriptionKey="links.subtitle"
    eyebrow={t('links.eyebrow')}
    eyebrowKey="links.eyebrow"
    icon="i-carbon:link"
    stats={headerStats}
  />

  <!-- Friend links -->
  {friendsLinks.length > 0 && (
    <section class="links-section">
      <div class="section-header">
        <h2 class="section-title">
          <i class="i-carbon:user-favorite"></i>
          <span data-i18n="links.friendLinks">{t('links.friendLinks')}</span>
        </h2>
        <p class="section-desc" data-i18n="links.friendLinks.desc">{t('links.friendLinks.desc')}</p>
      </div>

      <LinksCategoryTabs 
        categories={linkCategories.friend}
        linkCounts={friendLinkCounts}
        currentCategory="all"
        groupId="friend"
      />

      <div class="links-grid" data-group="friend">
        {friendsLinks.map((link) => (
          <LinkCard link={link} />
        ))}
      </div>
    </section>
  )}

  <!-- Site sharing -->
  {sitesLinks.length > 0 && (
    <section class="links-section">
      <div class="section-header">
        <h2 class="section-title">
          <i class="i-carbon:earth"></i>
          <span data-i18n="links.websites">{t('links.websites')}</span>
        </h2>
        <p class="section-desc" data-i18n="links.websites.desc">{t('links.websites.desc')}</p>
      </div>

      <LinksCategoryTabs 
        categories={linkCategories.site}
        linkCounts={siteLinkCounts}
        currentCategory="all"
        groupId="site"
      />

      <div class="links-grid" data-group="site">
        {sitesLinks.map((link) => (
          <LinkCard link={link} />
        ))}
      </div>
    </section>
  )}

  <!-- Personal social -->
  {socialLinks.length > 0 && (
    <section class="links-section">
      <div class="section-header">
        <h2 class="section-title">
          <i class="i-carbon:share"></i>
          <span data-i18n="links.social">{t('links.social')}</span>
        </h2>
        <p class="section-desc" data-i18n="links.social.desc">{t('links.social.desc')}</p>
      </div>

      <LinksCategoryTabs 
        categories={linkCategories.social}
        linkCounts={socialLinkCounts}
        currentCategory="all"
        groupId="social"
      />

      <div class="links-grid" data-group="social">
        {socialLinks.map((link) => (
          <LinkCard link={link} />
        ))}
      </div>
    </section>
  )}

  <!-- Apply for link exchange -->
  <div class="apply-section">
    <h2 class="apply-section-title">
      <i class="i-carbon:user-follow"></i>
      <span data-i18n="links.apply.title">{t('links.apply.title')}</span>
    </h2>
    
    <div class="apply-grid">
      <!-- Left: Application instructions -->
      <div class="apply-card">
        <div class="apply-card-header">
          <i class="i-carbon:document"></i>
          <h3 data-i18n="links.apply.requirements">{t('links.apply.requirements')}</h3>
        </div>
        <div class="apply-card-content">
          <p class="apply-intro" data-i18n={applicationDescriptionKey}>{applicationDescription}</p>

          <div class="requirements-list">
            <div class="requirement-item">
              <i class="i-carbon:checkmark-filled requirement-icon"></i>
              <div class="requirement-text">
                <strong data-i18n="links.apply.healthy.title">{t('links.apply.healthy.title')}</strong>
                <p data-i18n="links.apply.healthy.desc">{t('links.apply.healthy.desc')}</p>
              </div>
            </div>
            <div class="requirement-item">
              <i class="i-carbon:checkmark-filled requirement-icon"></i>
              <div class="requirement-text">
                <strong data-i18n="links.apply.accessible.title">{t('links.apply.accessible.title')}</strong>
                <p data-i18n="links.apply.accessible.desc">{t('links.apply.accessible.desc')}</p>
              </div>
            </div>
            <div class="requirement-item">
              <i class="i-carbon:checkmark-filled requirement-icon"></i>
              <div class="requirement-text">
                <strong data-i18n="links.apply.mutual.title">{t('links.apply.mutual.title')}</strong>
                <p data-i18n="links.apply.mutual.desc">{t('links.apply.mutual.desc')}</p>
              </div>
            </div>
          </div>

          <div class="fields-panel">
            <h4 data-i18n="links.apply.fields">{t('links.apply.fields')}</h4>
            <div class="fields-list">
              {requiredFields.map((field) => (
                <span class="field-chip">
                  <i class={field.icon}></i>
                  <span>{field.text}</span>
                </span>
              ))}
            </div>
          </div>

          {contactLinks.length > 0 && <div class="contact-section">
            <p class="contact-hint" data-i18n="links.apply.contactHint">{t('links.apply.contactHint')}</p>
            <div class="contact-buttons">
              {contactLinks.map((contact) => (
                <a
                  class="contact-button"
                  href={contact.href}
                  target={contact.external ? '_blank' : undefined}
                  rel={contact.external ? 'noopener noreferrer' : undefined}
                  data-contact={contact.value}
                  data-contact-kind={contact.kind}
                  aria-label={`${t('links.apply.contactOpen')} ${contact.label}`}
                >
                  <i class={contact.icon}></i>
                  <span>{contact.label}</span>
                </a>
              ))}
            </div>
          </div>}
        </div>
      </div>

      <!-- Right: Site information -->
      <div class="apply-card site-info-card">
        <div class="apply-card-header">
          <i class="i-carbon:information"></i>
          <h3 data-i18n="links.apply.siteInfo">{t('links.apply.siteInfo')}</h3>
        </div>
        <div class="apply-card-content">
          <div class="site-info">
            <div class="site-avatar-wrapper">
              <img src={mySiteInfo.avatar} alt={mySiteInfo.name} class="site-avatar" />
            </div>
            <div class="site-details">
              <div class="info-row" data-copy={mySiteInfo.name}>
                <div class="info-content">
                  <span class="info-label" data-i18n="links.apply.siteName">{t('links.apply.siteName')}</span>
                  <span class="info-value">{mySiteInfo.name}</span>
                </div>
                <button class="copy-btn" title={t('links.copy')} data-i18n="links.copy" data-i18n-attr="title">
                  <i class="i-carbon:copy"></i>
                </button>
              </div>
              {mySiteInfo.url && <div class="info-row" data-copy={mySiteInfo.url}>
                <div class="info-content">
                  <span class="info-label" data-i18n="links.apply.siteUrl">{t('links.apply.siteUrl')}</span>
                  <span class="info-value">{mySiteInfo.url}</span>
                </div>
                <button class="copy-btn" title={t('links.copy')} data-i18n="links.copy" data-i18n-attr="title">
                  <i class="i-carbon:copy"></i>
                </button>
              </div>}
              <div class="info-row" data-copy={mySiteInfo.description}>
                <div class="info-content">
                  <span class="info-label" data-i18n="links.apply.siteDesc">{t('links.apply.siteDesc')}</span>
                  <span class="info-value">{mySiteInfo.description}</span>
                </div>
                <button class="copy-btn" title={t('links.copy')} data-i18n="links.copy" data-i18n-attr="title">
                  <i class="i-carbon:copy"></i>
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</LinksLayout>

<style>
  /* Group sections */
  .links-section {
    margin-bottom: 3rem;
  }

  .section-header {
    margin-bottom: 1.25rem;
    padding-bottom: 0.7rem;
    border-bottom: 1px solid rgba(var(--md-sys-color-outline-variant-rgb), 0.44);
    text-align: left;
  }

  .section-title {
    display: inline-flex;
    align-items: center;
    justify-content: flex-start;
    gap: 0.5rem;
    font-size: 1.1rem;
    font-weight: 840;
    color: var(--md-sys-color-on-surface);
    margin: 0 0 0.375rem 0;
  }

  .section-title i {
    font-size: 1.25rem;
    color: var(--md-sys-color-primary);
  }

  .section-desc {
    font-size: 0.8125rem;
    color: var(--md-sys-color-on-surface-variant);
    margin: 0;
  }

  /* Links grid */
  .links-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 18.5rem), 1fr));
    gap: 0.9rem;
    margin-top: 0.15rem;
  }

  /* Apply for link exchange section */
  .apply-section {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid rgba(var(--md-sys-color-outline-variant-rgb), 0.48);
  }

  .apply-section-title {
    display: inline-flex;
    align-items: center;
    justify-content: flex-start;
    gap: 0.5rem;
    font-size: 1.1rem;
    font-weight: 840;
    color: var(--md-sys-color-on-surface);
    width: fit-content;
    margin: 0 0 1.25rem;
  }

  .apply-section-title i {
    font-size: 1.25rem;
    color: var(--md-sys-color-primary);
  }

  .apply-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0;
    border-top: 1px solid rgba(var(--md-sys-color-outline-variant-rgb), 0.46);
    border-bottom: 1px solid rgba(var(--md-sys-color-outline-variant-rgb), 0.46);
  }

  .apply-card {
    position: relative;
    background: rgba(var(--md-sys-color-surface-container-rgb), 0.26);
    border: 0;
    border-radius: 0;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    min-height: 340px;
    box-shadow: none;
  }

  .apply-card:first-child {
    border-right: 1px solid rgba(var(--md-sys-color-outline-variant-rgb), 0.42);
  }

  .apply-card::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    border-radius: inherit;
    background:
      linear-gradient(115deg, transparent 0%, rgba(var(--md-sys-color-surface-bright-rgb), 0.16) 42%, transparent 70%);
    display: none;
  }

  .apply-card-header {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 0.625rem;
    padding: 1.125rem 1.25rem;
    background: transparent;
    border-bottom: 1px solid rgba(var(--md-sys-color-outline-variant-rgb), 0.38);
  }

  .apply-card-header i {
    font-size: 1.25rem;
    color: var(--md-sys-color-on-primary-container);
  }

  .apply-card-header h3 {
    font-size: 1rem;
    font-weight: 700;
    color: var(--md-sys-color-on-primary-container);
    margin: 0;
  }

  .apply-card-content {
    position: relative;
    z-index: 1;
    padding: 1.25rem;
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .apply-intro {
    margin: 0 0 0.85rem;
    color: rgba(var(--md-sys-color-on-surface-variant-rgb), 0.92);
    font-size: 0.82rem;
    line-height: 1.6;
  }

  /* Application requirements list */
  .requirements-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-bottom: 0.85rem;
  }

  .requirement-item {
    display: flex;
    align-items: flex-start;
    gap: 0.625rem;
    padding: 0.54rem 0.72rem;
    background: rgba(var(--md-sys-color-surface-bright-rgb), 0.38);
    border-radius: 0.95rem;
    border: 1px solid rgba(var(--md-sys-color-outline-variant-rgb), 0.36);
    transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .requirement-item:hover {
    background: rgba(var(--md-sys-color-surface-bright-rgb), 0.8);
    border-color: var(--md-sys-color-primary);
    transform: translateX(4px);
  }

  .requirement-icon {
    flex-shrink: 0;
    width: 20px;
    height: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1rem;
    color: var(--md-sys-color-primary);
    background: var(--md-sys-color-primary-container);
    border-radius: 50%;
    padding: 0.25rem;
  }

  .requirement-text {
    flex: 1;
  }

  .requirement-text strong {
    display: block;
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--md-sys-color-on-surface);
    margin-bottom: 0.125rem;
  }

  .requirement-text p {
    font-size: 0.72rem;
    color: var(--md-sys-color-on-surface-variant);
    margin: 0;
    line-height: 1.4;
  }

  .fields-panel {
    margin-bottom: 0.85rem;
    padding: 0.72rem;
    border: 1px solid rgba(var(--md-sys-color-outline-variant-rgb), 0.36);
    border-radius: 1rem;
    background: rgba(var(--md-sys-color-surface-container-high-rgb), 0.34);
  }

  .fields-panel h4 {
    margin: 0 0 0.55rem;
    color: var(--md-sys-color-on-surface);
    font-size: 0.78rem;
    font-weight: 800;
  }

  .fields-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .field-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.38rem 0.56rem;
    border: 1px solid rgba(var(--md-sys-color-primary-rgb), 0.18);
    border-radius: 999px;
    background: rgba(var(--md-sys-color-primary-container-rgb), 0.34);
    color: var(--md-sys-color-on-primary-container);
    font-size: 0.72rem;
    font-weight: 700;
  }

  /* Contact section */
  .contact-section {
    margin-top: auto;
  }

  .contact-hint {
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--md-sys-color-on-surface);
    margin: 0 0 0.75rem 0;
  }

  .contact-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.625rem;
    margin-top: auto;
  }

  .contact-button {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.46rem 0.76rem;
    background:
      linear-gradient(135deg, rgba(var(--md-sys-color-secondary-container-rgb), 0.82), rgba(var(--md-sys-color-primary-container-rgb), 0.58));
    color: var(--md-sys-color-on-secondary-container);
    border: 1px solid rgba(var(--md-sys-color-outline-variant-rgb), 0.24);
    border-radius: 999px;
    font-size: 0.8125rem;
    font-weight: 600;
    cursor: pointer;
    text-decoration: none;
    transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow:
      0 12px 24px -20px rgba(var(--md-sys-color-shadow-rgb), 0.52),
      inset 0 1px 0 rgba(var(--md-sys-color-surface-bright-rgb), 0.18);
  }

  .contact-button:hover {
    background: var(--md-sys-color-secondary);
    color: var(--md-sys-color-on-secondary);
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(var(--md-sys-color-shadow-rgb), 0.12);
  }

  .contact-button:active {
    transform: translateY(0);
  }

  .contact-button.copied {
    background: rgba(var(--md-sys-color-primary-rgb), 0.88);
    color: var(--md-sys-color-on-primary);
  }

  .contact-button i {
    font-size: 0.9375rem;
  }

  /* Site info card */
  .site-info-card {
    background: linear-gradient(
      135deg,
      rgba(var(--md-sys-color-tertiary-container-rgb), 0.78) 0%,
      rgba(var(--md-sys-color-primary-container-rgb), 0.64) 100%
    );
    border-color: rgba(var(--md-sys-color-tertiary-rgb), 0.44);
  }

  .site-info-card .apply-card-header {
    background: linear-gradient(
      135deg,
      rgba(var(--md-sys-color-tertiary-container-rgb), 0.72) 0%,
      rgba(var(--md-sys-color-secondary-container-rgb), 0.58) 100%
    );
  }

  .site-info-card .apply-card-header i {
    color: var(--md-sys-color-on-tertiary-container);
  }

  .site-info-card .apply-card-header h3 {
    color: var(--md-sys-color-on-tertiary-container);
  }

  .site-info {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    flex: 1;
  }

  .site-avatar-wrapper {
    display: flex;
    justify-content: center;
    padding: 0.75rem 0;
  }

  .site-avatar {
    width: 72px;
    height: 72px;
    border-radius: 18px;
    object-fit: cover;
    box-shadow: 0 6px 18px rgba(var(--md-sys-color-shadow-rgb), 0.15);
    border: 2px solid var(--md-sys-color-surface);
  }

  .site-details {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    flex: 1;
  }

  .info-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.625rem;
    padding: 0.75rem 0.875rem;
    background: rgba(var(--md-sys-color-surface-bright-rgb), 0.5);
    border-radius: 10px;
    backdrop-filter: blur(8px);
    transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;
  }

  .info-row:hover {
    background: rgba(var(--md-sys-color-surface-bright-rgb), 0.8);
    box-shadow: 0 2px 8px rgba(var(--md-sys-color-shadow-rgb), 0.08);
  }

  .info-content {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    flex: 1;
    min-width: 0;
  }

  .info-label {
    font-size: 0.6875rem;
    font-weight: 700;
    color: var(--md-sys-color-on-tertiary-container);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    opacity: 0.8;
  }

  .info-value {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--md-sys-color-on-surface);
    word-break: break-word;
  }

  /* Copy button */
  .copy-btn {
    flex-shrink: 0;
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--md-sys-color-primary-container);
    color: var(--md-sys-color-on-primary-container);
    border: none;
    border-radius: 8px;
    cursor: pointer;
    transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    font-size: 1rem;
  }

  .copy-btn:hover {
    background: var(--md-sys-color-primary);
    color: var(--md-sys-color-on-primary);
    transform: scale(1.1);
  }

  .copy-btn:active {
    transform: scale(0.95);
  }

  .copy-btn.copied {
    background: var(--reay-color-success);
    color: white;
  }

  .copy-btn.copied i::before {
    content: '\f188'; /* checkmark icon code */
  }

  /* Responsive design */
  @media (max-width: 968px) {
    .apply-grid {
      grid-template-columns: 1fr;
    }

    .apply-card:first-child {
      border-right: 0;
      border-bottom: 1px solid rgba(var(--md-sys-color-outline-variant-rgb), 0.42);
    }
  }

  @media (max-width: 768px) {
    .links-section {
      margin-bottom: 2.5rem;
    }

    .section-title {
      font-size: 1.25rem;
    }

    .section-title i {
      font-size: 1.125rem;
    }

    .section-desc {
      font-size: 0.75rem;
    }

