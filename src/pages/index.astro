---
/**
 * Home Page
 * The signature Hero keeps its immersive viewport. Everything after it becomes
 * one asymmetric editorial composition while retaining snap compatibility.
 */
import FullscreenLayout from '@app/layouts/home/FullscreenLayout.astro';
import PageScrollContainer from '@shared/components/layout/PageScrollContainer.astro';
import FullPageSection from '@shared/components/layout/FullPageSection.astro';
import HeroSection from '@features/home/components/HeroSection.astro';
import ActivityStreamSection from '@features/home/components/ActivityStreamSection.astro';
import { getFeaturesConfig } from '@app/config/site.config';
import '@features/home/styles/editorial-home.css';

const features = getFeaturesConfig();
const sections = [
  { id: 'hero', label: 'Hero' },
  { id: 'activity', label: 'Activity' },
];
---

<FullscreenLayout title="Home">
  <PageScrollContainer sections={sections} mode={features.home.layout}>
    <!-- Section 1: Hero -->
    <FullPageSection sectionId="hero" viewportSized>
      <HeroSection />
    </FullPageSection>

    <!-- Profile snapshot, staggered content showcase, site pulse, and public activity. -->
    <FullPageSection sectionId="activity">
      <ActivityStreamSection />
    </FullPageSection>
  </PageScrollContainer>
</FullscreenLayout>
