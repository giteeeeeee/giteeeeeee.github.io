---
/**
 * Blog post detail page
 * Route: /blog/[...slug]
 */
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BlogPostLayout from '@app/layouts/blog/BlogPostLayout.astro';
import { getPostSlug, getPostsBySeries } from '@features/blog/lib/blog';
import { isPublishableContentVisible } from '@features/blog/lib/visibility';

// Generate static paths for all posts
export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => isPublishableContentVisible(data));
  
  return posts.map((post) => ({
    params: { slug: getPostSlug(post) },
    props: { post }
  }));
}

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const seriesPosts = post.data.series ? await getPostsBySeries(post.data.series) : [];

// Use render function to render Markdown content (Astro v5)
const { Content, headings, remarkPluginFrontmatter } = await render(post);
---

<BlogPostLayout 
  post={post} 
  headings={headings}
  readingTime={remarkPluginFrontmatter?.readingTime}
  readingMinutes={remarkPluginFrontmatter?.readingMinutes}
  seriesPosts={seriesPosts}
>
  <Content />
</BlogPostLayout>

<!-- Add KaTeX styles in head -->
<link 
  slot="head" 
  rel="stylesheet" 
  href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css" 
  integrity="sha384-n8MVd4RsNIU0tAv4ct0nTaAbDJwPJzDEaqSD1odI+WdtXRGWt2kTvGFasHpSy3SV" 
  crossorigin="anonymous"
/>
