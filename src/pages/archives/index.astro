---
import ArchiveLayout from '@app/layouts/archives/ArchiveLayout.astro';
import ArchiveExplorer from '@features/archives/components/ArchiveExplorer.astro';
import { getSortedPosts } from '@features/blog/lib/blog';
import { getPlogAlbums } from '@features/gallery/lib/plog';
import { useI18n } from '@features/i18n/lib/i18n';

const { t } = useI18n();
const [posts, plogAlbums] = await Promise.all([getSortedPosts(), getPlogAlbums()]);
const allDates = [
  ...posts.map((post) => post.data.publishDate),
  ...plogAlbums.map((album) => new Date(`${album.date}T00:00:00`)),
];
const totalYears = new Set(allDates.map((date) => date.getFullYear())).size;
const totalTopics = new Set([
  ...posts.flatMap((post) => post.data.tags),
  ...plogAlbums.flatMap((album) => album.tags),
]).size;
const headerStats = [
  { icon: 'i-carbon:pen-fountain', labelKey: 'archives.stats.blog', label: t('archives.stats.blog'), value: posts.length },
  { icon: 'i-carbon:image', labelKey: 'archives.stats.plog', label: t('archives.stats.plog'), value: plogAlbums.length },
  { icon: 'i-carbon:calendar', labelKey: 'archives.stats.years', label: t('archives.stats.years'), value: totalYears },
  { icon: 'i-carbon:tag-group', labelKey: 'archives.stats.topics', label: t('archives.stats.topics'), value: totalTopics },
];
---

<ArchiveLayout
  title={t('archives.title')}
  description={t('archives.subtitle')}
  titleKey="archives.title"
  descriptionKey="archives.subtitle"
  stats={headerStats}
>
  <ArchiveExplorer {posts} {plogAlbums} />
</ArchiveLayout>
