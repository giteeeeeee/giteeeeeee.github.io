---
import ArchiveLayout from '@app/layouts/archives/ArchiveLayout.astro';
import BlogTimeline from '@features/blog/components/BlogTimeline.astro';
import { decodeRouteParam, encodeRouteParam, getAllTags, getPostsByTag, getTagUrl } from '@features/blog/lib/blog';
import { useI18n } from '@features/i18n/lib/i18n';
import EditorialSectionHeader from '@shared/components/EditorialSectionHeader.astro';

export async function getStaticPaths() {
  const tags = await getAllTags();
  return tags.map(({ tag }) => ({ params: { tag: encodeRouteParam(tag) } }));
}

const tag = decodeRouteParam(Astro.params.tag);
const posts = await getPostsByTag(tag);
const allTags = await getAllTags();
const rank = allTags.findIndex((item) => item.tag === tag) + 1;
const relatedTagCounts = new Map<string, number>();
posts.forEach((post) => post.data.tags.forEach((item) => {
  if (item !== tag) relatedTagCounts.set(item, (relatedTagCounts.get(item) ?? 0) + 1);
}));
const relatedTags = [...relatedTagCounts.entries()]
  .sort((left, right) => right[1] - left[1])
  .slice(0, 6)
  .map(([name, count]) => ({ name, count }));
const { t } = useI18n();
const headerStats = [
  { icon: 'i-carbon:document', labelKey: 'archives.timeline.totalPosts', label: t('archives.timeline.totalPosts'), value: posts.length },
  { icon: 'i-carbon:trophy', labelKey: 'archives.series.rank', label: t('archives.series.rank'), value: rank > 0 ? `#${rank}` : '-' },
  { icon: 'i-carbon:connect', labelKey: 'archives.tags.related', label: t('archives.tags.related'), value: relatedTags.length },
];
---

<ArchiveLayout
  title={`#${tag}`}
  description={t('archives.tags.subtitle')}
  descriptionKey="archives.tags.subtitle"
  stats={headerStats}
>
  {relatedTags.length > 0 && (
    <section class="related-tags">
      <EditorialSectionHeader title={t('archives.tags.related')} titleKey="archives.tags.related" icon="i-carbon:connect" />
      <div>
        {relatedTags.map((item) => (
          <a href={getTagUrl(item.name)}><span>#{item.name}</span><small>{item.count}</small></a>
        ))}
      </div>
    </section>
  )}

  {posts.length > 0 ? (
    <section class="tag-posts">
      <EditorialSectionHeader title={t('archives.blogList')} titleKey="archives.blogList" icon="i-carbon:document" />
      <BlogTimeline {posts} />
    </section>
  ) : (
    <div class="archive-empty">
      <h2 data-i18n="archives.empty.posts.title">{t('archives.empty.posts.title')}</h2>
      <p data-i18n="archives.empty.posts.description">{t('archives.empty.posts.description')}</p>
    </div>
  )}
</ArchiveLayout>

<style>
  .related-tags { margin-bottom: 2.3rem; }
  .related-tags > div { display: flex; flex-wrap: wrap; gap: 0.55rem 1rem; }
  .related-tags a { display: inline-flex; align-items: baseline; gap: 0.35rem; padding: 0.32rem 0; color: var(--md-sys-color-on-surface); font-size: 0.76rem; font-weight: 760; }
  .related-tags a:hover { color: var(--md-sys-color-primary); }
  .related-tags small { color: var(--md-sys-color-on-surface-variant); font-family: var(--reay-font-metadata); font-size: 0.62rem; }
  .archive-empty { padding: 3rem 0; text-align: center; color: var(--md-sys-color-on-surface-variant); }
  .archive-empty h2 { margin: 0 0 0.35rem; color: var(--md-sys-color-on-surface); font-size: 1rem; }
  .archive-empty p { margin: 0; font-size: 0.78rem; }
</style>
