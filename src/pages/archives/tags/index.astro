---
import ArchiveLayout from '@app/layouts/archives/ArchiveLayout.astro';
import TagCloud from '@features/archives/components/TagCloud.astro';
import { getAllTags } from '@features/blog/lib/blog';
import { useI18n } from '@features/i18n/lib/i18n';
import EditorialSectionHeader from '@shared/components/EditorialSectionHeader.astro';

const allTags = await getAllTags();
const { t } = useI18n();
const headerStats = [
  { icon: 'i-carbon:tag', labelKey: 'archives.tags.total', label: t('archives.tags.total'), value: allTags.length },
  { icon: 'i-carbon:star-filled', labelKey: 'archives.tags.hottest', label: t('archives.tags.hottest'), value: allTags[0]?.tag ?? '-' },
  { icon: 'i-carbon:document', labelKey: 'archives.timeline.totalPosts', label: t('archives.timeline.totalPosts'), value: allTags.reduce((sum, tag) => sum + tag.count, 0) },
];
---

<ArchiveLayout
  title={t('archives.tags.title')}
  description={t('archives.tags.subtitle')}
  titleKey="archives.tags.title"
  descriptionKey="archives.tags.subtitle"
  stats={headerStats}
>
  {allTags.length > 0 ? (
    <div class="tag-page-flow">
      <section>
        <EditorialSectionHeader title={t('archives.topicMap')} titleKey="archives.topicMap" icon="i-carbon:tag-group" />
        <TagCloud tags={allTags} variant="map" />
      </section>
      <section>
        <EditorialSectionHeader title={t('archives.tags.list')} titleKey="archives.tags.list" icon="i-carbon:list" />
        <TagCloud tags={allTags} variant="index" />
      </section>
    </div>
  ) : (
    <div class="archive-empty">
      <i class="i-carbon:tag-none" aria-hidden="true"></i>
      <h2 data-i18n="archives.empty.tags.title">{t('archives.empty.tags.title')}</h2>
      <p data-i18n="archives.empty.tags.description">{t('archives.empty.tags.description')}</p>
    </div>
  )}
</ArchiveLayout>

<style>
  .tag-page-flow { display: grid; width: min(100%, 62rem); margin-inline: auto; gap: clamp(2.5rem, 6vw, 4rem); }
  .tag-page-flow > section { min-width: 0; }
  .archive-empty { padding: 3rem 0; text-align: center; color: var(--md-sys-color-on-surface-variant); }
  .archive-empty i { color: var(--md-sys-color-outline); font-size: 2rem; }
  .archive-empty h2 { margin: 0.7rem 0 0.35rem; color: var(--md-sys-color-on-surface); font-size: 1rem; }
  .archive-empty p { margin: 0; font-size: 0.78rem; }
</style>
