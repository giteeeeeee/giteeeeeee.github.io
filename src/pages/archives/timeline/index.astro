---
import ArchiveLayout from '@app/layouts/archives/ArchiveLayout.astro';
import ArchiveChronicle from '@features/archives/components/ArchiveChronicle.astro';
import { getPostsByYear } from '@features/blog/lib/blog';
import { useI18n } from '@features/i18n/lib/i18n';

const postsByYear = await getPostsByYear();
const posts = postsByYear.flatMap(([, yearPosts]) => yearPosts);
const { t } = useI18n();
const firstYear = postsByYear.at(-1)?.[0];
const latestYear = postsByYear[0]?.[0];
const timeRange = firstYear && latestYear
  ? (firstYear === latestYear ? String(firstYear) : `${firstYear}–${latestYear}`)
  : '-';
const headerStats = [
  { icon: 'i-carbon:calendar', labelKey: 'archives.timeline.yearsSpan', label: t('archives.timeline.yearsSpan'), value: postsByYear.length },
  { icon: 'i-carbon:document', labelKey: 'archives.timeline.totalPosts', label: t('archives.timeline.totalPosts'), value: posts.length },
  { icon: 'i-carbon:growth', labelKey: 'archives.timeline.averageOutput', label: t('archives.timeline.averageOutput'), value: postsByYear.length > 0 ? Math.round(posts.length / postsByYear.length) : 0 },
  { icon: 'i-carbon:time', labelKey: 'archives.timeline.timeRange', label: t('archives.timeline.timeRange'), value: timeRange },
];
---

<ArchiveLayout
  title={t('archives.timeline.title')}
  description={t('archives.timeline.subtitle')}
  titleKey="archives.timeline.title"
  descriptionKey="archives.timeline.subtitle"
  stats={headerStats}
>
  {postsByYear.length > 1 && (
    <nav class="year-jump" aria-label={t('archives.timeline.quickJump')}>
      <span><i class="i-carbon:location" aria-hidden="true"></i><span data-i18n="archives.timeline.quickJump">{t('archives.timeline.quickJump')}</span></span>
      {postsByYear.map(([year]) => <a href={`#archive-year-${year}`}>{year}</a>)}
    </nav>
  )}

  {posts.length > 0 ? (
    <ArchiveChronicle {posts} />
  ) : (
    <div class="archive-empty">
      <i class="i-carbon:document-blank" aria-hidden="true"></i>
      <h2 data-i18n="archives.empty.posts.title">{t('archives.empty.posts.title')}</h2>
      <p data-i18n="archives.empty.posts.description">{t('archives.empty.posts.description')}</p>
    </div>
  )}
</ArchiveLayout>

<style>
  .year-jump {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    margin: -0.45rem 0 2rem;
    padding-bottom: 0.7rem;
    overflow-x: auto;
    border-bottom: 1px solid rgba(var(--md-sys-color-outline-variant-rgb), 0.42);
  }
  .year-jump span, .year-jump a { flex: 0 0 auto; font-size: 0.7rem; }
  .year-jump > span { display: flex; align-items: center; gap: 0.35rem; color: var(--md-sys-color-on-surface-variant); font-weight: 760; }
  .year-jump a { color: var(--md-sys-color-primary); font-family: var(--reay-font-metadata); font-weight: 700; }
  .archive-empty { padding: 3rem 0; text-align: center; color: var(--md-sys-color-on-surface-variant); }
  .archive-empty i { color: var(--md-sys-color-outline); font-size: 2rem; }
  .archive-empty h2 { margin: 0.7rem 0 0.35rem; color: var(--md-sys-color-on-surface); font-size: 1rem; }
  .archive-empty p { margin: 0; font-size: 0.78rem; }
</style>
