---
import ArchiveLayout from '@app/layouts/archives/ArchiveLayout.astro';
import SeriesCard from '@features/archives/components/SeriesCard.astro';
import { getAllSeries } from '@features/blog/lib/blog';
import { useI18n } from '@features/i18n/lib/i18n';

const allSeries = await getAllSeries();
const { t } = useI18n();
const headerStats = [
  { icon: 'i-carbon:folder', labelKey: 'archives.series.total', label: t('archives.series.total'), value: allSeries.length },
  { icon: 'i-carbon:document', labelKey: 'archives.timeline.totalPosts', label: t('archives.timeline.totalPosts'), value: allSeries.reduce((sum, series) => sum + series.count, 0) },
];
---

<ArchiveLayout
  title={t('archives.series.title')}
  description={t('archives.series.subtitle')}
  titleKey="archives.series.title"
  descriptionKey="archives.series.subtitle"
  stats={headerStats}
>
  {allSeries.length > 0 ? (
    <div class="series-index" data-series-index>{allSeries.map((item) => <SeriesCard {...item} />)}</div>
  ) : (
    <div class="archive-empty">
      <i class="i-carbon:folder-off" aria-hidden="true"></i>
      <h2 data-i18n="archives.empty.series.title">{t('archives.empty.series.title')}</h2>
      <p data-i18n="archives.empty.series.description">{t('archives.empty.series.description')}</p>
    </div>
  )}
</ArchiveLayout>

<style>
  .series-index { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); width: min(100%, 70rem); margin-inline: auto; column-gap: clamp(1.2rem, 3vw, 2.2rem); }
  @media (max-width: 720px) { .series-index { grid-template-columns: 1fr; } }
  .archive-empty { padding: 3rem 0; text-align: center; color: var(--md-sys-color-on-surface-variant); }
  .archive-empty i { color: var(--md-sys-color-outline); font-size: 2rem; }
  .archive-empty h2 { margin: 0.7rem 0 0.35rem; color: var(--md-sys-color-on-surface); font-size: 1rem; }
  .archive-empty p { margin: 0; font-size: 0.78rem; }
</style>
