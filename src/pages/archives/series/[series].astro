---
import ArchiveLayout from '@app/layouts/archives/ArchiveLayout.astro';
import SeriesCard from '@features/archives/components/SeriesCard.astro';
import { calculateReadingTime, decodeRouteParam, encodeRouteParam, getAllSeries, getPostUrl, getPostsBySeries } from '@features/blog/lib/blog';
import { useI18n } from '@features/i18n/lib/i18n';
import EditorialSectionHeader from '@shared/components/EditorialSectionHeader.astro';

export async function getStaticPaths() {
  const series = await getAllSeries();
  return series.map(({ series: seriesName }) => ({ params: { series: encodeRouteParam(seriesName) } }));
}

const series = decodeRouteParam(Astro.params.series);
const posts = await getPostsBySeries(series);
const allSeries = await getAllSeries();
const rank = allSeries.findIndex((item) => item.series === series) + 1;
const latestDate = [...posts].sort(
  (left, right) => right.data.publishDate.getTime() - left.data.publishDate.getTime()
)[0]?.data.publishDate;
const otherSeries = allSeries.filter((item) => item.series !== series).slice(0, 3);
const { t } = useI18n();
const headerStats = [
  { icon: 'i-carbon:document', labelKey: 'archives.timeline.totalPosts', label: t('archives.timeline.totalPosts'), value: posts.length },
  { icon: 'i-carbon:trophy', labelKey: 'archives.series.rank', label: t('archives.series.rank'), value: rank > 0 ? `#${rank}` : '-' },
  {
    icon: 'i-carbon:recently-viewed',
    labelKey: 'blog.stats.updated',
    label: t('blog.stats.updated'),
    value: latestDate ? latestDate.toLocaleDateString('zh-CN') : '-',
    date: latestDate,
  },
];
---

<ArchiveLayout
  title={series}
  description={t('archives.series.subtitle')}
  descriptionKey="archives.series.subtitle"
  stats={headerStats}
>
  {posts.length > 0 ? (
    <section class="series-chapters">
      <EditorialSectionHeader title={t('archives.series.chapters')} titleKey="archives.series.chapters" icon="i-carbon:book" />
      <ol>
        {posts.map((post, index) => (
          <li>
            <a href={getPostUrl(post)} data-astro-prefetch="hover">
              <span class="chapter-number">{String(post.data.seriesOrder ?? index + 1).padStart(2, '0')}</span>
              <span class="chapter-copy">
                <h2>{post.data.title}</h2>
                {post.data.description && <p>{post.data.description}</p>}
                {post.data.tags.length > 0 && <small>{post.data.tags.slice(0, 3).map((tag) => `#${tag}`).join('  ')}</small>}
              </span>
              <span class="chapter-meta">
                <time
                  datetime={post.data.publishDate.toISOString()}
                  data-i18n-date={post.data.publishDate.toISOString()}
                  data-i18n-date-format="short"
                >
                  {post.data.publishDate.toLocaleDateString('zh-CN')}
                </time>
                <small>{calculateReadingTime(post.body)} <span data-i18n="blog.readTime">{t('blog.readTime')}</span></small>
              </span>
              <i class="i-carbon:arrow-up-right" aria-hidden="true"></i>
            </a>
          </li>
        ))}
      </ol>
    </section>
  ) : (
    <div class="archive-empty">
      <h2 data-i18n="archives.empty.series.title">{t('archives.empty.series.title')}</h2>
      <p data-i18n="archives.empty.series.description">{t('archives.empty.series.description')}</p>
    </div>
  )}

  {otherSeries.length > 0 && (
    <section class="other-series">
      <EditorialSectionHeader title={t('archives.series.other')} titleKey="archives.series.other" icon="i-carbon:folders" actionHref="/archives/series/" actionLabel={t('archives.viewAllSeries')} actionKey="archives.viewAllSeries" />
      <div>{otherSeries.map((item) => <SeriesCard {...item} />)}</div>
    </section>
  )}
</ArchiveLayout>

<style>
  .series-chapters ol { margin: 0; padding: 0; list-style: none; border-top: 1px solid rgba(var(--md-sys-color-outline-variant-rgb), 0.5); }
  .series-chapters li { border-bottom: 1px solid rgba(var(--md-sys-color-outline-variant-rgb), 0.44); }
  .series-chapters a { display: grid; grid-template-columns: 2.4rem minmax(0, 1fr) auto auto; align-items: start; gap: 1rem; padding: 1rem 0.6rem; color: inherit; }
  .series-chapters a:hover { padding-right: 0.35rem; padding-left: 0.85rem; background: linear-gradient(90deg, rgba(var(--md-sys-color-primary-rgb), 0.065), transparent 75%); }
  .chapter-number { padding-top: 0.1rem; color: var(--md-sys-color-primary); font-family: var(--reay-font-metadata); font-size: 0.72rem; font-weight: 680; }
  .chapter-copy { min-width: 0; }
  .chapter-copy h2 { margin: 0; color: var(--md-sys-color-on-surface); font-size: 0.98rem; font-weight: 720; line-height: 1.35; }
  .chapter-copy p { display: -webkit-box; margin: 0.3rem 0 0; overflow: hidden; -webkit-box-orient: vertical; -webkit-line-clamp: 2; color: var(--md-sys-color-on-surface-variant); font-size: 0.74rem; line-height: 1.5; }
  .chapter-copy small { display: block; margin-top: 0.35rem; color: var(--md-sys-color-on-surface-variant); font-size: 0.62rem; white-space: pre; }
  .chapter-meta { display: grid; gap: 0.25rem; justify-items: end; color: var(--md-sys-color-on-surface-variant); font-size: 0.66rem; white-space: nowrap; }
  .chapter-meta small { font-size: 0.62rem; }
  .series-chapters a > i { color: var(--md-sys-color-primary); font-size: 0.86rem; }
  .other-series { margin-top: clamp(2.5rem, 6vw, 4rem); }
  .other-series > div { max-width: 62rem; }
  .archive-empty { padding: 3rem 0; text-align: center; color: var(--md-sys-color-on-surface-variant); }
  .archive-empty h2 { margin: 0 0 0.35rem; color: var(--md-sys-color-on-surface); font-size: 1rem; }
  .archive-empty p { margin: 0; font-size: 0.78rem; }

  @media (max-width: 650px) {
    .series-chapters a { grid-template-columns: 2rem minmax(0, 1fr) auto; gap: 0.7rem; padding-right: 0; padding-left: 0; }
    .chapter-meta { grid-column: 2; justify-items: start; }
  }
</style>
