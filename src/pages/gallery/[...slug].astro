---
/**
 * Plog Album Detail Page
 * Shows every photo in one plog collection with metadata and download links.
 */
import DefaultLayout from '@app/layouts/base/DefaultLayout.astro';
import { createPlogAlbum, getAllPlogEntries, getPlogSlug } from '@features/gallery/lib/plog';
import { useI18n } from '@features/i18n/lib/i18n';
import { render, type CollectionEntry } from 'astro:content';
import { getImage } from 'astro:assets';

export async function getStaticPaths() {
  const entries = await getAllPlogEntries();

  return entries.map(entry => ({
    params: { slug: getPlogSlug(entry) },
    props: { entry, album: createPlogAlbum(entry) },
  }));
}

const { t } = useI18n();
const { album: sourceAlbum, entry } = Astro.props as {
  album: ReturnType<typeof createPlogAlbum>;
  entry: CollectionEntry<'plog'>;
};
const { Content } = await render(entry);
const baseUrl = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const optimizedImageCache = new Map<string, Promise<string>>();

function getOptimizedPlogImage(imageAsset: unknown, width: number, quality = 72) {
  if (!imageAsset || typeof imageAsset !== 'object' || !('src' in imageAsset)) {
    return Promise.resolve('');
  }

  const asset = imageAsset as Parameters<typeof getImage>[0]['src'];
  const cacheKey = `${(asset as { src?: string }).src ?? ''}:${width}:${quality}`;
  const cached = optimizedImageCache.get(cacheKey);

  if (cached) return cached;

  const request = getImage({
    src: asset,
    width,
    format: 'webp',
    quality,
  })
    .then(image => image.src)
    .catch(() => (asset as { src?: string }).src ?? '');

  optimizedImageCache.set(cacheKey, request);
  return request;
}

const optimizedPhotos = await Promise.all(sourceAlbum.photos.map(async (photo) => ({
  ...photo,
  thumbnailImage: await getOptimizedPlogImage(photo.imageAsset, 520, 64) || photo.image,
  previewImage: await getOptimizedPlogImage(photo.imageAsset, 1600, 74) || photo.image,
})));

const sourceFeaturedPhoto = sourceAlbum.photos.find(photo => photo.featured) ?? sourceAlbum.photos[0];
const optimizedHeroCover = await getOptimizedPlogImage(sourceAlbum.coverAsset ?? sourceFeaturedPhoto?.imageAsset, 1600, 74);
const album = {
  ...sourceAlbum,
  cover: optimizedHeroCover || sourceAlbum.cover,
  photos: optimizedPhotos,
};
const featuredPhoto = album.photos.find(photo => photo.featured) ?? album.photos[0];
const heroCover = album.cover || featuredPhoto?.image;
const photoPayload = JSON.stringify(album.photos.map(({ imageAsset: _imageAsset, thumbnailImage: _thumbnailImage, previewImage, ...photo }) => ({
  ...photo,
  image: previewImage || photo.image,
}))).replace(/</g, '\\u003c');
---

<DefaultLayout title={`${album.title} | ${t('page.title.gallery')}`} description={album.description}>
  <Fragment slot="head">
    <link rel="stylesheet" href={`${baseUrl}markdown.css`} />
  </Fragment>

  <div class="album-page">
    <a class="back-link" href="/gallery/" data-history-back>
      <i class="i-carbon:arrow-left"></i>
      <span data-i18n="navigation.back">{t('navigation.back')}</span>
    </a>

    <header class="moment-header" style={`--album-accent: ${album.accent};`}>
      <button
        class="moment-cover"
        type="button"
        data-photo-id={featuredPhoto?.id}
        aria-label={`${t('gallery.viewPhoto')}: ${featuredPhoto?.title ?? album.title}`}
      >
        {heroCover ? (
          <img src={heroCover} alt="" loading="eager" decoding="async" fetchpriority="high" sizes="(max-width: 760px) 100vw, 58vw" />
        ) : (
          <span class="image-fallback" style={`--fallback-bg: ${album.gradient};`}></span>
        )}
        <span class="cover-open"><i class="i-carbon:maximize" aria-hidden="true"></i></span>
      </button>

      <div class="moment-copy">
        <span class="page-eyebrow">
          <i class={album.icon}></i>
          <span data-i18n="gallery.moment">{t('gallery.moment')}</span>
        </span>
        <h1>{album.title}</h1>
        <p>{album.description}</p>
        <div class="album-meta">
          <span><i class="i-carbon:image"></i>{album.photoCount} {t('gallery.stats.photos')}</span>
          <span><i class="i-carbon:calendar"></i>{album.date}</span>
          {album.location && <span><i class="i-carbon:location"></i>{album.location}</span>}
          {album.camera && <span><i class="i-carbon:camera"></i>{album.camera}</span>}
        </div>
        <div class="tag-row">
          {album.tags.map(tag => <span>{tag}</span>)}
        </div>
        <div class="collection-note">
          <span data-i18n="gallery.collection">{t('gallery.collection')}</span>
          <strong>{album.collectionTitle}</strong>
          {album.collectionDescription && <small>{album.collectionDescription}</small>}
        </div>
      </div>
    </header>

    {entry.body?.trim() && (
      <section class="moment-narrative prose" aria-label={album.title} data-plog-prose>
        <Content />
      </section>
    )}

    <section class="photo-section">
      <div class="section-heading">
        <h2>
          <i class="i-carbon:view"></i>
          <span data-i18n="gallery.moments">{t('gallery.moments')}</span>
        </h2>
      </div>

      <ol class="photo-journal" aria-label={t('gallery.photos')}>
        {album.photos.map((photo, index) => {
          return (
            <li class="journal-entry" style={`--photo-accent: ${photo.accent};`}>
              <button
                class="photo-open"
                type="button"
                data-photo-id={photo.id}
                aria-label={`${t('gallery.viewPhoto')}: ${photo.title}`}
              >
                <span class="photo-visual" aria-hidden="true">
                  {photo.thumbnailImage || photo.image ? (
                    <img
                      src={photo.thumbnailImage || photo.image}
                      alt=""
                      loading="lazy"
                      decoding="async"
                      sizes="(max-width: 640px) 100vw, 33vw"
                    />
                  ) : (
                    <span class="image-fallback" style={`--fallback-bg: ${photo.gradient};`}></span>
                  )}
                </span>
                <span class="photo-number">{String(index + 1).padStart(2, '0')}</span>
                <span class="photo-overlay">
                  <i class="i-carbon:maximize"></i>
                </span>
              </button>
              <div class="photo-note">
                <span class="photo-kicker">{photo.date}{photo.location ? ` · ${photo.location}` : ''}</span>
                <div class="photo-heading">
                  <h3>{photo.title}</h3>
                  {photo.downloadUrl && (
                    <a
                      class="photo-download"
                      href={photo.downloadUrl}
                      download={photo.downloadName}
                      aria-label={`${t('gallery.download')}: ${photo.title}`}
                    >
                      <i class="i-carbon:download"></i>
                    </a>
                  )}
                </div>
                <p>{photo.caption}</p>
                <div class="photo-footnote">
                  {photo.camera && <span><i class="i-carbon:camera"></i>{photo.camera}</span>}
                  <span><i class="i-carbon:document"></i>{photo.fileName || photo.downloadName}</span>
                </div>
              </div>
            </li>
          );
        })}
      </ol>
    </section>
  </div>

  <div class="gallery-lightbox" id="gallery-lightbox" aria-hidden="true">
    <div class="lightbox-panel" role="dialog" aria-modal="true" aria-labelledby="lightbox-title">
      <button class="lightbox-close" type="button" data-lightbox-close aria-label={t('gallery.close')}>
        <i class="i-carbon:close"></i>
      </button>
      <button class="lightbox-nav prev" type="button" data-lightbox-prev aria-label={t('gallery.previous')}>
        <i class="i-carbon:chevron-left"></i>
      </button>
      <figure class="lightbox-visual">
        <img alt="" loading="lazy" decoding="async" data-lightbox-image />
        <span class="image-fallback lightbox-fallback" data-lightbox-fallback hidden></span>
      </figure>
      <div class="lightbox-content">
        <span class="lightbox-album">{album.collectionTitle}</span>
        <h2 id="lightbox-title" data-lightbox-title></h2>
        <p data-lightbox-caption></p>
        <p class="lightbox-signature" data-lightbox-signature></p>
        <div class="lightbox-meta">
          <span><i class="i-carbon:document"></i><span data-lightbox-file></span></span>
          <span><i class="i-carbon:calendar"></i><span data-lightbox-date></span></span>
          <span><i class="i-carbon:location"></i><span data-lightbox-location></span></span>
          <span><i class="i-carbon:camera"></i><span data-lightbox-camera></span></span>
        </div>
        <div class="lightbox-tags" data-lightbox-tags></div>
        <a class="lightbox-download" href="#" download data-lightbox-download>
          <i class="i-carbon:download"></i>
          <span data-i18n="gallery.download">{t('gallery.download')}</span>
        </a>
      </div>
      <button class="lightbox-nav next" type="button" data-lightbox-next aria-label={t('gallery.next')}>
        <i class="i-carbon:chevron-right"></i>
      </button>
    </div>
  </div>
</DefaultLayout>

<style>
  .album-page {
    padding: 1.65rem 0 4.5rem;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-bottom: 1rem;
    color: var(--md-sys-color-primary);
    font-size: 0.74rem;
    font-weight: 780;
    text-decoration: none;
  }

  .moment-header {
    display: grid;
    grid-template-columns: minmax(0, 1.18fr) minmax(17rem, 0.82fr);
    gap: clamp(1.5rem, 5vw, 4rem);
    align-items: center;
  }

  .moment-cover {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    padding: 0;
    border: 0;
    border-radius: 1.2rem;
    background: var(--md-sys-color-surface-container);
    cursor: zoom-in;
  }

  .moment-cover img,
  .photo-visual img,
  .image-fallback {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .image-fallback {
    position: relative;
    background: var(--fallback-bg);
  }

  .image-fallback::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 22% 18%, rgba(255, 255, 255, 0.28), transparent 35%);
  }

  .cover-open {
    position: absolute;
    right: 0.8rem;
    bottom: 0.8rem;
    display: grid;
    width: 2.35rem;
    height: 2.35rem;
    place-items: center;
    border: 1px solid rgba(255, 255, 255, 0.34);
    border-radius: 999px;
    background: rgba(var(--md-sys-color-shadow-rgb), 0.3);
    color: white;
  }

  .moment-copy {
    display: grid;
    gap: 0.75rem;
    min-width: 0;
  }

  .page-eyebrow,
  .album-meta,
  .lightbox-meta span,
  .lightbox-download,
  .photo-heading {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }

  .page-eyebrow {
    width: fit-content;
    color: var(--md-sys-color-primary);
    font-size: 0.68rem;
    font-weight: 850;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .moment-header h1 {
    margin: 0;
    color: var(--md-sys-color-on-surface);
    font-size: clamp(1.8rem, 4vw, 2.65rem);
    line-height: 1.06;
    font-weight: 920;
    letter-spacing: -0.025em;
  }

  .moment-copy > p {
    max-width: 37rem;
    margin: 0;
    color: var(--md-sys-color-on-surface-variant);
    font-size: 0.82rem;
    line-height: 1.7;
    font-family: var(--reay-font-prose);
  }

  .album-meta {
    flex-wrap: wrap;
    gap: 0.8rem;
    color: var(--md-sys-color-on-surface-variant);
    font-size: 0.7rem;
    font-weight: 750;
  }

  .tag-row,
  .lightbox-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .tag-row span,
  .lightbox-tags span {
    padding: 0.22rem 0.48rem;
    border-radius: 999px;
    background: rgba(var(--md-sys-color-primary-rgb), 0.1);
    color: var(--md-sys-color-primary);
    font-size: 0.64rem;
    font-weight: 750;
  }

  .collection-note {
    display: grid;
    gap: 0.18rem;
    margin-top: 0.25rem;
    padding: 0.8rem 0;
    border-top: 1px solid rgba(var(--md-sys-color-outline-variant-rgb), 0.44);
    border-bottom: 1px solid rgba(var(--md-sys-color-outline-variant-rgb), 0.44);
  }

  .collection-note > span { color: var(--md-sys-color-primary); font-size: 0.58rem; font-weight: 800; text-transform: uppercase; }
  .collection-note strong { color: var(--md-sys-color-on-surface); font-size: 0.76rem; }
  .collection-note small { color: var(--md-sys-color-on-surface-variant); font-size: 0.65rem; line-height: 1.45; }

  .photo-section {
    margin-top: clamp(3.5rem, 8vw, 6rem);
    content-visibility: auto;
    contain-intrinsic-size: auto 80rem;
  }

  :global(.moment-narrative) {
    width: min(100%, 48rem);
    margin: clamp(2rem, 5vw, 3.5rem) auto 0;
    padding: clamp(1rem, 3vw, 1.6rem) 0;
    border-top: 1px solid rgba(var(--md-sys-color-outline-variant-rgb), 0.44);
    border-bottom: 1px solid rgba(var(--md-sys-color-outline-variant-rgb), 0.44);
    font-family: var(--reay-font-prose);
  }

  .section-heading h2 {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    margin: 0 0 1.25rem;
    color: var(--md-sys-color-on-surface);
    font-size: 1.15rem;
    line-height: 1.2;
  }

  .photo-journal {
    display: grid;
    gap: clamp(3rem, 8vw, 6rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .journal-entry {
    display: grid;
    grid-template-columns: minmax(0, 1.22fr) minmax(15rem, 0.78fr);
    gap: clamp(1.25rem, 4vw, 3rem);
    align-items: center;
    content-visibility: auto;
    contain-intrinsic-size: auto 520px;
  }

  .journal-entry:nth-child(even) .photo-open { order: 2; }
  .journal-entry:nth-child(even) .photo-note { order: 1; padding-left: clamp(0rem, 4vw, 2rem); }

  .photo-note {
    min-width: 0;
  }

  .photo-open {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    border: 0;
    padding: 0;
    overflow: hidden;
    border-radius: 1.05rem;
    background: transparent;
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: zoom-in;
  }

  .photo-visual {
    position: absolute;
    inset: 0;
    transition: transform 0.46s ease;
  }

  .photo-open::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, transparent 0%, rgba(var(--md-sys-color-shadow-rgb), 0.18) 100%),
      radial-gradient(circle at 22% 18%, color-mix(in srgb, var(--photo-accent) 32%, transparent), transparent 34%);
    opacity: 0;
    transition: opacity 0.28s ease;
  }

  .journal-entry:hover .photo-visual {
    transform: scale(1.055);
  }

  .journal-entry:hover .photo-open::after,
  .journal-entry:hover .photo-overlay {
    opacity: 1;
  }

  .photo-overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: grid;
    place-items: center;
    color: white;
    font-size: 1.4rem;
    opacity: 0;
    transition: opacity 0.28s ease;
  }

  .photo-number {
    position: absolute;
    top: 0.75rem;
    left: 0.8rem;
    z-index: 2;
    color: white;
    font-family: var(--reay-font-metadata);
    font-size: 0.62rem;
  }

  .photo-overlay i {
    display: grid;
    place-items: center;
    width: 2.9rem;
    height: 2.9rem;
    border: 1px solid rgba(var(--md-sys-color-surface-bright-rgb), 0.34);
    border-radius: 999px;
    background: rgba(var(--md-sys-color-shadow-rgb), 0.34);
  }

  .photo-kicker {
    display: block;
    margin-bottom: 0.38rem;
    color: var(--md-sys-color-primary);
    font-size: 0.63rem;
    font-weight: 780;
  }

  .photo-heading {
    justify-content: space-between;
    gap: 0.75rem;
  }

  .photo-heading h3 {
    margin: 0;
    color: var(--md-sys-color-on-surface);
    font-size: 1.15rem;
    line-height: 1.25;
    font-weight: 850;
  }

  .photo-note > p {
    margin: 0.65rem 0 0;
    color: var(--md-sys-color-on-surface-variant);
    font-size: 0.76rem;
    line-height: 1.7;
    font-family: var(--reay-font-prose);
  }

  .photo-footnote { display: flex; flex-wrap: wrap; gap: 0.7rem; margin-top: 0.8rem; color: var(--md-sys-color-on-surface-variant); font-size: 0.61rem; }
  .photo-footnote span { display: inline-flex; align-items: center; gap: 0.3rem; }

  .photo-download {
    flex: 0 0 auto;
    display: grid;
    place-items: center;
    width: 2.1rem;
    height: 2.1rem;
    border: 1px solid rgba(var(--md-sys-color-outline-variant-rgb), 0.44);
    border-radius: 999px;
    background: rgba(var(--md-sys-color-surface-container-high-rgb, var(--md-sys-color-surface-container-rgb)), 0.76);
    color: var(--md-sys-color-primary);
    text-decoration: none;
    transition: transform 0.22s ease, background 0.22s ease;
  }

  .photo-download:hover {
    transform: translateY(-1px);
    background: rgba(var(--md-sys-color-primary-rgb), 0.12);
  }

  .gallery-lightbox {
    position: fixed;
    inset: 0;
    z-index: 80;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 1.25rem;
    background: rgba(var(--md-sys-color-shadow-rgb), 0.72);
    backdrop-filter: blur(8px);
  }

  .gallery-lightbox.is-open {
    display: flex;
  }

  .lightbox-panel {
    position: relative;
    width: min(100%, 1120px);
    max-height: min(90vh, 800px);
    display: grid;
    grid-template-columns: minmax(0, 1.42fr) minmax(280px, 0.7fr);
    overflow: hidden;
    border: 1px solid rgba(var(--md-sys-color-surface-bright-rgb), 0.18);
    border-radius: 1.15rem;
    background: var(--md-sys-color-surface);
    box-shadow: 0 36px 110px -28px rgba(var(--md-sys-color-shadow-rgb), 0.75);
  }

  .lightbox-visual {
    min-height: 36rem;
    display: grid;
    place-items: center;
    margin: 0;
    background: rgba(var(--md-sys-color-shadow-rgb), 0.92);
  }

  .lightbox-visual img {
    width: 100%;
    height: 100%;
    max-height: min(90vh, 800px);
    object-fit: contain;
  }

  .lightbox-fallback {
    display: block;
    width: 100%;
    height: 100%;
    min-height: inherit;
    background: var(--fallback-bg, linear-gradient(135deg, #46646d, #6d556f));
  }

  .lightbox-fallback[hidden] {
    display: none;
  }

  .lightbox-content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.78rem;
    padding: 1.45rem;
  }

  .lightbox-album {
    width: fit-content;
    padding: 0.35rem 0.65rem;
    border-radius: 999px;
    background: rgba(var(--md-sys-color-primary-rgb), 0.12);
    color: var(--md-sys-color-primary);
    font-size: 0.78rem;
    font-weight: 850;
  }

  .lightbox-content h2 {
    margin: 0;
    color: var(--md-sys-color-on-surface);
    font-size: clamp(1.55rem, 3vw, 2.3rem);
    line-height: 1.08;
  }

  .lightbox-content p {
    margin: 0;
    color: var(--md-sys-color-on-surface-variant);
    font-family: var(--reay-font-prose);
    line-height: 1.7;
  }

  .lightbox-signature {
    font-weight: 800;
  }

  .lightbox-meta {
    display: grid;
    gap: 0.55rem;
    color: var(--md-sys-color-on-surface-variant);
    font-size: 0.86rem;
  }

  .lightbox-tags span {
    background: rgba(var(--md-sys-color-primary-rgb), 0.12);
    color: var(--md-sys-color-primary);
  }

  .lightbox-download {
    width: fit-content;
    margin-top: 0.35rem;
    padding: 0.68rem 0.9rem;
    border-radius: 0.85rem;
    background: var(--md-sys-color-primary);
    color: var(--md-sys-color-on-primary);
    font-size: 0.86rem;
    font-weight: 850;
    text-decoration: none;
  }

  .lightbox-download[hidden] {
    display: none;
  }

  .lightbox-close,
  .lightbox-nav {
    position: absolute;
    z-index: 3;
    display: inline-grid;
    place-items: center;
    width: 2.45rem;
    height: 2.45rem;
    border: 1px solid rgba(var(--md-sys-color-surface-bright-rgb), 0.28);
    border-radius: 999px;
    background: rgba(var(--md-sys-color-shadow-rgb), 0.38);
    color: white;
    cursor: pointer;
    backdrop-filter: blur(8px);
    transition: background 0.22s ease;
  }

  .lightbox-close {
    top: 0.85rem;
    right: 0.85rem;
  }

  .lightbox-nav {
    top: 50%;
    transform: translateY(-50%);
  }

  .lightbox-nav.prev {
    left: 0.85rem;
  }

  .lightbox-nav.next {
    right: 0.85rem;
  }

  .lightbox-close:hover,
  .lightbox-nav:hover {
    background: rgba(var(--md-sys-color-shadow-rgb), 0.56);
  }

  @media (max-width: 920px) {
    .moment-header,
    .journal-entry,
    .lightbox-panel {
      grid-template-columns: 1fr;
    }

    .moment-cover { aspect-ratio: 16 / 10; }
    .journal-entry:nth-child(even) .photo-open,
    .journal-entry:nth-child(even) .photo-note { order: initial; }
    .journal-entry:nth-child(even) .photo-note { padding-left: 0; }

    .lightbox-visual {
      min-height: 24rem;
    }
  }

  @media (max-width: 640px) {
    .album-page {
      padding: 1.25rem 0 3rem;
    }

    .moment-header h1 { font-size: clamp(1.75rem, 9vw, 2.4rem); }
    .moment-cover, .photo-open { border-radius: 0.9rem; }

    .gallery-lightbox {
      padding: 0.75rem;
    }

    .lightbox-panel {
      max-height: 92vh;
      overflow-y: auto;
    }

    .lightbox-visual {
      min-height: 18rem;
    }

    .lightbox-nav {
      top: 9.5rem;
    }
  }
</style>

<script is:inline type="application/json" data-gallery-lightbox-config set:html={photoPayload}></script>
