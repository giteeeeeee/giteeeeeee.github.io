---
/** Plog index: collection-led photographic journal rather than repeated album cards. */
import EditorialPageLayout from '@app/layouts/base/EditorialPageLayout.astro';
import { createPlogCollections, getPlogGallery } from '@features/gallery/lib/plog';
import { useI18n } from '@features/i18n/lib/i18n';
import { getImage } from 'astro:assets';
import EditorialPageHeader from '@shared/components/EditorialPageHeader.astro';

const { t } = useI18n();
const sourceGallery = await getPlogGallery();
const optimizedImageCache = new Map<string, Promise<string>>();

function getOptimizedPlogImage(imageAsset: unknown, width: number, quality = 70) {
  if (!imageAsset || typeof imageAsset !== 'object' || !('src' in imageAsset)) return Promise.resolve('');
  const asset = imageAsset as Parameters<typeof getImage>[0]['src'];
  const cacheKey = `${(asset as { src?: string }).src ?? ''}:${width}:${quality}`;
  const cached = optimizedImageCache.get(cacheKey);
  if (cached) return cached;

  const request = getImage({ src: asset, width, format: 'webp', quality })
    .then((image) => image.src)
    .catch(() => (asset as { src?: string }).src ?? '');
  optimizedImageCache.set(cacheKey, request);
  return request;
}

const entries = await Promise.all(sourceGallery.albums.map(async (entry) => {
  const photos = await Promise.all(entry.photos.map(async (photo) => ({
    ...photo,
    thumbnailImage: await getOptimizedPlogImage(photo.imageAsset, 760, 68) || photo.image,
  })));
  return {
    ...entry,
    coverImage: await getOptimizedPlogImage(entry.coverAsset, 980, 70) || entry.cover,
    photos,
  };
}));
const collections = createPlogCollections(entries).map((collection) => ({
  ...collection,
  entries: collection.entries.map((entry) => entries.find((item) => item.id === entry.id)!),
}));
const featuredEntry = entries.find((entry) => entry.featured) ?? entries[0];
const leadMoments = featuredEntry ? [featuredEntry, ...entries.filter((entry) => entry.id !== featuredEntry.id)].slice(0, 3) : [];
const totalPlaces = new Set(entries.map((entry) => entry.location).filter(Boolean)).size;
const headerStats = [
  { icon: 'i-carbon:camera', labelKey: 'gallery.stats.entries', label: t('gallery.stats.entries'), value: entries.length },
  { icon: 'i-carbon:folders', labelKey: 'gallery.stats.collections', label: t('gallery.stats.collections'), value: collections.length },
  { icon: 'i-carbon:image', labelKey: 'gallery.stats.photos', label: t('gallery.stats.photos'), value: sourceGallery.photos.length },
  { icon: 'i-carbon:location', labelKey: 'gallery.stats.places', label: t('gallery.stats.places'), value: totalPlaces },
];
---

<EditorialPageLayout title={t('page.title.gallery')} description={t('gallery.subtitle')} pageClass="gallery-index-layout">
  <main class="plog-page" data-plog-index>
    <EditorialPageHeader
      title={t('gallery.title')}
      description={t('gallery.subtitle')}
      titleKey="gallery.title"
      descriptionKey="gallery.subtitle"
      eyebrow={t('gallery.eyebrow')}
      eyebrowKey="gallery.eyebrow"
      icon="i-carbon:camera"
      stats={headerStats}
    />

    {featuredEntry && (
      <section class="plog-lead" aria-labelledby="plog-lead-title">
        <div class="lead-collage" aria-hidden="true">
          {leadMoments.map((entry, index) => (
            <span class:list={['lead-frame', `lead-frame-${index + 1}`]}>
              {entry.coverImage || entry.cover ? (
                <img src={entry.coverImage || entry.cover} alt="" loading={index === 0 ? 'eager' : 'lazy'} decoding="async" />
              ) : (
                <span class="image-fallback" style={`--fallback-bg: ${entry.gradient};`}></span>
              )}
            </span>
          ))}
        </div>

        <div class="lead-copy">
          <p class="lead-kicker"><i class={featuredEntry.icon} aria-hidden="true"></i>{featuredEntry.collectionTitle}</p>
          <h2 id="plog-lead-title">{featuredEntry.title}</h2>
          <p>{featuredEntry.description}</p>
          <dl>
            <div><dt data-i18n="gallery.stats.photos">{t('gallery.stats.photos')}</dt><dd>{featuredEntry.photoCount}</dd></div>
            {featuredEntry.location && <div><dt data-i18n="gallery.stats.places">{t('gallery.stats.places')}</dt><dd>{featuredEntry.location}</dd></div>}
            <div><dt data-i18n="blog.info.published">{t('blog.info.published')}</dt><dd>{featuredEntry.date}</dd></div>
          </dl>
          <a href={featuredEntry.href}>
            <span data-i18n="gallery.viewPhoto">{t('gallery.viewPhoto')}</span>
            <i class="i-carbon:arrow-up-right" aria-hidden="true"></i>
          </a>
        </div>
      </section>
    )}

    <div class="plog-collections">
      {collections.map((collection, collectionIndex) => (
        <section class="plog-collection" data-plog-collection aria-labelledby={`collection-${collection.id}`}>
          <header class="collection-heading">
            <div>
              <p>{String(collectionIndex + 1).padStart(2, '0')} / {String(collections.length).padStart(2, '0')}</p>
              <h2 id={`collection-${collection.id}`}>{collection.title}</h2>
              {collection.description && <span>{collection.description}</span>}
            </div>
            <dl>
              <div><dt data-i18n="gallery.stats.entries">{t('gallery.stats.entries')}</dt><dd>{collection.entryCount}</dd></div>
              <div><dt data-i18n="gallery.stats.photos">{t('gallery.stats.photos')}</dt><dd>{collection.photoCount}</dd></div>
              <div><dt data-i18n="gallery.stats.places">{t('gallery.stats.places')}</dt><dd>{collection.locations.length}</dd></div>
            </dl>
          </header>

          <div class="moment-grid">
            {collection.entries.map((entry, index) => {
              const cover = entry.coverImage || entry.cover || entry.photos[0]?.thumbnailImage || entry.photos[0]?.image;
              return (
                <article class:list={['moment-entry', index === 0 && 'is-lead']}>
                  <a class="moment-visual" href={entry.href} aria-label={`${t('gallery.viewPhoto')}: ${entry.title}`}>
                    {cover ? (
                      <img src={cover} alt={entry.coverAlt ?? entry.title} loading="lazy" decoding="async" />
                    ) : (
                      <span class="image-fallback" style={`--fallback-bg: ${entry.gradient};`}></span>
                    )}
                    <span class="moment-index">{String(index + 1).padStart(2, '0')}</span>
                    <span class="moment-arrow"><i class="i-carbon:arrow-up-right" aria-hidden="true"></i></span>
                  </a>
                  <div class="moment-caption">
                    <div>
                      <p>{entry.collectionTitle} · {entry.date}</p>
                      <h3><a href={entry.href}>{entry.title}</a></h3>
                    </div>
                    {entry.description && <p class="moment-description">{entry.description}</p>}
                    <span class="moment-meta">
                      {entry.location && <span><i class="i-carbon:location" aria-hidden="true"></i>{entry.location}</span>}
                      {entry.camera && <span><i class="i-carbon:camera" aria-hidden="true"></i>{entry.camera}</span>}
                    </span>
                  </div>
                </article>
              );
            })}
          </div>
        </section>
      ))}
    </div>
  </main>
</EditorialPageLayout>

<style>
  .plog-page { min-width: 0; }

  .plog-lead {
    display: grid;
    grid-template-columns: minmax(0, 1.28fr) minmax(17rem, 0.72fr);
    gap: clamp(1.5rem, 4vw, 3.5rem);
    align-items: center;
    margin-bottom: clamp(3.5rem, 8vw, 6rem);
  }

  .lead-collage {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(6rem, 0.65fr);
    grid-template-rows: repeat(2, minmax(7.4rem, 1fr));
    gap: 0.65rem;
    min-height: clamp(20rem, 42vw, 29rem);
  }

  .lead-frame {
    position: relative;
    display: block;
    overflow: hidden;
    border-radius: 1.1rem;
    background: var(--md-sys-color-surface-container);
  }

  .lead-frame-1 { grid-row: 1 / 3; }
  .lead-frame img, .moment-visual img, .image-fallback { display: block; width: 100%; height: 100%; object-fit: cover; }
  .image-fallback { background: var(--fallback-bg); }
  .image-fallback::after { content: ''; position: absolute; inset: 0; background: radial-gradient(circle at 25% 18%, rgba(255,255,255,.26), transparent 34%); }

  .lead-copy { min-width: 0; }
  .lead-kicker { display: flex; align-items: center; gap: 0.45rem; margin: 0 0 0.55rem; color: var(--md-sys-color-primary); font-size: 0.7rem; font-weight: 850; letter-spacing: 0.06em; text-transform: uppercase; }
  .lead-copy h2 { margin: 0; color: var(--md-sys-color-on-surface); font-size: clamp(1.55rem, 3vw, 2.25rem); font-weight: 900; line-height: 1.08; }
  .lead-copy > p:not(.lead-kicker) { margin: 0.7rem 0 0; color: var(--md-sys-color-on-surface-variant); font-size: 0.82rem; line-height: 1.7; }
  .lead-copy dl { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); margin: 1.2rem 0; border-top: 1px solid rgba(var(--md-sys-color-outline-variant-rgb), 0.44); border-bottom: 1px solid rgba(var(--md-sys-color-outline-variant-rgb), 0.44); }
  .lead-copy dl > div { min-width: 0; padding: 0.72rem 0.55rem; border-left: 1px solid rgba(var(--md-sys-color-outline-variant-rgb), 0.36); }
  .lead-copy dl > div:first-child { padding-left: 0; border-left: 0; }
  .lead-copy dt { color: var(--md-sys-color-on-surface-variant); font-size: 0.58rem; text-transform: uppercase; }
  .lead-copy dd { margin: 0.22rem 0 0; overflow: hidden; color: var(--md-sys-color-on-surface); font-size: 0.72rem; font-weight: 820; text-overflow: ellipsis; white-space: nowrap; }
  .lead-copy > a { display: inline-flex; align-items: center; gap: 0.5rem; color: var(--md-sys-color-primary); font-size: 0.76rem; font-weight: 850; }

  .plog-collections { display: grid; gap: clamp(3.8rem, 9vw, 7rem); }
  .plog-collection { min-width: 0; }
  .collection-heading { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 2rem; align-items: end; margin-bottom: 1.15rem; padding-bottom: 0.9rem; border-bottom: 1px solid rgba(var(--md-sys-color-outline-variant-rgb), 0.46); }
  .collection-heading p { margin: 0 0 0.3rem; color: var(--md-sys-color-primary); font-family: var(--reay-font-metadata); font-size: 0.62rem; font-weight: 700; }
  .collection-heading h2 { margin: 0; color: var(--md-sys-color-on-surface); font-size: 1.25rem; font-weight: 880; }
  .collection-heading > div > span { display: block; margin-top: 0.35rem; color: var(--md-sys-color-on-surface-variant); font-size: 0.72rem; }
  .collection-heading dl { display: flex; margin: 0; }
  .collection-heading dl > div { padding: 0 0.7rem; border-left: 1px solid rgba(var(--md-sys-color-outline-variant-rgb), 0.42); }
  .collection-heading dt { color: var(--md-sys-color-on-surface-variant); font-size: 0.58rem; }
  .collection-heading dd { margin: 0.18rem 0 0; color: var(--md-sys-color-primary); font-size: 0.78rem; font-weight: 850; }

  .moment-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(1.2rem, 3vw, 2.2rem); }
  .moment-entry { min-width: 0; }
  .moment-visual { position: relative; display: block; aspect-ratio: 16 / 10; overflow: hidden; border-radius: 1rem; background: var(--md-sys-color-surface-container); }
  .moment-entry:nth-child(3n + 2) .moment-visual { aspect-ratio: 4 / 3; }
  .moment-visual img { transition: transform 0.42s ease; }
  .moment-visual::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, transparent 55%, rgba(var(--md-sys-color-shadow-rgb), 0.42)); opacity: 0.74; }
  .moment-entry:hover .moment-visual img { transform: scale(1.035); }
  .moment-index, .moment-arrow { position: absolute; z-index: 1; color: white; }
  .moment-index { top: 0.75rem; left: 0.8rem; font-family: var(--reay-font-metadata); font-size: 0.62rem; }
  .moment-arrow { right: 0.75rem; bottom: 0.7rem; display: grid; width: 2rem; height: 2rem; place-items: center; border: 1px solid rgba(255,255,255,.3); border-radius: 999px; background: rgba(var(--md-sys-color-shadow-rgb), .25); }
  .moment-caption { display: grid; grid-template-columns: minmax(0, .75fr) minmax(0, 1fr); gap: 1rem; margin-top: 0.75rem; }
  .moment-caption > div > p { margin: 0 0 0.2rem; color: var(--md-sys-color-primary); font-size: 0.61rem; font-weight: 780; }
  .moment-caption h3 { margin: 0; font-size: 0.98rem; font-weight: 850; line-height: 1.3; }
  .moment-caption h3 a { color: var(--md-sys-color-on-surface); }
  .moment-description { display: -webkit-box; margin: 0; overflow: hidden; -webkit-box-orient: vertical; -webkit-line-clamp: 2; color: var(--md-sys-color-on-surface-variant); font-size: 0.7rem; line-height: 1.5; }
  .moment-meta { grid-column: 1 / -1; display: flex; flex-wrap: wrap; gap: 0.7rem; color: var(--md-sys-color-on-surface-variant); font-size: 0.62rem; }
  .moment-meta span { display: inline-flex; align-items: center; gap: 0.3rem; }

  @media (max-width: 820px) {
    .plog-lead { grid-template-columns: 1fr; }
    .lead-collage { min-height: 22rem; }
  }

  @media (max-width: 640px) {
    .lead-collage { grid-template-columns: minmax(0, 1.4fr) minmax(5rem, .6fr); min-height: 17rem; }
    .collection-heading { grid-template-columns: 1fr; gap: 0.8rem; }
    .collection-heading dl > div:first-child { padding-left: 0; border-left: 0; }
    .moment-grid { grid-template-columns: 1fr; }
    .moment-caption { grid-template-columns: 1fr; gap: 0.35rem; }
    .moment-meta { grid-column: auto; }
  }

  @media (prefers-reduced-motion: reduce) {
    .moment-visual img { transition: none; }
  }
</style>
