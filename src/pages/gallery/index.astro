---
/**
 * Gallery Page
 * Content-driven plog album index.
 */
import DefaultLayout from '../../layouts/base/DefaultLayout.astro';
import { getPlogGallery } from '../../utils/plog';
import { useI18n } from '../../utils/i18n';
import { getImage } from 'astro:assets';

const { t } = useI18n();
const sourceGalleryConfig = await getPlogGallery();

const optimizedImageCache = new Map<string, Promise<string>>();

function getOptimizedPlogImage(imageAsset: unknown, width: number, quality = 72) {
  if (!imageAsset || typeof imageAsset !== 'object' || !('src' in imageAsset)) {
    return Promise.resolve('');
  }

  const asset = imageAsset as Parameters<typeof getImage>[0]['src'];
  const cacheKey = `${(asset as { src?: string }).src ?? ''}:${width}:${quality}`;
  const cached = optimizedImageCache.get(cacheKey);

  if (cached) return cached;

  const request = getImage({
    src: asset,
    width,
    format: 'webp',
    quality,
  })
    .then(image => image.src)
    .catch(() => (asset as { src?: string }).src ?? '');

  optimizedImageCache.set(cacheKey, request);
  return request;
}

const albums = await Promise.all(sourceGalleryConfig.albums.map(async (album) => {
  const photos = await Promise.all(album.photos.map(async (photo, index) => ({
    ...photo,
    thumbnailImage: await getOptimizedPlogImage(photo.imageAsset, index === 0 ? 720 : 320, 70) || photo.image,
  })));

  return {
    ...album,
    coverImage: await getOptimizedPlogImage(album.coverAsset, 960, 72) || album.cover,
    photos,
  };
}));

const galleryConfig = {
  ...sourceGalleryConfig,
  albums,
  photos: albums.flatMap(album => album.photos),
};
const featuredAlbum = galleryConfig.albums.find(album => album.featured) ?? galleryConfig.albums[0];
const totalTags = new Set(galleryConfig.albums.flatMap(album => album.tags)).size;
const featuredPhotos = featuredAlbum?.photos.slice(0, 5) ?? [];
---

<DefaultLayout title={t('page.title.gallery')} description={t('gallery.subtitle')}>
  <div class="gallery-page">
    <header class="gallery-header">
      <div class="header-content">
        <h1 class="page-title">
          <i class="i-carbon:image"></i>
          <span data-i18n="gallery.title">{t('gallery.title')}</span>
        </h1>
        <p class="page-subtitle" data-i18n="gallery.subtitle">
          {t('gallery.subtitle')}
        </p>
      </div>

      <div class="gallery-stats" aria-label={t('gallery.stats')}>
        <div class="stat-item reay-chip">
          <i class="i-carbon:image"></i>
          <span class="stat-value">{galleryConfig.photos.length}</span>
          <span class="stat-label" data-i18n="gallery.stats.photos">{t('gallery.stats.photos')}</span>
        </div>
        <div class="stat-item reay-chip">
          <i class="i-carbon:folder"></i>
          <span class="stat-value">{galleryConfig.albums.length}</span>
          <span class="stat-label" data-i18n="gallery.stats.albums">{t('gallery.stats.albums')}</span>
        </div>
        <div class="stat-item reay-chip">
          <i class="i-carbon:tag"></i>
          <span class="stat-value">{totalTags}</span>
          <span class="stat-label" data-i18n="gallery.stats.tags">{t('gallery.stats.tags')}</span>
        </div>
      </div>
    </header>

    {featuredAlbum && (
      <section class="featured-section" style={`--album-accent: ${featuredAlbum.accent};`}>
        <a class="featured-album" href={featuredAlbum.href} aria-label={`${t('gallery.viewAlbum')}: ${featuredAlbum.title}`}>
          <div class="featured-cover">
            {featuredAlbum.coverImage || featuredAlbum.cover ? (
              <img
                src={featuredAlbum.coverImage || featuredAlbum.cover}
                alt={featuredAlbum.coverAlt ?? featuredAlbum.title}
                loading="eager"
                decoding="async"
                fetchpriority="high"
                sizes="(max-width: 980px) 100vw, 720px"
              />
            ) : (
              <span class="image-fallback" style={`--fallback-bg: ${featuredAlbum.gradient};`}></span>
            )}
          </div>

          <div class="featured-content">
            <span class="featured-label" data-i18n="gallery.featuredAlbum">{t('gallery.featuredAlbum')}</span>
            <h2>{featuredAlbum.title}</h2>
            <p>{featuredAlbum.description}</p>
            <span class="featured-meta">
              <span><i class={featuredAlbum.icon}></i>{featuredAlbum.photoCount} {t('gallery.stats.photos')}</span>
              <span><i class="i-carbon:calendar"></i>{featuredAlbum.date}</span>
              <span><i class="i-carbon:location"></i>{featuredAlbum.location}</span>
            </span>
            <span class="featured-action">
              <span data-i18n="gallery.viewAlbum">{t('gallery.viewAlbum')}</span>
              <i class="i-carbon:arrow-right"></i>
            </span>
          </div>

          <div class="featured-strip" aria-hidden="true">
            {featuredPhotos.map(photo => (
              <span class="strip-frame">
                {photo.thumbnailImage || photo.image ? (
                  <img
                    src={photo.thumbnailImage || photo.image}
                    alt=""
                    loading="lazy"
                    decoding="async"
                    sizes="120px"
                  />
                ) : (
                  <span class="image-fallback" style={`--fallback-bg: ${photo.gradient};`}></span>
                )}
              </span>
            ))}
          </div>
        </a>
      </section>
    )}

    <section class="album-section">
      <div class="section-heading">
        <h2>
          <i class="i-carbon:folder"></i>
          <span data-i18n="gallery.collections">{t('gallery.collections')}</span>
        </h2>
      </div>

      <div class="album-grid" aria-label={t('gallery.collections')}>
        {galleryConfig.albums.map(album => {
          const previewPhotos = album.photos.slice(0, 4);
          const leadPhoto = previewPhotos[0];
          const cover = album.coverImage || album.cover || leadPhoto?.thumbnailImage || leadPhoto?.image;

          return (
            <a class="album-card" href={album.href} style={`--album-accent: ${album.accent};`}>
              <span class="album-media" aria-hidden="true">
                <span class="album-main-shot">
                  {cover ? (
                    <img
                      src={cover}
                      alt=""
                      loading="lazy"
                      decoding="async"
                      sizes="(max-width: 640px) 100vw, 420px"
                    />
                  ) : (
                    <span class="image-fallback" style={`--fallback-bg: ${album.gradient};`}></span>
                  )}
                </span>
                <span class="album-thumb-stack">
                  {previewPhotos.slice(1, 4).map(photo => (
                    <span class="album-thumb">
                      {photo.thumbnailImage || photo.image ? (
                        <img
                          src={photo.thumbnailImage || photo.image}
                          alt=""
                          loading="lazy"
                          decoding="async"
                          sizes="96px"
                        />
                      ) : (
                        <span class="image-fallback" style={`--fallback-bg: ${photo.gradient};`}></span>
                      )}
                    </span>
                  ))}
                </span>
              </span>

              <span class="album-card-content">
                <span class="album-label">
                  <i class={album.icon}></i>
                  {album.photoCount} {t('gallery.stats.photos')}
                </span>
                <span class="album-title">{album.title}</span>
                <span class="album-desc">{album.description}</span>
                <span class="album-meta">
                  <span>
                    <i class="i-carbon:calendar"></i>
                    {album.date}
                  </span>
                  <span>
                    <i class="i-carbon:location"></i>
                    {album.location}
                  </span>
                </span>
                <span class="tag-row">
                  {album.tags.slice(0, 4).map(tag => <span>{tag}</span>)}
                </span>
                <span class="view-album">
                  <span data-i18n="gallery.viewAlbum">{t('gallery.viewAlbum')}</span>
                  <i class="i-carbon:arrow-right"></i>
                </span>
              </span>
            </a>
          );
        })}
      </div>
    </section>
  </div>
</DefaultLayout>

<style>
  .gallery-page {
    padding: 2rem 0 4rem;
  }

  .gallery-header {
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--md-sys-color-outline-variant);
  }

  .header-content {
    margin-bottom: 1.25rem;
    text-align: center;
  }

  .page-title {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 0.5rem 0;
    color: var(--md-sys-color-on-surface);
    font-size: 1.75rem;
    font-weight: 600;
    line-height: 1.2;
  }

  .page-title i {
    color: var(--md-sys-color-primary);
    font-size: 1.5rem;
  }

  .page-subtitle {
    margin: 0;
    color: var(--md-sys-color-on-surface-variant);
    font-size: 0.875rem;
    opacity: 0.9;
  }

  .gallery-stats {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 2rem;
  }

  .stat-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    border: 1px solid var(--reay-button-border);
    border-radius: 999px;
    background: rgba(var(--md-sys-color-surface-container-rgb), 0.5);
    transition:
      background 0.2s cubic-bezier(0.4, 0, 0.2, 1),
      border-color 0.2s cubic-bezier(0.4, 0, 0.2, 1),
      box-shadow 0.2s cubic-bezier(0.4, 0, 0.2, 1),
      transform 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  }

  :root[data-theme="light"] .stat-item,
  :root:not([data-theme]) .stat-item {
    box-shadow:
      0 1px 4px -1px rgba(0, 0, 0, 0.1),
      inset 0 0.5px 0 rgba(255, 255, 255, 0.3);
  }

  :root[data-theme="dark"] .stat-item {
    box-shadow:
      0 1px 4px -1px rgba(0, 0, 0, 0.4),
      inset 0 0.5px 0 rgba(255, 255, 255, 0.05);
  }

  .stat-item:hover {
    border-color: rgba(var(--md-sys-color-primary-rgb), 0.44);
    background: var(--reay-button-bg-hover);
    transform: translateY(-1px) scale(1.02);
  }

  :root[data-theme="light"] .stat-item:hover,
  :root:not([data-theme]) .stat-item:hover {
    box-shadow:
      0 4px 12px -2px rgba(0, 0, 0, 0.15),
      inset 0 0.5px 0 rgba(255, 255, 255, 0.5);
  }

  :root[data-theme="dark"] .stat-item:hover {
    box-shadow:
      0 4px 12px -2px rgba(0, 0, 0, 0.6),
      inset 0 0.5px 0 rgba(255, 255, 255, 0.1);
  }

  .stat-item i {
    color: var(--md-sys-color-primary);
    font-size: 1.125rem;
  }

  .stat-value {
    color: var(--md-sys-color-on-surface);
    font-size: 1.125rem;
    font-weight: 700;
  }

  .stat-label {
    color: var(--md-sys-color-on-surface-variant);
    font-size: 0.8125rem;
  }

  .featured-section {
    margin-bottom: 2rem;
    content-visibility: auto;
    contain-intrinsic-size: auto 32rem;
  }

  .featured-album {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(280px, 0.78fr);
    min-height: 28rem;
    overflow: hidden;
    border: 1px solid rgba(var(--md-sys-color-outline-variant-rgb), 0.36);
    border-radius: 1.25rem;
    background: var(--md-sys-color-surface-container);
    color: inherit;
    text-decoration: none;
    box-shadow: 0 30px 90px -54px rgba(0, 0, 0, 0.72);
    isolation: isolate;
  }

  .featured-cover {
    position: relative;
    min-height: 28rem;
    overflow: hidden;
    background: rgba(var(--md-sys-color-surface-container-high-rgb, var(--md-sys-color-surface-container-rgb)), 0.74);
  }

  .featured-cover::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, transparent 0%, rgba(0, 0, 0, 0.12) 68%, rgba(0, 0, 0, 0.5) 100%),
      radial-gradient(circle at 18% 18%, color-mix(in srgb, var(--album-accent) 28%, transparent), transparent 32%);
    pointer-events: none;
  }

  .featured-cover img,
  .album-main-shot img,
  .album-thumb img,
  .strip-frame img,
  .image-fallback {
    display: block;
    width: 100%;
    height: 100%;
  }

  .featured-cover img,
  .album-main-shot img,
  .album-thumb img,
  .strip-frame img {
    object-fit: cover;
    transition: transform 0.48s ease;
  }

  .featured-album:hover .featured-cover img,
  .album-card:hover .album-main-shot img {
    transform: scale(1.045);
  }

  .image-fallback {
    background: var(--fallback-bg);
  }

  .featured-content {
    position: relative;
    z-index: 2;
    align-self: end;
    display: grid;
    gap: 0.72rem;
    padding: clamp(1.2rem, 4vw, 2rem);
    background:
      linear-gradient(135deg, color-mix(in srgb, var(--album-accent) 14%, transparent), transparent 56%),
      rgba(var(--md-sys-color-surface-rgb), 0.88);
    backdrop-filter: blur(20px);
  }

  .featured-label,
  .album-label {
    display: inline-flex;
    align-items: center;
    gap: 0.42rem;
    width: fit-content;
    border-radius: 999px;
    font-size: 0.76rem;
    font-weight: 850;
  }

  .featured-label {
    padding: 0.35rem 0.7rem;
    background: rgba(var(--md-sys-color-primary-rgb), 0.12);
    color: var(--md-sys-color-primary);
  }

  .featured-content h2 {
    margin: 0;
    color: var(--md-sys-color-on-surface);
    font-size: clamp(2rem, 5vw, 3.6rem);
    line-height: 1;
    font-weight: 950;
    letter-spacing: 0;
  }

  .featured-content p {
    margin: 0;
    color: var(--md-sys-color-on-surface-variant);
    line-height: 1.7;
  }

  .featured-meta,
  .featured-action,
  .album-meta,
  .view-album {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }

  .featured-meta {
    flex-wrap: wrap;
    gap: 0.75rem;
    color: var(--md-sys-color-on-surface-variant);
    font-size: 0.85rem;
    font-weight: 760;
  }

  .featured-meta span {
    display: inline-flex;
    align-items: center;
    gap: 0.38rem;
  }

  .featured-action {
    width: fit-content;
    margin-top: 0.4rem;
    padding: 0.7rem 0.9rem;
    border-radius: 999px;
    background: var(--md-sys-color-primary);
    color: var(--md-sys-color-on-primary);
    font-size: 0.86rem;
    font-weight: 850;
  }

  .featured-strip {
    position: absolute;
    right: 1rem;
    bottom: 1rem;
    left: 1rem;
    z-index: 3;
    display: flex;
    gap: 0.55rem;
    max-width: calc(58% - 2rem);
    pointer-events: none;
  }

  .strip-frame {
    flex: 0 0 5.6rem;
    height: 4.2rem;
    overflow: hidden;
    border: 2px solid rgba(255, 255, 255, 0.7);
    border-radius: 0.75rem;
    background: rgba(0, 0, 0, 0.18);
    box-shadow: 0 12px 32px -18px rgba(0, 0, 0, 0.86);
  }

  .album-section {
    margin-top: 1.5rem;
    content-visibility: auto;
    contain-intrinsic-size: auto 42rem;
  }

  .section-heading h2 {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    margin: 0 0 1rem;
    color: var(--md-sys-color-on-surface);
    font-size: 1.35rem;
    line-height: 1.2;
  }

  .album-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .album-card {
    display: grid;
    grid-template-rows: minmax(14rem, 1fr) auto;
    overflow: hidden;
    border: 1px solid rgba(var(--md-sys-color-outline-variant-rgb), 0.36);
    border-radius: 1rem;
    background: rgba(var(--md-sys-color-surface-container-rgb), 0.7);
    color: inherit;
    text-decoration: none;
    box-shadow: 0 18px 54px -44px rgba(0, 0, 0, 0.62);
    contain: layout paint style;
    transition: transform 0.28s ease, box-shadow 0.28s ease, border-color 0.28s ease;
  }

  .album-card:hover {
    transform: translateY(-3px);
    border-color: color-mix(in srgb, var(--album-accent) 55%, transparent);
    box-shadow: 0 28px 74px -42px rgba(0, 0, 0, 0.7);
  }

  .album-media {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(4.6rem, 0.36fr);
    gap: 0.4rem;
    min-height: 14rem;
    padding: 0.5rem;
  }

  .album-main-shot,
  .album-thumb {
    overflow: hidden;
    border-radius: 0.72rem;
    background: rgba(var(--md-sys-color-surface-container-high-rgb, var(--md-sys-color-surface-container-rgb)), 0.78);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.14);
  }

  .album-thumb-stack {
    display: grid;
    gap: 0.4rem;
  }

  .album-card-content {
    display: grid;
    gap: 0.58rem;
    padding: 1rem;
  }

  .album-label {
    padding: 0.32rem 0.6rem;
    background: rgba(var(--md-sys-color-primary-rgb), 0.1);
    color: var(--md-sys-color-primary);
  }

  .album-title {
    color: var(--md-sys-color-on-surface);
    font-size: 1.18rem;
    line-height: 1.2;
    font-weight: 900;
  }

  .album-desc {
    display: -webkit-box;
    min-height: 2.7rem;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    color: var(--md-sys-color-on-surface-variant);
    font-size: 0.86rem;
    line-height: 1.55;
  }

  .album-meta {
    flex-wrap: wrap;
    gap: 0.7rem;
    color: var(--md-sys-color-on-surface-variant);
    font-size: 0.78rem;
  }

  .tag-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .tag-row span {
    padding: 0.22rem 0.48rem;
    border-radius: 999px;
    background: rgba(var(--md-sys-color-primary-rgb), 0.1);
    color: var(--md-sys-color-primary);
    font-size: 0.72rem;
    font-weight: 750;
  }

  .view-album {
    width: fit-content;
    margin-top: 0.1rem;
    color: var(--md-sys-color-primary);
    font-size: 0.82rem;
    font-weight: 850;
  }

  @media (max-width: 980px) {
    .featured-album {
      grid-template-columns: 1fr;
    }

    .featured-cover {
      min-height: 24rem;
    }

    .featured-strip {
      max-width: calc(100% - 2rem);
    }

    .album-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .gallery-page {
      padding: 1.25rem 0 3rem;
    }

    .page-title {
      font-size: 1.5rem;
    }

    .page-title i {
      font-size: 1.25rem;
    }

    .page-subtitle {
      font-size: 0.8125rem;
    }

    .gallery-stats {
      gap: 1rem;
    }

    .stat-item {
      padding: 0.375rem 0.875rem;
    }

    .album-grid {
      grid-template-columns: 1fr;
    }

    .featured-cover {
      min-height: 20rem;
    }

    .featured-strip {
      display: none;
    }
  }
</style>
