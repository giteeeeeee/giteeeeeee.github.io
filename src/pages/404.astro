---
import EditorialPageLayout from '@app/layouts/base/EditorialPageLayout.astro';
import { useI18n } from '@features/i18n/lib/i18n';

const { t } = useI18n();
---

<EditorialPageLayout title={t('notFound.title')} description={t('notFound.description')} pageClass="not-found-page">
  <section class="not-found" aria-labelledby="not-found-title" data-page-title-key="notFound.title">
    <div class="not-found-number" aria-hidden="true">404</div>
    <div class="not-found-copy">
      <p class="not-found-eyebrow" data-i18n="notFound.eyebrow">{t('notFound.eyebrow')}</p>
      <h1 id="not-found-title" data-i18n="notFound.title">{t('notFound.title')}</h1>
      <p data-i18n="notFound.description">{t('notFound.description')}</p>
      <div class="not-found-actions">
        <a href="/" class="primary"><span data-i18n="notFound.home">{t('notFound.home')}</span><i class="i-carbon:arrow-right" aria-hidden="true"></i></a>
        <a href="/archives/" data-i18n="notFound.archives">{t('notFound.archives')}</a>
      </div>
    </div>
  </section>
</EditorialPageLayout>

<style>
  .not-found { display: grid; grid-template-columns: minmax(12rem, 0.75fr) minmax(0, 1.25fr); align-items: center; gap: clamp(2rem, 7vw, 6rem); min-height: min(64vh, 34rem); border-top: 1px solid rgba(var(--md-sys-color-outline-variant-rgb), 0.5); border-bottom: 1px solid rgba(var(--md-sys-color-outline-variant-rgb), 0.44); }
  .not-found-number { color: var(--md-sys-color-primary); font-size: clamp(5rem, 14vw, 9rem); font-weight: 920; line-height: 0.82; letter-spacing: -0.08em; opacity: 0.78; }
  .not-found-eyebrow { margin: 0 0 0.55rem; color: var(--md-sys-color-primary); font-size: 0.68rem; font-weight: 820; letter-spacing: 0.1em; text-transform: uppercase; }
  .not-found h1 { margin: 0; color: var(--md-sys-color-on-surface); font-size: clamp(1.7rem, 4vw, 2.55rem); font-weight: 900; line-height: 1.08; letter-spacing: -0.035em; }
  .not-found-copy > p:last-of-type { max-width: 34rem; margin: 0.75rem 0 0; color: var(--md-sys-color-on-surface-variant); font-size: 0.85rem; line-height: 1.65; }
  .not-found-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 0.8rem 1.2rem; margin-top: 1.4rem; }
  .not-found-actions a { display: inline-flex; align-items: center; gap: 0.4rem; color: var(--md-sys-color-primary); font-size: 0.74rem; font-weight: 780; }
  .not-found-actions a.primary { padding: 0.55rem 0.8rem; color: var(--md-sys-color-on-primary); background: var(--md-sys-color-primary); border-radius: 0.72rem; }
  @media (max-width: 650px) { .not-found { grid-template-columns: 1fr; align-content: center; gap: 1.5rem; } .not-found-number { font-size: 5.5rem; } }
</style>
