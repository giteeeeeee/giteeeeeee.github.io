---
/**
 * Header Component
 * 
 * Responsive navigation header with:
 * - Mobile: Logo + hamburger menu → Drawer-style dropdown
 * - Desktop: Horizontal navigation bar
 * - Glass morphism effect with floating hover animations
 */
import { getFeaturesConfig, getNavigationConfig, getUserProfile } from '@app/config/site.config';
import LanguageToggle from '@features/i18n/components/LanguageToggle.astro';
import { useI18n } from '@features/i18n/lib/i18n';
import ThemeToggle from './ThemeToggle.astro';
import SearchButton from './SearchButton.astro';
import type { NavigationItem } from '@app/config/navigation.config';

const { t } = useI18n();
const user = getUserProfile();
const navigation = getNavigationConfig();
const features = getFeaturesConfig();
const MusicDock = features.integrations.music
  ? (await import('@features/media/components/MusicDock.astro')).default
  : null;
const links: Array<NavigationItem & { label: string }> = navigation.primary.map((item) => ({
  ...item,
  label: t(item.key),
}));

const normalizePath = (path: string) => path === '/' ? '/' : path.replace(/\/+$/, '');
const currentPath = normalizePath(Astro.url.pathname);
const isActive = (href: string) => {
  const normalizedHref = normalizePath(href);
  return normalizedHref === '/'
    ? currentPath === '/'
    : currentPath === normalizedHref || currentPath.startsWith(`${normalizedHref}/`);
};
---
<header class="site-header sticky top-0 z-20" data-floating-header>
  <div class="site-header-inner mx-auto max-w-1100px px-4 sm:px-6 h-16 flex items-center justify-between gap-4">
    <!-- Brand with avatar -->
    <a 
      href="/" 
      class="brand-link text-lg sm:text-xl font-800 text-[var(--md-sys-color-primary)] flex items-center gap-2.5"
      aria-label={`${user.name} Home`}
    >
      <span class="brand-avatar-wrap">
        <img 
          src={user.avatar}
          alt={user.name}
          width="32"
          height="32"
          decoding="async"
          class="brand-avatar w-8 h-8 rounded-full object-cover"
        />
      </span>
      <span class="hidden sm:inline">{user.name}</span>
    </a>

    <!-- Desktop nav with pill-style links and glass morphism -->
    <nav class="hidden lg:flex items-center gap-1.5 text-[var(--md-sys-color-on-surface-variant)]">
      {links.map(l => (
        <a 
          href={l.href} 
          data-astro-prefetch={l.prefetch === 'idle' ? 'load' : 'hover'}
          class:list={[
            'nav-link px-3 py-2 text-sm font-600',
            isActive(l.href) && 'is-active'
          ]}
          aria-current={isActive(l.href) ? 'page' : undefined}
        >
          <span data-i18n={l.key}>{l.label}</span>
        </a>
      ))}
    </nav>

    <!-- Header controls group -->
    <div class="header-actions flex items-center gap-2">
      {features.search.showInNavigation && <SearchButton />}
      {features.i18n.showLanguageSwitcher && <LanguageToggle />}
      <ThemeToggle />
      {MusicDock && <MusicDock />}
      <slot />
      <button
        id="menu-btn"
        class="menu-button lg:hidden inline-flex items-center justify-center w-9 h-9"
        aria-label={t('nav.openMenu')}
        title={t('nav.openMenu')}
        aria-controls="mobile-menu"
        aria-expanded="false"
        data-i18n="nav.openMenu"
        data-i18n-attrs="aria-label,title"
      >
        <i class="i-carbon:menu text-[1.25rem] text-[var(--md-sys-color-on-surface)]"></i>
      </button>
    </div>
  </div>

  <!-- Mobile menu with glass morphism -->
  <div id="mobile-menu" class="mobile-menu lg:hidden hidden">
    <nav class="mx-auto max-w-1100px px-4 sm:px-6 py-4 grid gap-1 text-[var(--md-sys-color-on-surface)]">
      {links.map(l => (
        <a 
          href={l.href} 
          data-astro-prefetch={l.prefetch === 'idle' ? 'load' : 'hover'}
          class:list={[
            'mobile-nav-link px-4 py-2.5 text-sm font-600',
            isActive(l.href) && 'is-active'
          ]}
          aria-current={isActive(l.href) ? 'page' : undefined}
        >
          <span data-i18n={l.key}>{l.label}</span>
        </a>
      ))}
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 80;
    height: 4rem;
    padding: 0;
    background:
      linear-gradient(135deg, rgba(var(--md-sys-color-surface-rgb), 0.72), rgba(var(--md-sys-color-surface-container-rgb), 0.46)),
      linear-gradient(90deg, rgba(var(--md-sys-color-primary-rgb), 0.12), rgba(var(--md-sys-color-tertiary-rgb), 0.1));
    border-bottom: 1px solid rgba(var(--md-sys-color-outline-variant-rgb), 0.24);
    box-shadow:
      0 18px 48px -40px rgba(var(--md-sys-color-shadow-rgb), 0.62),
      inset 0 1px 0 rgba(var(--md-sys-color-surface-bright-rgb), 0.28);
    backdrop-filter: blur(14px) saturate(145%);
    -webkit-backdrop-filter: blur(14px) saturate(145%);
    transform: translateZ(0);
    backface-visibility: hidden;
    contain: layout style;
    overflow: visible;
    isolation: isolate;
    transition:
      background 0.24s var(--reay-ease-out, ease),
      border-color 0.24s var(--reay-ease-out, ease),
      box-shadow 0.24s var(--reay-ease-out, ease),
      backdrop-filter 0.24s var(--reay-ease-out, ease);
  }

  .site-header-inner {
    position: relative;
    height: 4rem;
    isolation: isolate;
    transform: translate3d(0, 0, 0);
    transform-origin: center;
  }

  .site-header-inner > nav,
  .header-actions {
    transition:
      gap 0.28s var(--reay-ease-smooth, ease),
      transform 0.32s var(--reay-ease-smooth, ease);
  }

  .site-header-inner > nav {
    transform-origin: center;
  }

  .header-actions {
    transform-origin: right center;
  }

  .header-actions :global(.header-tool-button),
  .menu-button {
    position: relative;
    display: inline-grid;
    place-items: center;
    width: 2.35rem;
    height: 2.35rem;
    padding: 0;
    flex: 0 0 auto;
    border: 1px solid var(--reay-button-border);
    border-radius: var(--reay-icon-button-radius, 0.95rem);
    background: var(--reay-button-bg);
    color: var(--md-sys-color-on-surface);
    box-shadow: var(--reay-button-shadow);
    cursor: pointer;
    backdrop-filter: blur(10px) saturate(135%);
    -webkit-backdrop-filter: blur(10px) saturate(135%);
    transition:
      width 0.28s var(--reay-ease-smooth, ease),
      height 0.28s var(--reay-ease-smooth, ease),
      color 0.24s var(--reay-ease-out, ease),
      background 0.24s var(--reay-ease-out, ease),
      border-color 0.24s var(--reay-ease-out, ease),
      border-radius 0.28s var(--reay-ease-smooth, ease),
      box-shadow 0.24s var(--reay-ease-out, ease),
      transform 0.24s var(--reay-ease-out, ease);
  }

  @media (min-width: 1024px) {
    .menu-button {
      display: none;
    }
  }

  .header-actions :global(.header-tool-button:hover),
  .header-actions :global(.header-tool-button:focus-visible),
  .menu-button:hover,
  .menu-button:focus-visible {
    color: var(--md-sys-color-primary);
    border-color: rgba(var(--md-sys-color-primary-rgb), 0.48);
    background: var(--reay-button-bg-hover);
    transform: translateY(-1px);
    box-shadow: var(--reay-button-shadow-hover);
  }

  .header-actions :global(.header-tool-button i),
  .menu-button i {
    font-size: 1.1rem;
    transition: font-size 0.28s var(--reay-ease-smooth, ease), transform 0.24s var(--reay-ease-out, ease);
  }

  .site-header-inner::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    border: 1px solid transparent;
    border-radius: 0;
    background: transparent;
    box-shadow: none;
    transform: translateZ(0);
    transition:
      inset 0.28s var(--reay-ease-smooth, ease),
      border-color 0.24s var(--reay-ease-out, ease),
      border-radius 0.28s var(--reay-ease-smooth, ease),
      background 0.24s var(--reay-ease-out, ease),
      box-shadow 0.24s var(--reay-ease-out, ease);
  }

  .site-header-inner > * {
    position: relative;
    z-index: 1;
  }

  .site-header.is-floating {
    background: transparent;
    border-bottom-color: transparent;
    box-shadow: none;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
  }

  .site-header.is-floating .site-header-inner::before {
    inset: 0.52rem 0.9rem;
    border-color: rgba(var(--md-sys-color-outline-variant-rgb), 0.52);
    border-radius: var(--reay-radius-pill);
    background:
      linear-gradient(135deg, rgba(var(--md-sys-color-surface-rgb), 0.88), rgba(var(--md-sys-color-surface-container-rgb), 0.68)),
      linear-gradient(100deg, rgba(var(--md-sys-color-primary-rgb), 0.18), rgba(var(--md-sys-color-tertiary-rgb), 0.13));
    box-shadow:
      0 20px 46px -24px rgba(var(--md-sys-color-shadow-rgb), 0.82),
      0 10px 26px -28px rgba(var(--md-sys-color-primary-rgb), 0.92),
      0 0 0 1px rgba(var(--md-sys-color-surface-bright-rgb), 0.22) inset,
      0 0 32px -18px rgba(var(--md-sys-color-primary-rgb), 0.9);
    backdrop-filter: blur(18px) saturate(160%);
    -webkit-backdrop-filter: blur(18px) saturate(160%);
  }

  .site-header.is-floating .brand-link {
    transform: scale(0.94);
  }

  .site-header.is-floating .site-header-inner > nav {
    gap: 0.3rem;
    transform: scale(0.94);
  }

  .site-header.is-floating .header-actions {
    gap: 0.35rem;
  }

  .site-header::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--md-sys-color-primary), var(--md-sys-color-tertiary), transparent);
    opacity: 0.48;
    transform: scaleX(0.72);
    transform-origin: center;
    transition: opacity 0.35s ease, transform 0.35s var(--reay-ease-out, ease);
  }

  .site-header:hover::after {
    opacity: 0.72;
    transform: scaleX(1);
  }

  .site-header.is-floating::after {
    opacity: 0;
    transform: scaleX(0.36);
  }

  .brand-link {
    position: relative;
    font-family: var(--reay-font-brand);
    transform-origin: left center;
    transition: transform 0.35s var(--reay-ease-spring, ease);
  }

  .site-header nav {
    font-family: var(--reay-font-navigation);
  }

  .brand-link:hover {
    transform: translateY(-1px) scale(1.03);
    color: var(--md-sys-color-primary);
  }

  .site-header.is-floating .brand-link:hover {
    transform: translateY(-1px) scale(0.98);
  }

  .brand-avatar-wrap {
    position: relative;
    display: inline-grid;
    place-items: center;
    width: 2.35rem;
    height: 2.35rem;
    border-radius: 999px;
    background: conic-gradient(from 180deg, var(--md-sys-color-primary), var(--md-sys-color-tertiary), var(--reay-color-warning), var(--md-sys-color-primary));
    box-shadow:
      0 0 0 1px rgba(var(--md-sys-color-primary-rgb), 0.2),
      0 12px 28px -20px rgba(var(--md-sys-color-primary-rgb), 0.65);
    transition: transform 0.35s var(--reay-ease-spring, ease), box-shadow 0.35s ease;
  }

  .brand-link:hover .brand-avatar-wrap {
    transform: rotate(6deg) scale(1.04);
    box-shadow:
      0 0 0 1px rgba(var(--md-sys-color-primary-rgb), 0.34),
      0 16px 38px -22px rgba(var(--md-sys-color-primary-rgb), 0.82);
  }

  .brand-avatar {
    width: 2rem;
    height: 2rem;
    border: 2px solid rgba(var(--md-sys-color-surface-rgb), 0.82);
  }

  .nav-link,
  .mobile-nav-link {
    position: relative;
    border-radius: var(--reay-radius-pill);
    border: 1px solid transparent;
    transition:
      color 0.3s var(--reay-ease-out, ease),
      background 0.3s var(--reay-ease-out, ease),
      border-color 0.3s var(--reay-ease-out, ease),
      box-shadow 0.3s var(--reay-ease-out, ease),
      transform 0.3s var(--reay-ease-out, ease);
  }

  .nav-link {
    overflow: hidden;
  }

  .site-header.is-floating .nav-link {
    padding: 0.42rem 0.68rem;
    font-size: 0.8rem;
  }

  .nav-link::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background:
      linear-gradient(135deg, rgba(var(--md-sys-color-primary-rgb), 0.2), rgba(var(--md-sys-color-tertiary-rgb), 0.13)),
      linear-gradient(110deg, transparent, rgba(var(--md-sys-color-surface-bright-rgb), 0.2), transparent);
    background-size: auto, 220% 100%;
    background-position: 0 0, -120% 0;
    opacity: 0;
    transition: opacity 0.3s ease, background-position 0.58s var(--reay-ease-out, ease);
  }

  .nav-link::after {
    content: '';
    position: absolute;
    left: 20%;
    right: 20%;
    bottom: 0.35rem;
    height: 2px;
    border-radius: 999px;
    background: linear-gradient(90deg, var(--md-sys-color-primary), var(--md-sys-color-tertiary));
    transform: scaleX(0);
    transform-origin: center;
    transition: transform 0.3s var(--reay-ease-out, ease);
  }

  .nav-link:hover,
  .nav-link.is-active {
    color: var(--md-sys-color-primary);
    transform: translateY(-1px);
    border-color: rgba(var(--md-sys-color-primary-rgb), 0.22);
    box-shadow:
      0 14px 34px -24px rgba(var(--md-sys-color-primary-rgb), 0.68),
      inset 0 1px 0 rgba(var(--md-sys-color-surface-bright-rgb), 0.18);
  }

  .nav-link:hover::before,
  .nav-link.is-active::before {
    opacity: 1;
    background-position: 0 0, 120% 0;
  }

  .nav-link:hover::after,
  .nav-link.is-active::after {
    transform: scaleX(1);
  }

  .site-header.is-floating .header-actions :global(.theme-toggle),
  .site-header.is-floating .header-actions :global(.music-dock),
  .site-header.is-floating .header-actions :global(.dock-trigger),
  .site-header.is-floating .header-actions :global(.lang-toggle),
  .site-header.is-floating .menu-button {
    width: 2rem;
    height: 2rem;
    border-radius: 0.78rem;
  }

  .site-header.is-floating .header-actions :global(.lang-label) {
    right: 0.16rem;
    bottom: 0.12rem;
    transform: scale(0.88);
    transform-origin: right bottom;
  }

  .site-header.is-floating .header-actions :global(.theme-toggle i),
  .site-header.is-floating .header-actions :global(.dock-trigger i),
  .site-header.is-floating .header-actions :global(.lang-toggle i),
  .site-header.is-floating .menu-button i {
    font-size: 1.05rem;
  }

  .mobile-menu {
    background:
      linear-gradient(135deg, rgba(var(--md-sys-color-surface-rgb), 0.92), rgba(var(--md-sys-color-surface-container-rgb), 0.72));
    border-top: 1px solid rgba(var(--md-sys-color-outline-variant-rgb), 0.32);
    border-radius: 0 0 var(--reay-radius-lg, 1.35rem) var(--reay-radius-lg, 1.35rem);
    box-shadow: 0 18px 45px -30px rgba(var(--md-sys-color-shadow-rgb), 0.55);
    backdrop-filter: blur(14px) saturate(145%);
    -webkit-backdrop-filter: blur(14px) saturate(145%);
  }

  .site-header.is-floating .mobile-menu {
    max-width: min(1100px, calc(100vw - 1.5rem));
    margin: 0.75rem auto 0;
    border: 1px solid rgba(var(--md-sys-color-outline-variant-rgb), 0.38);
    border-radius: var(--reay-radius-lg, 1.35rem);
    overflow: hidden;
    box-shadow: 0 20px 48px -30px rgba(var(--md-sys-color-shadow-rgb), 0.68);
  }

  .mobile-nav-link {
    border: 1px solid transparent;
  }

  .mobile-nav-link:hover,
  .mobile-nav-link.is-active {
    color: var(--md-sys-color-primary);
    background: rgba(var(--md-sys-color-primary-container-rgb), 0.35);
    border-color: rgba(var(--md-sys-color-primary-rgb), 0.18);
    transform: translateX(4px);
  }

  @media (max-width: 640px) {
    .site-header.is-floating .site-header-inner::before {
      inset: 0.56rem 0.5rem;
      border-radius: 1.4rem;
    }

    .site-header.is-floating .brand-link {
      transform: scale(0.92);
    }

    .site-header.is-floating .header-actions {
      gap: 0.28rem;
    }

    .site-header.is-floating .mobile-menu {
      max-width: calc(100vw - 1rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header,
    .site-header-inner,
    .site-header::after {
      transition-duration: 0.01ms;
    }
  }
</style>
