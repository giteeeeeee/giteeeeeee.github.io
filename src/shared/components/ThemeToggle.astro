---
/**
 * ThemeToggle.astro
 * 精致圆润风格主题切换按钮：light / dark / system
 * 更小巧、更优雅的图标按钮
 */
import { useI18n } from '@features/i18n/lib/i18n';

const { t } = useI18n();
---
<button
  class="header-tool-button theme-toggle"
  aria-label={t('theme.toggle.system')}
  title={t('theme.toggle.system')}
  data-i18n="theme.toggle.system"
  data-i18n-attrs="aria-label,title"
  data-theme-toggle>
  <i class="theme-icon i-carbon:sun" data-theme-icon></i>
</button>

<style>
  .theme-toggle {
    display: inline-grid;
    place-items: center;
    width: 2.35rem;
    height: 2.35rem;
    padding: 0;
    border-radius: var(--reay-icon-button-radius, 0.95rem);
    border: 1px solid var(--reay-button-border, rgba(var(--md-sys-color-outline-variant-rgb), 0.36));
    background: var(--reay-button-bg, rgba(var(--md-sys-color-surface-container-rgb), 0.52));
    color: var(--md-sys-color-on-surface);
    box-shadow: var(--reay-button-shadow, inset 0 1px 0 rgba(var(--md-sys-color-surface-bright-rgb), 0.16));
    backdrop-filter: blur(16px) saturate(150%);
    -webkit-backdrop-filter: blur(16px) saturate(150%);
    transition: transform 0.25s var(--reay-ease-out, ease), background 0.25s ease, color 0.25s ease, box-shadow 0.25s ease;
  }

  .theme-toggle i {
    font-size: 1.1rem;
    transition: transform 0.3s var(--reay-ease-out, ease);
  }

  .theme-toggle:hover {
    color: var(--md-sys-color-primary);
    border-color: rgba(var(--md-sys-color-primary-rgb), 0.48);
    background: var(--reay-button-bg-hover, rgba(var(--md-sys-color-primary-container-rgb), 0.42));
    transform: translateY(-1px);
    box-shadow: var(--reay-button-shadow-hover, 0 16px 32px -22px rgba(var(--md-sys-color-primary-rgb), 0.8));
  }
</style>
