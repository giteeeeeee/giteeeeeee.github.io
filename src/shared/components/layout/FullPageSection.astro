---
/**
 * FullpageSection.astro
 * 全屏滚动的单个区块组件
 */
interface Props {
  sectionId: string;
  /** Only the Hero keeps a viewport-sized frame in normal flow mode. */
  viewportSized?: boolean;
}

const { sectionId, viewportSized = false } = Astro.props;
---

<div
  class="fullpage-section"
  data-section={sectionId}
  data-viewport-sized={viewportSized ? 'true' : undefined}
>
  <slot />
</div>

<style>
  .fullpage-section {
    height: 100%;
    width: 100%;
    position: absolute;
    inset: 0;
    transform: translate3d(0, 100%, 0);
    transition: none;
    will-change: auto;
    backface-visibility: hidden;
    contain: layout paint;
    overflow-y: hidden;
    overflow-x: hidden;
    overscroll-behavior: contain;
    scroll-behavior: auto;
  }

  .fullpage-section:first-of-type {
    transform: translate3d(0, 0, 0);
  }

  .fullpage-section[data-active='false'] * {
    animation-play-state: paused !important;
  }

  .fullpage-section[data-ready='true'] {
    transition: transform var(--reay-fullpage-duration, 560ms) cubic-bezier(0.18, 0.86, 0.22, 1);
  }

  :global([data-home-layout='flow']) .fullpage-section {
    position: relative;
    inset: auto;
    height: auto;
    min-height: 0;
    transform: none;
    overflow: visible;
    contain: layout paint;
    content-visibility: auto;
    contain-intrinsic-size: auto calc(100dvh - 4rem);
    scroll-margin-top: 4rem;
    will-change: auto;
  }

  :global([data-home-layout='flow']) .fullpage-section[data-viewport-sized='true'] {
    min-height: calc(100dvh - 4rem);
  }

  :global([data-home-layout='flow']) .fullpage-section[data-active='false'] * {
    animation-play-state: running !important;
  }

  :global([data-home-layout='flow']) .fullpage-section[data-in-viewport='false'] * {
    animation-play-state: paused !important;
  }

  :global([data-home-layout='snap']) .fullpage-section[data-ready='true'] {
    will-change: transform;
  }

  @media (max-width: 768px) {
    :global([data-home-layout='flow']) .fullpage-section {
      min-height: auto;
    }
  }
</style>
