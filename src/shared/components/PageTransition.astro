---
/**
 * PageTransition
 * Shared transition styling for Astro ClientRouter and MPA fallback.
 *
 * ClientRouter keeps navigation SPA-like; this stylesheet keeps the visual
 * treatment consistent even when native View Transitions are unavailable.
 */
---

<style is:global>
  @keyframes reay-route-content-in {
    0% {
      opacity: 0.88;
      transform: translate3d(0, 6px, 0);
    }

    100% {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes reay-route-content-out {
    from {
      opacity: 1;
      transform: none;
    }

    to {
      opacity: 0.84;
      transform: translate3d(0, -3px, 0);
    }
  }

  @keyframes reay-route-child-in {
    0% {
      opacity: 0.88;
      transform: translate3d(0, 6px, 0);
    }

    100% {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes reay-route-root-out {
    from {
      opacity: 1;
    }

    to {
      opacity: 0.72;
    }
  }

  @keyframes reay-route-root-in {
    0% {
      opacity: 0.9;
    }

    100% {
      opacity: 1;
    }
  }

  :root {
    --reay-route-enter-duration: 220ms;
    --reay-route-enter-ease: cubic-bezier(0.16, 0.9, 0.22, 1);
    --reay-route-exit-duration: 90ms;
    --reay-route-child-duration: 220ms;
  }

  [data-page-transition] {
    position: relative;
    view-transition-name: none;
    transform-origin: center top;
    backface-visibility: hidden;
    will-change: auto;
  }

  body.layout-home [data-page-transition] {
    height: 100%;
    min-height: 0;
  }

  .site-header {
    view-transition-name: none;
  }

  html[data-reay-route-phase="prepare"] [data-page-transition] {
    opacity: 1;
    transform: none;
    transition: none;
  }

  html[data-reay-route-phase="enter"] [data-page-transition],
  html[data-reay-route-phase="initial"] [data-page-transition] {
    animation: reay-route-content-in var(--reay-route-enter-duration) var(--reay-route-enter-ease) both;
    will-change: opacity, transform;
  }

  html[data-reay-route-phase="enter"] .site-header,
  html[data-reay-route-phase="initial"] .site-header {
    transform: translateZ(0);
  }

  html[data-reay-route-phase="prepare"] .site-header,
  html[data-reay-route-phase="swap"] .site-header {
    transition: none;
  }

  html[data-astro-transition-fallback="old"]:not([data-reay-route-phase]) [data-page-transition] {
    animation: reay-route-content-out var(--reay-route-exit-duration) ease both;
  }

  html[data-astro-transition-fallback="new"]:not([data-reay-route-phase]) [data-page-transition] {
    animation: reay-route-content-in var(--reay-route-enter-duration) var(--reay-route-enter-ease) both;
  }

  @media (prefers-reduced-motion: no-preference) {
    ::view-transition-old(root) {
      animation: none;
      display: none;
      opacity: 0;
      mix-blend-mode: normal;
    }

    ::view-transition-new(root) {
      animation: none;
      display: none;
      opacity: 1;
      mix-blend-mode: normal;
    }

    ::view-transition-old(reay-page-content) {
      animation: none;
      display: none;
      opacity: 0;
      transform-origin: center top;
    }

    ::view-transition-new(reay-page-content) {
      animation: none;
      display: none;
      opacity: 1;
      transform-origin: center top;
    }

    ::view-transition-old(reay-site-header),
    ::view-transition-new(reay-site-header) {
      animation: none;
      mix-blend-mode: normal;
    }

    ::view-transition-old(reay-site-header) {
      opacity: 0;
    }

    ::view-transition-new(reay-site-header) {
      opacity: 1;
    }
  }

  @supports not (view-transition-name: reay-page-content) {
    @media (prefers-reduced-motion: no-preference) {
      [data-page-transition] {
        animation: reay-route-content-in var(--reay-route-enter-duration) var(--reay-route-enter-ease) backwards;
        transform-origin: center top;
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    ::view-transition-old(root),
    ::view-transition-new(root),
    ::view-transition-old(reay-page-content),
    ::view-transition-new(reay-page-content),
    ::view-transition-old(reay-site-header),
    ::view-transition-new(reay-site-header),
    html[data-reay-route-phase] [data-page-transition],
    html[data-reay-route-phase] [data-page-transition] > :where(*) {
      animation: none !important;
    }

    html[data-reay-route-phase] [data-page-transition],
    html[data-reay-route-phase] [data-page-transition] > :where(*) {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
      will-change: auto !important;
    }
  }
</style>
