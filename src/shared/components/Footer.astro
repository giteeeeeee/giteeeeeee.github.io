---
/**
 * Footer Component
 * Compact site-wide footer.
 */
import {
  getFeaturesConfig,
  getLocalizedUserContent,
  getNavigationConfig,
  getSiteProfile,
  getUserContactLinks,
  getUserProfile,
} from '@app/config/site.config';
import type { TranslationKey } from '@app/config/i18n.config';
import { useI18n } from '@features/i18n/lib/i18n';

const { t, currentLang } = useI18n();
const user = getUserProfile();
const userContent = getLocalizedUserContent(currentLang);
const site = getSiteProfile(currentLang);
const builtWithKey = site.builtWith.startsWith('site.') ? site.builtWith : undefined;
const builtWith = builtWithKey ? t(builtWithKey as TranslationKey) : site.builtWith;
const contactLinks = getUserContactLinks();
const navigation = getNavigationConfig();
const features = getFeaturesConfig();
const { variant = 'default' } = Astro.props as { variant?: 'default' | 'seamless' };

const year = new Date().getFullYear();
const startYear = Number.parseInt(site.since, 10);
const yearText = Number.isFinite(startYear) && startYear < year ? `${startYear} - ${year}` : `${year}`;

const quickLinks = navigation.primary.filter((item) => item.showInFooter);
const resourceLinks = navigation.resources.filter((link) => {
  if (link.href === '/search/') return features.search.showInNavigation;
  if (link.href === '/rss.xml') return features.discovery.showRssLink;
  if (link.href === '/sitemap-index.xml') return features.discovery.showSitemapLink;
  return true;
});
const getResourceLabelKey = (href: string) => {
  if (href === '/search/') return 'footer.search' as const;
  if (href === '/rss.xml') return 'footer.rss' as const;
  if (href === '/sitemap-index.xml') return 'footer.sitemap' as const;
  return undefined;
};
---

<footer class:list={['site-footer', variant === 'seamless' && 'site-footer--seamless']}>
  <div class="footer-inner">
    <div class="footer-main">
      <div class="footer-brand">
        <img
          src={user.avatar}
          alt={user.name}
          width="32"
          height="32"
          loading="lazy"
          decoding="async"
          class="footer-avatar"
        />
        <div class="footer-copy">
          <strong>{user.name}</strong>
          <p data-user-content="description">{userContent.description}</p>
        </div>
      </div>

      <nav class="footer-links" aria-label={t('footer.navigation')}>
        {quickLinks.map(link => (
          <a href={link.href} data-i18n={link.key}>{t(link.key)}</a>
        ))}
      </nav>

      <div class="footer-actions">
        <div class="footer-socials">
          {contactLinks.map(contact => (
            <a
              href={contact.href}
              target={contact.external ? '_blank' : undefined}
              rel={contact.external ? 'noopener noreferrer' : undefined}
              aria-label={contact.label}
              title={`${contact.label}: ${contact.value}`}
              data-contact-kind={contact.kind}
            >
              <i class={contact.icon}></i>
            </a>
          ))}
        </div>

        <nav class="footer-resources" aria-label={t('footer.subscribe')}>
          {resourceLinks.map((link) => {
            const labelKey = getResourceLabelKey(link.href);
            return (
              <a href={link.href}>
                <i class={link.icon}></i>
                <span data-i18n={labelKey}>{labelKey ? t(labelKey) : link.label}</span>
              </a>
            );
          })}
        </nav>
      </div>
    </div>

    <div class="footer-bottom">
      <span>&copy; {yearText} {user.name}</span>
      <span class="footer-stack" data-i18n={builtWithKey}>{builtWith}</span>
    </div>
  </div>
</footer>


<style>
  .site-footer {
    flex-shrink: 0;
    border-top: 1px solid rgba(var(--md-sys-color-outline-variant-rgb), 0.42);
    background:
      linear-gradient(180deg, rgba(var(--md-sys-color-surface-rgb), 0.78), rgba(var(--md-sys-color-surface-container-rgb), 0.82));
    contain: layout paint style;
    transform: translateZ(0);
    backface-visibility: hidden;
  }

  .site-footer--seamless {
    border-top: 0;
    background: transparent;
  }

  .site-footer--seamless .footer-links a,
  .site-footer--seamless .footer-resources a,
  .site-footer--seamless .footer-socials a {
    border-color: transparent;
    background: transparent;
  }

  .site-footer--seamless .footer-bottom {
    border-top-color: rgba(var(--md-sys-color-outline-variant-rgb), 0.2);
  }

  .footer-inner {
    width: min(100%, 1100px);
    margin: 0 auto;
    padding: 1rem 1rem 0.85rem;
  }

  .footer-main {
    display: grid;
    grid-template-columns: minmax(220px, 1.1fr) minmax(280px, 1.3fr) auto;
    align-items: center;
    gap: 1rem;
  }

  .footer-brand {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    min-width: 0;
  }

  .footer-avatar {
    width: 2rem;
    height: 2rem;
    flex: 0 0 auto;
    border-radius: 999px;
    object-fit: cover;
    box-shadow: 0 0 0 1px rgba(var(--md-sys-color-primary-rgb), 0.18);
  }

  .footer-copy {
    min-width: 0;
  }

  .footer-copy strong {
    display: block;
    color: var(--md-sys-color-on-surface);
    font-size: 0.9rem;
    line-height: 1.2;
  }

  .footer-copy p {
    display: -webkit-box;
    margin: 0.18rem 0 0;
    overflow: hidden;
    color: var(--md-sys-color-on-surface-variant);
    font-size: 0.76rem;
    line-height: 1.35;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 1;
  }

  .footer-links,
  .footer-resources,
  .footer-socials {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.38rem;
  }

  .footer-links {
    justify-content: center;
  }

  .footer-links a,
  .footer-resources a,
  .footer-socials a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 1.75rem;
    border: 1px solid rgba(var(--md-sys-color-outline-variant-rgb), 0.32);
    border-radius: var(--reay-radius-pill);
    color: var(--md-sys-color-on-surface-variant);
    background: rgba(var(--md-sys-color-surface-container-high-rgb), 0.36);
    font-size: 0.76rem;
    font-weight: 650;
    transition:
      color 0.18s ease,
      background 0.18s ease,
      border-color 0.18s ease,
      transform 0.18s ease;
  }

  .footer-links a,
  .footer-resources a {
    padding: 0.25rem 0.58rem;
  }

  .footer-socials a {
    width: 1.75rem;
    padding: 0;
  }

  .footer-resources a {
    gap: 0.32rem;
  }

  .footer-links a:hover,
  .footer-resources a:hover,
  .footer-socials a:hover {
    color: var(--md-sys-color-primary);
    border-color: rgba(var(--md-sys-color-primary-rgb), 0.28);
    background: rgba(var(--md-sys-color-primary-container-rgb), 0.36);
    transform: translateY(-1px);
  }

  .footer-actions {
    display: grid;
    justify-items: end;
    gap: 0.45rem;
  }

  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-top: 0.85rem;
    padding-top: 0.65rem;
    border-top: 1px solid rgba(var(--md-sys-color-outline-variant-rgb), 0.3);
    color: var(--md-sys-color-on-surface-variant);
    font-size: 0.72rem;
  }

  .footer-stack {
    color: var(--md-sys-color-on-surface-variant);
  }

  @media (max-width: 900px) {
    .footer-main {
      grid-template-columns: 1fr;
      align-items: start;
      gap: 0.8rem;
    }

    .footer-links {
      justify-content: flex-start;
    }

    .footer-actions {
      justify-items: start;
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 0.65rem;
    }
  }

  @media (max-width: 560px) {
    .footer-inner {
      padding: 0.9rem 1rem 0.8rem;
    }

    .footer-bottom {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.25rem;
    }
  }
</style>
