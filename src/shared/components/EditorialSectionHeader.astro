---
interface Props {
  title: string;
  icon?: string;
  description?: string;
  titleKey?: string;
  descriptionKey?: string;
  actionHref?: string;
  actionLabel?: string;
  actionKey?: string;
}

const {
  title,
  icon,
  description,
  titleKey,
  descriptionKey,
  actionHref,
  actionLabel,
  actionKey,
} = Astro.props;
---

<header class="editorial-section-header">
  <div>
    <h2>
      {icon && <i class={icon} aria-hidden="true"></i>}
      <span data-i18n={titleKey}>{title}</span>
    </h2>
    {description && <p data-i18n={descriptionKey}>{description}</p>}
  </div>
  {actionHref && actionLabel && (
    <a href={actionHref}>
      <span data-i18n={actionKey}>{actionLabel}</span>
      <i class="i-carbon:arrow-up-right" aria-hidden="true"></i>
    </a>
  )}
</header>

<style>
  .editorial-section-header {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1.25rem;
    margin-bottom: 1rem;
    padding-bottom: 0.72rem;
    border-bottom: 1px solid rgba(var(--md-sys-color-outline-variant-rgb), 0.46);
  }

  h2 {
    display: flex;
    align-items: center;
    gap: 0.52rem;
    margin: 0;
    color: var(--md-sys-color-on-surface);
    font-size: 1.12rem;
    font-weight: 720;
    line-height: 1.25;
    font-family: var(--reay-font-heading);
  }

  h2 i {
    color: var(--md-sys-color-primary);
    font-size: 1rem;
  }

  p {
    margin: 0.28rem 0 0;
    color: var(--md-sys-color-on-surface-variant);
    font-size: 0.78rem;
    line-height: 1.55;
  }

  a {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    flex: 0 0 auto;
    color: var(--md-sys-color-primary);
    font-size: 0.76rem;
    font-weight: 700;
  }

  a:hover {
    transform: translateY(-1px);
  }
</style>
