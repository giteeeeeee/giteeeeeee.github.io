---
/**
 * Background.astro
 * 统一的背景组件
 * 支持 MD3 渐变背景、自定义图片背景、可配置模糊效果
 */
import { getBackgroundConfig } from '@app/config/site.config';
import type { BackgroundConfig } from '@app/config/theme.config';

type BackgroundOverride = Partial<BackgroundConfig>;

const backgroundOverride = Astro.props as BackgroundOverride;
const baseConfig = getBackgroundConfig();
const backgroundConfig = {
  ...baseConfig,
  ...backgroundOverride,
  imageStyle: {
    ...baseConfig.imageStyle,
    ...backgroundOverride.imageStyle,
  },
  gradient: {
    ...baseConfig.gradient,
    ...backgroundOverride.gradient,
  },
};

const {
  type,
  decoration = 'aurora',
  blur,
  blurIntensity,
  imageUrl,
  imageStyle,
  gradient,
} = backgroundConfig;

// 模糊程度映射
const blurMap = {
  light: '4px',
  medium: '8px',
  heavy: '16px',
};

const blurValue = blur ? blurMap[blurIntensity] : '0px';

// 构建背景样式
let backgroundStyle = '';
let useImage = false;
let imageOpacity = 1;

if (type === 'gradient') {
  if (gradient?.useMD3Colors) {
    // 使用 MD3 调色板颜色的渐变
    backgroundStyle = `
      background:
        linear-gradient(120deg, rgba(var(--md-sys-color-primary-rgb), 0.24), transparent 32%),
        linear-gradient(235deg, rgba(var(--md-sys-color-tertiary-rgb), 0.24), transparent 34%),
        linear-gradient(${gradient.direction || '135deg'},
          rgba(var(--md-sys-color-primary-container-rgb), 0.8) 0%,
          rgba(var(--md-sys-color-secondary-container-rgb), 0.68) 38%,
          rgba(var(--md-sys-color-tertiary-container-rgb), 0.72) 100%
        );
    `;
  } else if (gradient?.colors && gradient.colors.length > 0) {
    // 使用自定义渐变色
    const colorStops = gradient.colors
      .map((color, index) => {
        const percentage = (index / (gradient.colors!.length - 1)) * 100;
        return `${color} ${percentage}%`;
      })
      .join(', ');
    backgroundStyle = `
      background: linear-gradient(
        ${gradient.direction || '135deg'},
        ${colorStops}
      );
    `;
  }
} else if (type === 'image' && imageUrl) {
  // 使用图片背景
  useImage = true;
  imageOpacity = imageStyle?.opacity ?? 1;
  backgroundStyle = `
    background-image: url('${imageUrl}');
    background-size: ${imageStyle?.size || 'cover'};
    background-position: ${imageStyle?.position || 'center'};
    background-repeat: ${imageStyle?.repeat || 'no-repeat'};
    background-attachment: scroll;
  `;
}
---

{type !== 'none' && (
  <div 
    class={`app-background ${useImage ? 'image-bg' : 'gradient-bg'} decoration-${decoration}`}
    style={`${backgroundStyle} --image-opacity: ${imageOpacity};`}
    aria-hidden="true"
  >
    <div class="aurora-field"></div>
    <div class="motion-grid"></div>
    <div class="light-sweep"></div>
    <div class="texture-layer"></div>
    <div class="scene-layer scene-back"></div>
    <div class="scene-layer scene-mid"></div>
    <div class="scene-layer scene-front"></div>
    {blur && (
      <div 
        class="background-overlay" 
        style={`backdrop-filter: blur(${blurValue}); -webkit-backdrop-filter: blur(${blurValue});`}
      ></div>
    )}
  </div>
)}

<style>
  .app-background {
    position: fixed;
    inset: 0;
    z-index: -2;
    overflow: hidden;
    transition: opacity 0.5s ease;
  }

  /* 渐变背景 */
  .gradient-bg {
    opacity: 0.82;
    background-size: 160% 160%, 180% 180%, 100% 100%;
    animation: gradient-drift 18s ease-in-out infinite alternate;
  }

  /* 图片背景 */
  .image-bg {
    opacity: var(--image-opacity, 1);
  }

  .aurora-field,
  .motion-grid,
  .light-sweep,
  .texture-layer,
  .scene-layer {
    position: absolute;
    inset: -20%;
    pointer-events: none;
  }

  .aurora-field {
    z-index: 0;
    background:
      linear-gradient(105deg, transparent 12%, rgba(var(--md-sys-color-primary-rgb), 0.18) 24%, transparent 40%),
      linear-gradient(252deg, transparent 8%, rgba(var(--md-sys-color-tertiary-rgb), 0.16) 30%, transparent 48%),
      linear-gradient(18deg, transparent 26%, rgba(var(--reay-color-warning-rgb), 0.12) 48%, transparent 66%);
    filter: blur(26px);
    opacity: 0.58;
    mix-blend-mode: screen;
    animation: aurora-flow 16s ease-in-out infinite alternate;
  }

  .motion-grid {
    z-index: 1;
    inset: 0;
    background:
      linear-gradient(rgba(var(--md-sys-color-on-surface-rgb), 0.045) 1px, transparent 1px),
      linear-gradient(90deg, rgba(var(--md-sys-color-on-surface-rgb), 0.04) 1px, transparent 1px);
    background-size: 56px 56px;
    mask-image: linear-gradient(to bottom, transparent, rgb(var(--md-sys-color-scrim-rgb)) 18%, rgb(var(--md-sys-color-scrim-rgb)) 78%, transparent);
    opacity: 0.28;
    transform: perspective(900px) rotateX(58deg) translateY(-18%);
    transform-origin: top;
    animation: grid-slide 22s linear infinite;
  }

  .light-sweep {
    z-index: 2;
    background: linear-gradient(112deg, transparent 0 42%, rgba(var(--md-sys-color-surface-bright-rgb), 0.14) 49%, transparent 58% 100%);
    opacity: 0.34;
    transform: translateX(-18%);
    animation: sweep 12s var(--reay-ease-out, ease-out) infinite;
  }

  .texture-layer {
    display: none;
    z-index: 2;
    inset: 0;
  }

  .scene-layer {
    display: none;
    inset: 0;
  }

  .scene-layer::before,
  .scene-layer::after {
    content: '';
    position: absolute;
    pointer-events: none;
  }

  .decoration-paper .aurora-field,
  .decoration-paper .motion-grid,
  .decoration-paper .light-sweep,
  .decoration-eink .aurora-field,
  .decoration-eink .motion-grid,
  .decoration-eink .light-sweep,
  .decoration-inkwash .aurora-field,
  .decoration-inkwash .motion-grid,
  .decoration-inkwash .light-sweep,
  .decoration-monochrome-ink .aurora-field,
  .decoration-monochrome-ink .motion-grid,
  .decoration-monochrome-ink .light-sweep,
  .decoration-anime-spring .aurora-field,
  .decoration-anime-spring .motion-grid,
  .decoration-anime-spring .light-sweep,
  .decoration-anime-night .aurora-field,
  .decoration-anime-night .motion-grid,
  .decoration-anime-night .light-sweep,
  .decoration-cosmic-abyss .aurora-field,
  .decoration-cosmic-abyss .motion-grid,
  .decoration-cosmic-abyss .light-sweep,
  .decoration-ukiyo .aurora-field,
  .decoration-ukiyo .motion-grid,
  .decoration-ukiyo .light-sweep,
  .decoration-ocean .aurora-field,
  .decoration-ocean .motion-grid,
  .decoration-ocean .light-sweep,
  .decoration-terminal .aurora-field,
  .decoration-terminal .motion-grid,
  .decoration-terminal .light-sweep,
  .decoration-plain .aurora-field,
  .decoration-plain .motion-grid,
  .decoration-plain .light-sweep {
    display: none;
  }

  .decoration-paper .texture-layer {
    display: block;
    background:
      repeating-linear-gradient(8deg, rgba(var(--md-sys-color-on-surface-rgb), 0.018) 0 1px, transparent 1px 5px),
      repeating-linear-gradient(97deg, rgba(var(--md-sys-color-on-surface-rgb), 0.014) 0 1px, transparent 1px 7px),
      radial-gradient(circle at 18% 23%, rgba(var(--md-sys-color-on-surface-rgb), 0.045) 0 0.5px, transparent 0.8px),
      radial-gradient(circle at 73% 61%, rgba(var(--md-sys-color-on-surface-rgb), 0.036) 0 0.45px, transparent 0.8px);
    background-size: auto, auto, 11px 13px, 17px 19px;
    mix-blend-mode: multiply;
    opacity: 0.42;
  }

  .decoration-eink .texture-layer {
    display: block;
    background:
      radial-gradient(circle, rgba(var(--md-sys-color-on-surface-rgb), 0.1) 0 0.42px, transparent 0.7px),
      repeating-linear-gradient(0deg, transparent 0 3px, rgba(var(--md-sys-color-on-surface-rgb), 0.025) 3px 4px);
    background-size: 3px 3px, auto;
    mix-blend-mode: multiply;
    opacity: 0.34;
  }

  :global([data-theme='dark']) .decoration-paper .texture-layer,
  :global([data-theme='dark']) .decoration-eink .texture-layer {
    mix-blend-mode: screen;
    opacity: 0.16;
  }

  .decoration-inkwash .scene-layer,
  .decoration-monochrome-ink .scene-layer,
  .decoration-anime-spring .scene-layer,
  .decoration-anime-night .scene-layer,
  .decoration-cosmic-abyss .scene-layer,
  .decoration-ukiyo .scene-layer,
  .decoration-ocean .scene-layer,
  .decoration-terminal .scene-layer {
    display: block;
  }

  /* 水墨江湖：宣纸雾气、远山与近景墨痕。 */
  .gradient-bg.decoration-inkwash {
    opacity: 0.7;
    background-size: 100% 100%;
    background:
      radial-gradient(circle at 14% 22%, rgba(var(--md-sys-color-on-surface-rgb), 0.08), transparent 28%),
      linear-gradient(180deg, rgb(var(--md-sys-color-surface-bright-rgb)), rgb(var(--md-sys-color-surface-rgb)) 58%, rgba(var(--md-sys-color-primary-rgb), 0.08)) !important;
  }

  .decoration-inkwash .scene-back {
    z-index: 0;
    inset: 22% -8% -8%;
    background:
      radial-gradient(58% 50% at 4% 75%, rgba(var(--md-sys-color-on-surface-rgb), 0.17) 0 42%, transparent 43%),
      radial-gradient(48% 46% at 42% 78%, rgba(var(--md-sys-color-on-surface-variant-rgb), 0.13) 0 44%, transparent 45%),
      radial-gradient(56% 52% at 92% 77%, rgba(var(--md-sys-color-primary-rgb), 0.14) 0 40%, transparent 41%);
    filter: blur(16px);
    opacity: 0.68;
    transform: scale(1.08);
  }

  .decoration-inkwash .scene-mid {
    z-index: 1;
    inset: 38% -3% -4%;
    background:
      linear-gradient(102deg, rgba(var(--md-sys-color-on-surface-rgb), 0.13), rgba(var(--md-sys-color-primary-rgb), 0.07) 58%, transparent 88%);
    clip-path: polygon(0 62%, 8% 52%, 16% 58%, 27% 37%, 38% 60%, 51% 44%, 60% 55%, 72% 28%, 84% 57%, 94% 42%, 100% 53%, 100% 100%, 0 100%);
    filter: blur(10px);
    opacity: 0.58;
    transform: scale(1.04);
  }

  .decoration-inkwash .scene-back::before {
    inset: 12% 4% 4%;
    background:
      radial-gradient(34% 44% at 22% 78%, rgba(var(--md-sys-color-on-surface-rgb), 0.2) 0 45%, transparent 47%),
      radial-gradient(32% 40% at 58% 76%, rgba(var(--md-sys-color-on-surface-variant-rgb), 0.15) 0 44%, transparent 46%),
      radial-gradient(30% 42% at 88% 82%, rgba(var(--md-sys-color-on-surface-rgb), 0.17) 0 42%, transparent 44%);
    filter: blur(22px);
    opacity: 0.72;
  }

  .decoration-inkwash .scene-mid::before {
    inset: 18% -4% -4%;
    background: rgba(var(--md-sys-color-on-surface-rgb), 0.1);
    clip-path: polygon(0 72%, 12% 56%, 21% 66%, 34% 38%, 45% 65%, 57% 52%, 66% 67%, 80% 42%, 91% 62%, 100% 50%, 100% 100%, 0 100%);
    filter: blur(14px);
    opacity: 0.62;
  }

  .decoration-inkwash .scene-front {
    z-index: 2;
    background:
      linear-gradient(to bottom, transparent 35%, rgba(var(--md-sys-color-surface-rgb), 0.08) 57%, rgba(var(--md-sys-color-surface-rgb), 0.32) 86%),
      repeating-linear-gradient(7deg, rgba(var(--md-sys-color-on-surface-rgb), 0.016) 0 1px, transparent 1px 7px),
      radial-gradient(circle at 82% 18%, rgba(var(--md-sys-color-tertiary-rgb), 0.17) 0 3px, transparent 4px);
    mix-blend-mode: multiply;
    opacity: 0.76;
  }

  .decoration-inkwash .scene-front::before {
    inset: 50% -8% 4%;
    background:
      linear-gradient(to bottom, transparent, rgba(var(--md-sys-color-surface-bright-rgb), 0.48) 38%, transparent 70%),
      radial-gradient(ellipse at 50% 48%, rgba(var(--md-sys-color-surface-bright-rgb), 0.38), transparent 64%);
    filter: blur(16px);
    opacity: 0.86;
  }

  .decoration-inkwash .scene-front::after {
    top: 14%;
    right: 8%;
    width: 1.35rem;
    height: 1.35rem;
    border: 1px solid rgba(var(--md-sys-color-tertiary-rgb), 0.62);
    background:
      linear-gradient(90deg, transparent 44%, rgba(var(--md-sys-color-tertiary-rgb), 0.5) 45% 55%, transparent 56%),
      linear-gradient(transparent 44%, rgba(var(--md-sys-color-tertiary-rgb), 0.5) 45% 55%, transparent 56%);
    opacity: 0.58;
    transform: rotate(-5deg);
  }

  /* 墨白丹朱：黑白宣纸、浓淡墨山与克制朱砂印。 */
  .gradient-bg.decoration-monochrome-ink {
    opacity: 0.9;
    background-size: 100% 100%;
    background:
      radial-gradient(circle at 12% 24%, rgba(var(--md-sys-color-on-surface-rgb), 0.055), transparent 24%),
      radial-gradient(circle at 86% 20%, rgba(var(--md-sys-color-on-surface-rgb), 0.035), transparent 18%),
      linear-gradient(180deg, rgb(var(--md-sys-color-surface-bright-rgb)), rgb(var(--md-sys-color-surface-rgb)) 62%, rgb(var(--md-sys-color-surface-container-low-rgb))) !important;
  }

  .decoration-monochrome-ink .scene-back {
    z-index: 0;
    inset: 18% -10% -10%;
    background:
      radial-gradient(48% 52% at 4% 78%, rgba(var(--md-sys-color-on-surface-rgb), 0.16) 0 42%, transparent 44%),
      radial-gradient(42% 48% at 34% 80%, rgba(var(--md-sys-color-on-surface-rgb), 0.11) 0 44%, transparent 46%),
      radial-gradient(50% 54% at 72% 78%, rgba(var(--md-sys-color-on-surface-rgb), 0.14) 0 42%, transparent 44%),
      radial-gradient(40% 48% at 104% 82%, rgba(var(--md-sys-color-on-surface-rgb), 0.1) 0 43%, transparent 45%);
    filter: blur(20px);
    opacity: 0.66;
    transform: scale(1.08);
  }

  .decoration-monochrome-ink .scene-back::before {
    inset: 22% -2% 0;
    background:
      radial-gradient(ellipse at 16% 72%, rgba(var(--md-sys-color-on-surface-rgb), 0.1) 0 30%, transparent 46%),
      radial-gradient(ellipse at 58% 74%, rgba(var(--md-sys-color-on-surface-rgb), 0.08) 0 34%, transparent 49%),
      radial-gradient(ellipse at 92% 76%, rgba(var(--md-sys-color-on-surface-rgb), 0.09) 0 28%, transparent 45%);
    filter: blur(26px);
  }

  .decoration-monochrome-ink .scene-mid {
    z-index: 1;
    inset: 32% -8% -8%;
    background:
      radial-gradient(30% 68% at 2% 94%, rgba(var(--md-sys-color-on-surface-rgb), 0.26) 0 48%, transparent 52%),
      radial-gradient(25% 72% at 25% 98%, rgba(var(--md-sys-color-on-surface-rgb), 0.2) 0 48%, transparent 53%),
      radial-gradient(30% 66% at 52% 96%, rgba(var(--md-sys-color-on-surface-rgb), 0.24) 0 46%, transparent 52%),
      radial-gradient(24% 70% at 76% 98%, rgba(var(--md-sys-color-on-surface-rgb), 0.19) 0 48%, transparent 54%),
      radial-gradient(28% 64% at 101% 94%, rgba(var(--md-sys-color-on-surface-rgb), 0.22) 0 47%, transparent 53%);
    filter: blur(16px);
    mask-image: linear-gradient(to bottom, transparent 4%, black 24%, black 100%);
    opacity: 0.9;
    transform: scale(1.04);
  }

  .decoration-monochrome-ink .scene-mid::before {
    inset: 22% -4% -2%;
    background:
      radial-gradient(ellipse at 12% 86%, rgba(var(--md-sys-color-on-surface-rgb), 0.11) 0 24%, transparent 43%),
      radial-gradient(ellipse at 42% 88%, rgba(var(--md-sys-color-on-surface-rgb), 0.08) 0 28%, transparent 48%),
      radial-gradient(ellipse at 72% 84%, rgba(var(--md-sys-color-on-surface-rgb), 0.1) 0 25%, transparent 45%),
      radial-gradient(ellipse at 96% 88%, rgba(var(--md-sys-color-on-surface-rgb), 0.075) 0 22%, transparent 42%);
    filter: blur(22px);
    opacity: 0.66;
  }

  .decoration-monochrome-ink .scene-front {
    z-index: 2;
    background:
      repeating-linear-gradient(7deg, rgba(var(--md-sys-color-on-surface-rgb), 0.014) 0 1px, transparent 1px 7px),
      repeating-linear-gradient(96deg, rgba(var(--md-sys-color-on-surface-rgb), 0.012) 0 1px, transparent 1px 9px),
      radial-gradient(circle at 7% 78%, rgba(var(--md-sys-color-on-surface-rgb), 0.08) 0 2px, transparent 3px),
      radial-gradient(circle at 92% 64%, rgba(var(--md-sys-color-on-surface-rgb), 0.055) 0 1px, transparent 2px);
    background-size: auto, auto, 34px 31px, 43px 39px;
    mix-blend-mode: multiply;
    opacity: 0.72;
  }

  .decoration-monochrome-ink .scene-front::before {
    inset: 46% -8% 2%;
    background:
      linear-gradient(to bottom, transparent, rgba(var(--md-sys-color-surface-bright-rgb), 0.56) 34%, transparent 72%),
      radial-gradient(ellipse at 50% 50%, rgba(var(--md-sys-color-surface-bright-rgb), 0.42), transparent 66%);
    filter: blur(18px);
    opacity: 0.9;
  }

  .decoration-monochrome-ink .scene-front::after {
    top: 13%;
    right: 8%;
    width: 1.55rem;
    height: 1.55rem;
    border: 1px solid rgba(var(--md-sys-color-tertiary-rgb), 0.82);
    background:
      linear-gradient(90deg, transparent 42%, rgba(var(--md-sys-color-tertiary-rgb), 0.62) 43% 57%, transparent 58%),
      linear-gradient(transparent 42%, rgba(var(--md-sys-color-tertiary-rgb), 0.62) 43% 57%, transparent 58%);
    box-shadow: inset 0 0 0 3px rgba(var(--md-sys-color-tertiary-rgb), 0.06);
    opacity: 0.76;
    transform: rotate(-5deg);
  }

  /* 春日动画：原创晴空、柔云与静态花瓣。 */
  .gradient-bg.decoration-anime-spring {
    opacity: 0.76;
    background-size: 100% 100%;
    background:
      radial-gradient(circle at 78% 14%, rgba(var(--md-sys-color-tertiary-fixed-rgb), 0.42), transparent 16%),
      linear-gradient(180deg, rgba(var(--md-sys-color-primary-container-rgb), 0.72), rgba(var(--md-sys-color-surface-bright-rgb), 0.88) 48%, rgba(var(--md-sys-color-secondary-container-rgb), 0.58)) !important;
  }

  .decoration-anime-spring .scene-back {
    z-index: 0;
    background:
      radial-gradient(circle at 78% 16%, rgba(var(--md-sys-color-tertiary-fixed-rgb), 0.42) 0 5%, transparent 15%),
      radial-gradient(ellipse at 10% 24%, rgba(var(--md-sys-color-surface-bright-rgb), 0.68) 0 8%, transparent 19%),
      radial-gradient(ellipse at 30% 18%, rgba(var(--md-sys-color-surface-bright-rgb), 0.54) 0 7%, transparent 18%),
      radial-gradient(ellipse at 88% 40%, rgba(var(--md-sys-color-surface-bright-rgb), 0.48) 0 8%, transparent 20%);
    filter: blur(10px);
    opacity: 0.9;
  }

  .decoration-anime-spring .scene-back::before {
    top: 10%;
    left: 4%;
    width: 42%;
    height: 24%;
    border-radius: 50%;
    background:
      radial-gradient(ellipse at 18% 62%, rgba(var(--md-sys-color-surface-bright-rgb), 0.78) 0 18%, transparent 19%),
      radial-gradient(ellipse at 46% 46%, rgba(var(--md-sys-color-surface-bright-rgb), 0.84) 0 24%, transparent 25%),
      radial-gradient(ellipse at 74% 64%, rgba(var(--md-sys-color-surface-bright-rgb), 0.72) 0 20%, transparent 21%);
    filter: blur(8px);
    opacity: 0.92;
  }

  .decoration-anime-spring .scene-mid {
    z-index: 1;
    inset: 48% -8% -16%;
    border-radius: 48% 52% 0 0 / 28% 32% 0 0;
    background:
      linear-gradient(170deg, rgba(var(--md-sys-color-secondary-container-rgb), 0.26), rgba(var(--md-sys-color-primary-container-rgb), 0.2) 42%, rgba(var(--md-sys-color-tertiary-container-rgb), 0.24));
    transform: rotate(-2deg);
    opacity: 0.72;
  }

  .decoration-anime-spring .scene-front {
    z-index: 2;
    background:
      radial-gradient(ellipse at 14% 20%, rgba(var(--md-sys-color-secondary-rgb), 0.24) 0 2px, transparent 3px),
      radial-gradient(ellipse at 24% 42%, rgba(var(--md-sys-color-secondary-rgb), 0.18) 0 3px, transparent 4px),
      radial-gradient(ellipse at 70% 29%, rgba(var(--md-sys-color-secondary-rgb), 0.2) 0 2px, transparent 3px),
      radial-gradient(ellipse at 87% 56%, rgba(var(--md-sys-color-secondary-rgb), 0.18) 0 3px, transparent 4px),
      linear-gradient(112deg, transparent 22%, rgba(var(--md-sys-color-surface-bright-rgb), 0.13) 42%, transparent 63%);
    opacity: 0.88;
  }

  .decoration-anime-spring .scene-front::after {
    inset: 8%;
    background:
      radial-gradient(ellipse at 8% 68%, rgba(var(--md-sys-color-secondary-rgb), 0.3) 0 2px, transparent 3px),
      radial-gradient(ellipse at 38% 16%, rgba(var(--md-sys-color-secondary-rgb), 0.24) 0 2px, transparent 3px),
      radial-gradient(ellipse at 62% 74%, rgba(var(--md-sys-color-secondary-rgb), 0.28) 0 2px, transparent 3px),
      radial-gradient(ellipse at 94% 34%, rgba(var(--md-sys-color-secondary-rgb), 0.24) 0 2px, transparent 3px);
    opacity: 0.84;
  }

  /* 动画夜城：星点、远城剪影与低强度霓虹光晕。 */
  .gradient-bg.decoration-anime-night {
    opacity: 0.78;
    background-size: 100% 100%;
    background:
      radial-gradient(circle at 76% 18%, rgba(var(--md-sys-color-secondary-rgb), 0.2), transparent 24%),
      linear-gradient(160deg, rgba(var(--md-sys-color-primary-container-rgb), 0.82), rgba(var(--md-sys-color-surface-rgb), 0.94) 48%, rgba(var(--md-sys-color-tertiary-container-rgb), 0.66)) !important;
  }

  .decoration-anime-night .scene-back {
    z-index: 0;
    background:
      radial-gradient(circle at 12% 16%, rgba(var(--md-sys-color-surface-bright-rgb), 0.62) 0 1px, transparent 2px),
      radial-gradient(circle at 29% 29%, rgba(var(--md-sys-color-tertiary-fixed-rgb), 0.5) 0 1px, transparent 2px),
      radial-gradient(circle at 48% 12%, rgba(var(--md-sys-color-surface-bright-rgb), 0.58) 0 1.2px, transparent 2.2px),
      radial-gradient(circle at 71% 24%, rgba(var(--md-sys-color-secondary-fixed-rgb), 0.5) 0 1px, transparent 2px),
      radial-gradient(circle at 88% 10%, rgba(var(--md-sys-color-surface-bright-rgb), 0.54) 0 1px, transparent 2px),
      radial-gradient(circle at 61% 42%, rgba(var(--md-sys-color-primary-fixed-rgb), 0.42) 0 1px, transparent 2px);
    opacity: 0.9;
  }

  .decoration-anime-night .scene-mid {
    z-index: 1;
