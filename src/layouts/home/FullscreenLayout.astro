---
/**
 * FullscreenLayout
 * Fullscreen page layout with fixed header
 * No container - content displays fullscreen
 * Suitable for homepage fullscreen scrolling
 */
import HeadMeta from '../../components/common/HeadMeta.astro'
import { ClientRouter } from 'astro:transitions'
import Header from '../../components/common/Header.astro'
import Background from '../../components/common/Background.astro'
import SeasonalEffects from '../../components/common/SeasonalEffects.astro'
import I18nRuntime from '../../components/common/I18nRuntime.astro'
import PageTransition from '../../components/common/PageTransition.astro'
import ClientRuntime from '../../components/common/ClientRuntime.astro'
import type { BackgroundConfig } from '../../data/theme.config'

import { createTheme, themeToCSSVars } from '../../theme'
import { getThemeConfig } from '../../data/site.config'

import '../../styles/cards.css'
import '../../styles/immersive.css'

const {
  title = 'My Website',
  description = 'Technical notes and project practice',
  ogImage,
  background,
} = Astro.props as { 
  title?: string; 
  description?: string; 
  ogImage?: string;
  background?: Partial<BackgroundConfig>;
}

const THEME = createTheme(getThemeConfig())
---

<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    
    <script is:inline>
      (function() {
        const storageKey = 'theme';
        const theme = localStorage.getItem(storageKey);
        var resolvedTheme;
        
        if (theme === 'light' || theme === 'dark') {
          resolvedTheme = theme;
        }
        else {
          const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          resolvedTheme = prefersDark ? 'dark' : 'light';
        }

        document.documentElement.setAttribute('data-theme', resolvedTheme);
        document.documentElement.style.colorScheme = resolvedTheme;
      })();
    </script>

    <I18nRuntime />
    
    <HeadMeta {title} {description} {ogImage} />
    <ClientRouter fallback="swap" />

    <style is:inline data-astro-transition-persist="reay-theme-vars" set:html={themeToCSSVars(THEME)}></style>
    <PageTransition />
    <ClientRuntime />

    <style is:inline>
      html {
        scroll-behavior: smooth;
        overscroll-behavior-x: none;
        overscroll-behavior-y: none;
      }

      body{
        min-height:100vh; margin:0;
        display: flex;
        flex-direction: column;
        background: var(--md-sys-color-background);
        color: var(--md-sys-color-on-background);
        font-family: var(--font-sans);
        line-height: var(--leading);
        font-size: var(--text-base);
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
        overflow: hidden;
        overscroll-behavior-x: none;
        overscroll-behavior-y: none;
      }

      @supports (min-height: 100dvh) {
        body { min-height: 100dvh; }
      }
      
      main {
        flex: 1;
        overflow: hidden;
        position: relative;
        height: calc(100vh - 4rem);
        margin-top: 0;
        overscroll-behavior-y: none;
      }
      
      a{ 
        color: inherit; 
        text-decoration: none; 
        transition:
          color .2s cubic-bezier(0.4, 0, 0.2, 1),
          background-color .2s cubic-bezier(0.4, 0, 0.2, 1),
          border-color .2s cubic-bezier(0.4, 0, 0.2, 1),
          box-shadow .2s cubic-bezier(0.4, 0, 0.2, 1),
          transform .2s cubic-bezier(0.4, 0, 0.2, 1);
      }
      a:hover{ color: var(--md-sys-color-primary); }
      
      html.i18n-syncing *,
      html.i18n-syncing *::before,
      html.i18n-syncing *::after {
        transition: none !important;
      }
      
      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }
      
      /* Glass effect with backdrop-filter support */
      @supports (backdrop-filter: blur(20px)) {
        .glass-effect {
          backdrop-filter: blur(20px) saturate(180%);
          -webkit-backdrop-filter: blur(20px) saturate(180%);
        }
      }
      
      /* Float-up animation keyframes */
      @keyframes float-up {
        0% { transform: translateY(0); }
        100% { transform: translateY(-2px); }
      }
      
      /* MD3 icon button styles (compact and refined) */
      .icon-btn{
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 2.25rem;
        height: 2.25rem;
        border-radius: var(--reay-icon-button-radius, 0.95rem);
        border: 1px solid var(--reay-button-border);
        background: var(--reay-button-bg);
        color: var(--md-sys-color-on-surface);
        cursor: pointer;
        box-shadow: var(--reay-button-shadow);
        transition:
          color 0.2s cubic-bezier(0.4, 0, 0.2, 1),
          background 0.2s cubic-bezier(0.4, 0, 0.2, 1),
          border-color 0.2s cubic-bezier(0.4, 0, 0.2, 1),
          box-shadow 0.2s cubic-bezier(0.4, 0, 0.2, 1),
          transform 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        backdrop-filter: blur(16px) saturate(150%);
        -webkit-backdrop-filter: blur(16px) saturate(150%);
      }
      .icon-btn:hover{
        border-color: rgba(var(--md-sys-color-primary-rgb), 0.48);
        background: var(--reay-button-bg-hover);
        color: var(--md-sys-color-on-primary-container);
        transform: translateY(-1px);
        box-shadow: var(--reay-button-shadow-hover);
      }
      .icon-btn:active{
        transform: translateY(0);
        box-shadow: 0 2px 4px rgba(var(--md-sys-color-shadow-rgb), 0.05);
      }
      
      /* Icon size optimization for better balance */
      .icon-btn i {
        font-size: 1.25rem;
      }

    </style>
  </head>

  <body class="antialiased layout-home min-h-dvh grid grid-rows-[auto,1fr]">
    <!-- Unified background -->
    <Background {...(background ?? {})} />
    <SeasonalEffects />
    
    <!-- Header - fixed top -->
    <Header>
      <slot name="header-extra" />
    </Header>

    <!-- Main content area - fullscreen display -->
    <main class="overflow-auto relative min-h-0">
        <div data-page-transition data-page-transition-scope="home">
          <slot />
        </div>
    </main>

    <!-- Footer slot - pages decide whether and how to display -->
    <slot name="footer" />
  </body>
</html>
